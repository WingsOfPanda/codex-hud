+        composer.set_status_line_stats(Some("Context 75% left".into()));
+        let options = ComposerRenderOptions {
+            separate_status_line: separate,
+            ..Default::default()
+        };
+        assert_eq!(composer.desired_height_with_options(80, options), 4);
+        let (rows, _) = status_rows(&composer, separate, 80, None);
+        assert_eq!(rows.last().map(String::as_str), Some("Context 75% left"));
+        composer.set_active_agent_label(Some("Main [default]".into()));
+        assert_eq!(composer.desired_height_with_options(80, options), 5);
+        let (rows, _) = status_rows(&composer, separate, 80, None);
+        assert_eq!(rows[rows.len() - 2], "Main [default]");
+        composer.set_active_agent_label(None);
+        composer.set_collaboration_mode_indicator(Some(CollaborationModeIndicator::Plan));
+        assert_eq!(composer.desired_height_with_options(80, options), 5);
+        let (rows, _) = status_rows(&composer, separate, 80, None);
+        assert!(rows[rows.len() - 2].contains("Plan mode"));
+        composer.set_collaboration_mode_indicator(None);
+        composer.set_status_line_stats(None);
+        composer.set_status_line(Some("MODEL".into()));
+        assert_eq!(composer.desired_height_with_options(80, options), 4);
+        composer.set_status_line_enabled(false);
+        let (rows, _) = status_rows(&composer, separate, 80, None);
+        assert!(
+            !rows
+                .iter()
+                .any(|row| row.contains("MODEL") || row.contains("Context"))
+        );
+    }
+}
+
+#[test]
+fn status_stats_survive_queue_drafts_and_follow_explicit_hint_priorities() {
+    for separate in [false, true] {
+        let mut composer = composer();
+        composer.set_status_line_stats(Some("STATS".into()));
+        composer.set_text_content("draft".into(), vec![], vec![]);
+        composer.set_task_running(true);
+        let (queue, _) = status_rows(&composer, separate, 80, None);
+        assert!(queue.iter().any(|row| row.contains("STATS")));
+        assert!(!queue.iter().any(|row| row.contains("to queue")));
+        composer.set_task_running(false);
+        composer.begin_history_search();
+        let (search, cursor) = status_rows(&composer, separate, 80, None);
+        assert!(cursor.is_some());
+        assert_eq!(search.iter().any(|row| row.contains("STATS")), separate);
+        let mut composer = self::composer();
+        composer.set_status_line_stats(Some("STATS".into()));
+        composer.show_quit_shortcut_hint(key_hint::ctrl(KeyCode::Char('c')), true);
+        let (quit, _) = status_rows(&composer, separate, 80, None);
+        assert_eq!(quit.iter().any(|row| row.contains("STATS")), separate);
+        let mut composer = self::composer();
+        composer.set_status_line_stats(Some("STATS".into()));
+        composer.handle_key_event(KeyCode::Char('?').into());
+        let (help, _) = status_rows(&composer, separate, 80, None);
+        assert!(help.iter().any(|row| row.contains("Keyboard shortcuts")));
+        assert_eq!(help.iter().any(|row| row.contains("STATS")), separate);
+    }
+}
+
+#[test]
+fn status_stats_do_not_receive_identity_hyperlink_or_effort_transition() {
+    for separate in [false, true] {
+        let mut composer = composer();
+        composer.set_status_line(Some(Line::from(Span::styled(
+            "PR #1",
+            Style::default().underlined(),
+        ))));
+        composer.set_status_line_stats(Some(Line::from(Span::styled(
+            "STATS",
+            Style::default().underlined(),
+        ))));
+        let url = "https://example.invalid/pull/1";
+        composer.set_status_line_hyperlink(Some(url.into()));
+        let (rows, _) = status_rows(&composer, separate, 80, None);
+        assert!(rows.iter().any(|row| row.contains(url)), "{rows:?}");
+        assert_eq!(rows.last().map(String::as_str), Some("STATS"));
+        composer.footer.status_line_hyperlink_url = None;
+        composer.effort_status_line_transition = Some(EffortStatusLineTransition::new(
+            EffortTier::Max,
+            "PREVIOUS MODEL".into(),
+        ));
+        let (rows, _) = status_rows(&composer, separate, 80, None);
+        assert!(
+            rows.iter().any(|row| row.contains("PREVIOUS MODEL")),
+            "{rows:?}"
+        );
+        assert_eq!(rows.last().map(String::as_str), Some("STATS"));
+    }
+}
