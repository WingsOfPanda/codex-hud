+use super::*;
+use crate::chatwidget::shell_policy::{
+    SHELL_FOREGROUND_LIMIT, ShellVisibility, eligible_shell, quiet_shell, shell_directive,
+    shell_result,
+};
+
+#[tokio::test]
+async fn shell_policy_advisor_transcript_real_foreground_wrapper_and_spaced_brief() {
+    let (mut chat, _, _) = make_chatwidget_manual(None).await;
+    chat.on_task_started();
+    let command = "# codex-plus-shell: foreground\n# codex-plus-advisor: wake and cancellation fixes\npython3 .build/audit-fixes/consult.py";
+    assert_eq!(shell_directive(command), Some((ShellVisibility::Foreground, command.into())));
+    begin_unified_exec_startup(&mut chat, "advisor", "process", command);
+    let cell = chat
+        .transcript
+        .active_cell
+        .as_ref()
+        .unwrap()
+        .as_any()
+        .downcast_ref::<ExecCell>()
+        .unwrap();
+    assert!(
+        cell.is_advisor(),
+        "stored command: {:?}",
+        cell.group.calls[0].command
+    );
+    chat.set_advisor(Some(crate::bottom_pane::worker_hud::AdvisorRow {
+        started_at_ms: Some(chrono::Utc::now().timestamp_millis() as u64),
+        model: Some("gpt-6-astra".into()),
+        state: crate::bottom_pane::worker_hud::AdvisorState::Running(4),
+    }));
+    let lines = chat.active_cell_owned_transcript_lines(120, false).unwrap();
+    assert_eq!(
+        lines
+            .activity
+            .iter()
+            .map(|line| line.line.to_string())
+            .collect::<Vec<_>>(),
+        vec!["• Advisor on wake and cancellation fixes · 0:04"]
+    );
+    chat.set_advisor(Some(crate::bottom_pane::worker_hud::AdvisorRow {
+        started_at_ms: Some((chrono::Utc::now().timestamp_millis() - 60_000) as u64),
+        model: Some("gpt-6-astra".into()),
+        state: crate::bottom_pane::worker_hud::AdvisorState::Running(64),
+    }));
+    assert!(
+        !chat
+            .active_cell_owned_transcript_lines(120, false)
+            .unwrap()
+            .activity
+            .iter()
+            .any(|line| line.line.to_string().contains("• Advisor on"))
+    );
