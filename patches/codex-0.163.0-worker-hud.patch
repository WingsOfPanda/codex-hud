+        hud.rows[0].total_tokens = Some(-1);
+        assert!(hud.lines(80)[0].to_string().contains("? tok"));
+    }
+
+    #[test]
+    fn actual_effort_distinguishes_missing_none_and_custom_values() {
+        let mut hud = WorkerHud::default();
+        for (reasoning_effort, expected) in [
+            (None, "?"),
+            (Some(ReasoningEffort::None), "none"),
+            (Some(ReasoningEffort::High), "high"),
+            (Some(ReasoningEffort::Medium), "medium"),
+            (
+                Some(ReasoningEffort::Custom("future\neffort".into())),
+                "future effort",
+            ),
+        ] {
+            hud.set(
+                vec![WorkerRow {
+                    group: None,
+                    dispatch_elapsed_secs: None,
+                    task: "probe".to_string(),
+                    state: WorkerState::Active,
+                    elapsed_secs: None,
+                    total_tokens: None,
+                    model: Some("gpt-6.1-sol".to_string()),
+                    reasoning_effort,
+                }],
+                false,
+                true,
+            );
+            assert!(
+                hud.lines(80)[0]
+                    .to_string()
+                    .starts_with(&format!("  GPT-6.1-Sol ({expected}) ·"))
+            );
+            let area = Rect::new(0, 0, 80, 2);
+            let mut buf = Buffer::empty(area);
+            buf.set_style(
+                area,
+                ratatui::style::Style::default().add_modifier(Modifier::DIM),
+            );
+            hud.render(area, &mut buf);
+            assert!(buf[(2, 0)].modifier.contains(Modifier::DIM));
+        }
+    }
+
+    fn grouped_member(key: &str, state: WorkerState, age: u64, tokens: i64) -> WorkerRow {
+        WorkerRow {
+            group: Some(WorkerGroup {
+                key: key.into(),
+                topic: "hud styling".into(),
+            }),
+            dispatch_elapsed_secs: Some(age),
+            task: "render".into(),
+            state,
+            elapsed_secs: Some(1),
+            total_tokens: Some(tokens),
+            model: Some("gpt-6.1-sol".into()),
+            reasoning_effort: Some(ReasoningEffort::High),
+        }
+    }
+
+    #[test]
+    fn worker_hud_group_counts_shrink_without_losing_completed_metrics() {
+        let mut hud = WorkerHud::default();
+        let mut rows = vec![
+            grouped_member("batch1", WorkerState::Active, 120, 1000),
+            grouped_member("batch1", WorkerState::Approval, 90, 2000),
+            grouped_member("batch1", WorkerState::Input, 60, 3000),
+        ];
+        for remaining in (0..=3).rev() {
+            hud.set(rows.clone(), false, true);
+            if remaining == 0 {
+                assert!(hud.lines(80).is_empty());
+                assert_eq!(hud.desired_height(80), 0);
+            } else {
+                assert_eq!(hud.desired_height(80), 1);
+                let lines = hud.lines(80);
+                assert_eq!(lines.len(), 1);
+                let state = if remaining == 1 {
+                    "wait input"
+                } else {
+                    "wait approval"
+                };
+                let suffix = if remaining == 1 { "" } else { "s" };
+                assert_eq!(
+                    lines[0].to_string(),
+                    format!(
+                        "  GPT-6.1-Sol (high) · hud styling ({remaining} agent{suffix}) · {state} · 2:00 · 6K tok"
+                    )
+                );
+                rows[3 - remaining].state = WorkerState::Idle;
+            }
+        }
+    }
+
+    #[test]
+    fn worker_hud_groups_preserve_unknowns_mixed_labels_and_stale_suppression() {
+        let mut hud = WorkerHud::default();
+        hud.set(
+            vec![
+                grouped_member("batch1", WorkerState::Done, 120, 1000),
+                grouped_member("batch1", WorkerState::Active, 60, 2000),
+                grouped_member("batch1", WorkerState::Input, 30, 3000),
+            ],
+            false,
+            true,
+        );
+        // Terminal members do not choose the active cohort's model or effort.
+        hud.rows[0].model = Some("gpt-6-astra".into());
+        hud.rows[0].reasoning_effort = Some(ReasoningEffort::Medium);
+        assert!(
+            hud.lines(100)[0]
+                .to_string()
+                .starts_with("  GPT-6.1-Sol (high)")
+        );
+        hud.rows[2].model = Some("gpt-6-sol".into());
+        assert!(hud.lines(100)[0].to_string().starts_with("  mixed (high)"));
+        hud.rows[2].model = Some("gpt-6.1-sol".into());
+        hud.rows[2].reasoning_effort = Some(ReasoningEffort::Medium);
+        assert!(
+            hud.lines(100)[0]
+                .to_string()
+                .starts_with("  GPT-6.1-Sol (mixed)")
+        );
+        hud.rows[2].model = Some("gpt-6-sol".into());
+        assert!(hud.lines(100)[0].to_string().starts_with("  mixed (mixed)"));
+        hud.rows[2].model = None;
+        hud.rows[2].reasoning_effort = None;
+        assert!(hud.lines(100)[0].to_string().starts_with("  ? (?)"));
+        for tokens in [None, Some(-1), Some(i64::MAX)] {
+            hud.rows[0].total_tokens = tokens;
+            assert!(hud.lines(100)[0].to_string().contains("? tok"));
+        }
+        hud.rows[0].dispatch_elapsed_secs = None;
+        assert!(
+            hud.lines(100)[0]
+                .to_string()
+                .contains(" · wait input · ? · ? tok")
+        );
+        hud.rows[0].dispatch_elapsed_secs = Some(120);
+        hud.rows[0].total_tokens = Some(1000);
+        hud.stale = true;
+        let line = hud.lines(100)[1].to_string();
+        assert!(line.contains("(? agents) · stale · ? · ? tok"));
+        assert!(!line.contains("2:00") && !line.contains("6K"));
+        assert!(hud.lines(100)[0].to_string().contains("counts unavailable"));
+    }
+
+    #[test]
+    fn worker_hud_caps_display_groups_and_keeps_counts_after_long_topics() {
+        let mut hud = WorkerHud::default();
+        let mut rows = Vec::new();
+        for key in ["parent-a/b1", "parent-a/b2", "parent-b/b1", "other/b1"] {
+            for _ in 0..3 {
+                rows.push(grouped_member(key, WorkerState::Active, 120, 1000));
+            }
+        }
+        // Similar untagged names and matching times remain separate display rows.
+        let mut standalone = grouped_member("unused", WorkerState::Active, 120, 1000);
+        standalone.group = None;
+        standalone.task = "hud styling render".into();
+        rows.push(standalone.clone());
+        standalone.task = "hud styling test".into();
+        rows.push(standalone);
+        rows[0].group.as_mut().unwrap().topic = "very_long_topic ".repeat(20);
+        hud.set(rows, false, true);
+        let lines = hud.lines(80);
+        assert_eq!(lines.len(), 3);
+        assert_eq!(hud.desired_height(80), 3);
+        assert_eq!(lines[2].to_string(), "  +4 more");
+        let line = lines[0].to_string();
+        assert!(line.contains("… (3 agents) · 2:00 · 3K tok"));
+        assert!(display_width(&line) <= 80);
+        let area = Rect::new(0, 0, 80, 5);
+        let mut buf = Buffer::empty(area);
+        hud.render(area, &mut buf);
+        let rendered: String = (0..80).map(|x| buf[(x, 0)].symbol()).collect();
+        assert!(rendered.contains("(3 agents)"));
+        assert!(buf[(2, 0)].modifier.contains(Modifier::DIM));
+        for width in [0, 1, 2, 8, 20, 40, 80] {
+            let area = Rect::new(0, 0, width, 5);
+            hud.render(area, &mut Buffer::empty(area));
+        }
+    }
+
+    #[test]
+    fn worker_hud_full_model_labels_preserve_versions_suffixes_and_unknown_ids() {
+        for (model, expected) in [
+            ("gpt-6-sol", "GPT-6-Sol"),
+            ("GPT-6.1-SOL", "GPT-6.1-Sol"),
+            ("gpt-6-astra", "GPT-6-Astra"),
+            ("gpt-12.34.5-astra", "GPT-12.34.5-Astra"),
+            ("gpt-6.1-sol-2026-10-16", "GPT-6.1-Sol-2026-10-16"),
+            ("gpt-6-astra-preview-FAST", "GPT-6-Astra-preview-FAST"),
+            ("gpt-6-sol-", "GPT-6-Sol-"),
+            ("Astra", "Astra"),
+            ("gpt-6-solar", "gpt-6-solar"),
+            ("gpt-solar", "gpt-solar"),
+            ("gpt--sol", "gpt--sol"),
+            ("gpt-6..1-sol", "gpt-6..1-sol"),
+            ("gpt-.6-sol", "gpt-.6-sol"),
+            ("gpt-6.-sol", "gpt-6.-sol"),
+            ("gpt-six-sol", "gpt-six-sol"),
+            ("gpt-６-sol", "gpt-６-sol"),
+            ("provider/gpt-6.1-sol", "provider/gpt-6.1-sol"),
+            ("provider-gpt-6-astra", "provider-gpt-6-astra"),
+            ("custom-sol-v2", "custom-sol-v2"),
+            ("custom/astra-v2", "custom/astra-v2"),
+            ("自定义/sol-模型", "自定义/sol-模型"),
+            ("custom/model-v2", "custom/model-v2"),
+            ("custom\nmodel\u{1b}", "custom model"),
+            (" gpt-6.1-sol ", "GPT-6.1-Sol"),
+            ("\n\u{1b}\t", "?"),
+            ("", "?"),
+        ] {
+            assert_eq!(model_label(Some(model)), expected);
+        }
+        assert_eq!(model_label(None), "?");
+    }
+}
