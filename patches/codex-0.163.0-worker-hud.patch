+async fn shell_policy_reported_duration_replay_and_unknown_duration() {
+    for (duration, expected_quiet) in [
+        (Some(2000), false),
+        (Some(2001), true),
+        (None, false),
+        (Some(-1), false),
+    ] {
+        let (mut chat, mut rx, _) = make_chatwidget_manual(None).await;
+        chat.on_task_started();
+        let item = begin_exec(&mut chat, "call", "# codex-plus-shell: auto\necho result");
+        let item = completed(item, duration, 0, "result\n");
+        chat.handle_command_execution_completed_now(item.clone());
+        chat.flush_active_cell();
+        let live = lines_to_single_string(&drain_insert_history(&mut rx).concat());
+        let (mut replay, mut replay_rx, _) = make_chatwidget_manual(None).await;
+        replay.handle_command_execution_completed_now(item);
+        replay.flush_active_cell();
+        let restored = lines_to_single_string(&drain_insert_history(&mut replay_rx).concat());
+        assert_eq!(live.contains("Shell completed"), expected_quiet);
+        assert_eq!(restored.contains("Shell completed"), expected_quiet);
+        assert!(!restored.contains("codex-plus-shell"));
+    }
+}
