+async fn ultracode_footer_reads_projection_without_adding_activity_rows() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(None).await;
+    let home = tempfile::tempdir().unwrap();
+    chat.config.codex_home =
+        codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(home.path()).unwrap();
+    let root = ThreadId::new();
+    chat.thread_id = Some(root);
+    chat.show_welcome_banner = false;
+    chat.local_settings.tui.status_line = Some(vec!["model".into()]);
+    chat.set_plus_goal_indicator(Some(GoalStatusIndicator::Plus("Goal active".into())));
+    chat.bottom_pane
+        .set_composer_text("editable draft".into(), Vec::new(), Vec::new());
+    chat.refresh_status_line();
+    let height = chat.desired_height(100);
+    let directory = home.path().join("codex-plus/ultracode");
+    std::fs::create_dir_all(&directory).unwrap();
+    let path = directory.join(format!("{root}.json"));
+    let mut projection = serde_json::json!({
+        "version":1,"root":root,"requested":{"enabled":true,"revision":1,"policy_version":1},
+        "effective":{"enabled":true,"revision":1,"policy_version":1,"submission":"s","turn":"t","generation":"g"},
+        "availability":"available","pending":[]
+    });
+    for (enabled, availability, revision) in [
+        (true, "available", 1),
+        (true, "available", 2),
+        (true, "unavailable", 2),
+        (false, "available", 2),
+        (false, "unavailable", 2),
+    ] {
+        projection["availability"] = availability.into();
+        projection["requested"]["enabled"] = enabled.into();
+        projection["requested"]["revision"] = revision.into();
+        std::fs::write(&path, projection.to_string()).unwrap();
+        let before = std::fs::read(&path).unwrap();
+        chat.refresh_ultracode_status();
+        assert_eq!(
+            status_line_text(&chat).unwrap(),
+            format!(
+                "{}{}",
+                chat.model_display_name(),
+                if enabled { " ultracode" } else { "" }
+            )
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), before);
+        assert_eq!(chat.desired_height(100), height);
+        let mut terminal = Terminal::new(TestBackend::new(100, height)).unwrap();
+        terminal
+            .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+            .unwrap();
+        let rendered = terminal
+            .backend()
+            .buffer()
+            .content()
+            .iter()
+            .map(|cell| cell.symbol())
+            .collect::<String>();
+        assert_eq!(rendered.contains("ultracode"), enabled, "{rendered:?}");
+        assert!(rendered.contains("Goal active"), "{rendered:?}");
+        assert_eq!(chat.bottom_pane.composer_text(), "editable draft");
+        assert_no_submit_op(&mut op_rx);
+        assert!(
+            !std::iter::from_fn(|| rx.try_recv().ok())
+                .any(|event| matches!(event, AppEvent::CodexOp(_)))
+        );
+    }
+    std::fs::write(&path, "malformed").unwrap();
+    chat.refresh_ultracode_status();
+    assert!(!status_line_text(&chat).unwrap().contains("ultracode"));
+    std::fs::remove_file(&path).unwrap();
+    chat.refresh_ultracode_status();
+    assert!(!status_line_text(&chat).unwrap().contains("ultracode"));
+    projection["availability"] = "available".into();
+    projection["requested"]["enabled"] = true.into();
+    projection["requested"]["revision"] = 1.into();
+    std::fs::write(&path, projection.to_string()).unwrap();
+    for items in [
+        vec!["weekly-reset", "model-with-reasoning", "model"],
+        vec!["model", "model-with-reasoning", "weekly-reset"],
+    ] {
+        chat.local_settings.tui.status_line =
+            Some(items.iter().map(|item| (*item).into()).collect());
+        let model = chat
+            .status_line_value_for_item(crate::bottom_pane::StatusLineItem::ModelWithReasoning)
+            .unwrap();
+        chat.refresh_ultracode_status();
+        let text = status_line_text(&chat).unwrap();
+        assert!(text.contains(&format!("{model} ultracode")), "{text}");
+        assert_eq!(text.matches("ultracode").count(), 1);
+        assert_eq!(chat.configured_status_line_items(), items);
+    }
+    chat.local_settings.tui.status_line = Some(vec!["weekly-reset".into()]);
+    chat.refresh_ultracode_status();
+    assert_eq!(status_line_text(&chat).unwrap(), "ultracode");
+    assert_eq!(
+        chat.bottom_pane.status_line_stats_text().as_deref(),
+        Some("reset unknown")
+    );
+    chat.local_settings.tui.status_line = Some(vec![]);
+    chat.refresh_ultracode_status();
+    assert!(chat.configured_status_line_items().is_empty());
+    assert_eq!(status_line_text(&chat), None);
+    assert_eq!(chat.bottom_pane.status_line_stats_text(), None);
+}
