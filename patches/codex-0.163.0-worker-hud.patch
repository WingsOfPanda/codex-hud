+#[tokio::test]
+async fn shell_policy_auto_timer_hides_preview_without_output_and_keeps_ps() {
+    let (mut chat, mut rx, _) = make_chatwidget_manual(None).await;
+    chat.on_task_started();
+    let item = begin_unified_exec_startup(
+        &mut chat,
+        "managed",
+        "proc",
+        "# codex-plus-shell: auto\nsleep 9",
+    );
+    assert!(active_blob(&chat).contains("sleep 9"));
+    assert!(!active_blob(&chat).contains("codex-plus-shell"));
+    let started = chat.managed_shells["managed"].started;
+    chat.update_shell_visibility_at(started + SHELL_FOREGROUND_LIMIT);
+    assert!(!chat.managed_shells["managed"].quiet);
+    chat.update_shell_visibility_at(started + SHELL_FOREGROUND_LIMIT + Duration::from_millis(1));
+    assert!(chat.managed_shells["managed"].quiet);
+    assert!(chat.transcript.active_cell.is_none());
+    chat.on_exec_command_output_delta("managed", "noise\n");
+    assert_eq!(chat.unified_exec_processes[0].recent_chunks, vec!["noise"]);
+    assert!(drain_insert_history(&mut rx).is_empty());
+    handle_exec_end(
+        &mut chat,
+        completed(
+            item,
+            Some(9000),
+            0,
+            "codex-plus log: /tmp/run.log\nnoise\ncodex-plus result: exit=0 log=/tmp/run.log\n",
+        ),
+    );
+    let text = lines_to_single_string(&drain_insert_history(&mut rx).concat());
+    assert!(text.contains("Shell completed (exit 0): sleep 9"));
+    assert!(text.contains("Log: /tmp/run.log"));
+    assert!(!text.contains("noise"));
+    assert!(chat.managed_shells.is_empty());
+    assert!(chat.unified_exec_processes.is_empty());
+}
