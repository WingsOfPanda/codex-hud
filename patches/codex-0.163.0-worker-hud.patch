diff --git a/codex-rs/tui/src/app/execution_hud.rs b/codex-rs/tui/src/app/execution_hud.rs
new file mode 100644
index 000000000..d1f989afc
--- /dev/null
+++ b/codex-rs/tui/src/app/execution_hud.rs
@@ -0,0 +1,330 @@
+//! Bounded, read-only projection of this local root's detached executions.
+
+use crate::bottom_pane::worker_hud::ExecutionHud;
+use crate::bottom_pane::worker_hud::ExecutionRow;
+use codex_protocol::ThreadId;
+use std::path::Path;
+
+const MAX_FILES: usize = 128;
+const MAX_BYTES: u64 = 16 * 1024;
+const STALE_SECS: f64 = 15.0;
+
+#[derive(serde::Deserialize)]
+struct Status {
+    schema: u32,
+    id: uuid::Uuid,
+    root: ThreadId,
+    topic: String,
+    state: String,
+    started_at: f64,
+    updated_at: f64,
+    stage: Option<String>,
+    error: Option<String>,
+}
+
+pub(super) fn read(home: &Path, root: ThreadId, now: f64) -> ExecutionHud {
+    let mut hud = ExecutionHud::default();
+    if read_inner(home, root, now, &mut hud).is_err() {
+        hud.unavailable = true;
+    }
+    hud
+}
+
+#[cfg(unix)]
+fn read_inner(
+    home: &Path,
+    root: ThreadId,
+    now: f64,
+    hud: &mut ExecutionHud,
+) -> std::io::Result<()> {
+    use std::ffi::CStr;
+    use std::ffi::CString;
+    use std::fs::File;
+    use std::io::Read;
+    use std::os::fd::AsRawFd;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::OpenOptionsExt;
+
+    fn open_at(directory: &File, name: &CStr, flags: i32) -> std::io::Result<File> {
+        let fd = unsafe {
+            libc::openat(
+                directory.as_raw_fd(),
+                name.as_ptr(),
+                flags | libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK,
+            )
+        };
+        if fd < 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        Ok(unsafe { File::from_raw_fd(fd) })
+    }
+
+    struct Entries(*mut libc::DIR);
+    impl Drop for Entries {
+        fn drop(&mut self) {
+            unsafe {
+                libc::closedir(self.0);
+            }
+        }
+    }
+
+    let mut directory = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(home)?;
+    // Open each component relative to its verified directory, including across replacements.
+    for component in [
+        "codex-plus".to_string(),
+        "execution-status".to_string(),
+        root.to_string(),
+    ] {
+        match open_at(
+            &directory,
+            &CString::new(component).unwrap(),
+            libc::O_RDONLY | libc::O_DIRECTORY,
+        ) {
+            Ok(next) => directory = next,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+            Err(error) => return Err(error),
+        }
+    }
+    let duplicate = unsafe { libc::dup(directory.as_raw_fd()) };
+    if duplicate < 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    let entries = unsafe { libc::fdopendir(duplicate) };
+    if entries.is_null() {
+        unsafe {
+            libc::close(duplicate);
+        }
+        return Err(std::io::Error::last_os_error());
+    }
+    let entries = Entries(entries);
+    let mut count = 0;
+    loop {
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        unsafe {
+            *libc::__errno_location() = 0;
+        }
+        #[cfg(any(target_os = "macos", target_os = "ios", target_os = "freebsd"))]
+        unsafe {
+            *libc::__error() = 0;
+        }
+        let entry = unsafe { libc::readdir(entries.0) };
+        if entry.is_null() {
+            #[cfg(any(
+                target_os = "linux",
+                target_os = "android",
+                target_os = "macos",
+                target_os = "ios",
+                target_os = "freebsd"
+            ))]
+            {
+                let error = std::io::Error::last_os_error();
+                if error.raw_os_error() != Some(0) {
+                    return Err(error);
+                }
+            }
+            break;
+        }
+        let name = unsafe { CStr::from_ptr((*entry).d_name.as_ptr()) };
+        if matches!(name.to_bytes(), b"." | b"..") {
+            continue;
+        }
+        count += 1;
+        if count > MAX_FILES {
+            return Err(std::io::Error::other("execution status count exceeded"));
+        }
+        // Atomic writers may leave a temporary file; only UUID.json is a published record.
+        let path = Path::new(std::ffi::OsStr::from_bytes(name.to_bytes()));
+        if path.extension().is_none_or(|extension| extension != "json") {
+            continue;
+        }
+        let status = (|| {
+            let id = uuid::Uuid::parse_str(path.file_stem()?.to_str()?).ok()?;
+            let file = open_at(&directory, name, libc::O_RDONLY).ok()?;
+            let metadata = file.metadata().ok()?;
+            if !metadata.is_file() || metadata.len() > MAX_BYTES {
+                return None;
+            }
+            let mut bytes = Vec::new();
+            file.take(MAX_BYTES + 1).read_to_end(&mut bytes).ok()?;
+            if bytes.len() as u64 > MAX_BYTES {
+                return None;
+            }
+            let status = serde_json::from_slice::<Status>(&bytes).ok()?;
+            (status.schema == 1
+                && status.id == id
+                && status.root == root
+                && now.is_finite()
+                && status.started_at.is_finite()
+                && status.updated_at.is_finite()
+                && status.started_at >= 0.0
+                && status.started_at <= status.updated_at
+                && status.updated_at <= now + 5.0)
+                .then_some(status)
+        })();
+        let Some(status) = status else {
+            hud.unavailable = true;
+            continue;
+        };
+        let mut problem = match status.state.as_str() {
+            "launching" | "running" => None,
+            "cancel_requested" => Some("cancel requested".to_string()),
+            "unknown" => Some("unknown".to_string()),
+            "completed" | "failed" | "cancelled" => continue,
+            _ => {
+                hud.unavailable = true;
+                continue;
+            }
+        };
+        if now - status.updated_at > STALE_SECS {
+            problem = Some("stale".to_string());
+        }
+        hud.unavailable |=
+            matches!(problem.as_deref(), Some("unknown" | "stale")) || status.error.is_some();
+        hud.rows.push(ExecutionRow {
+            topic: status.topic,
+            stage: status.stage.filter(|stage| !stage.trim().is_empty()),
+            elapsed_secs: (now - status.started_at).max(0.0) as u64,
+            problem,
+        });
+    }
+    hud.rows.sort_by(|a, b| a.topic.cmp(&b.topic));
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn read_inner(
+    home: &Path,
+    root: ThreadId,
+    _now: f64,
+    _hud: &mut ExecutionHud,
+) -> std::io::Result<()> {
+    if home
+        .join("codex-plus/execution-status")
+        .join(root.to_string())
+        .exists()
+    {
+        return Err(std::io::Error::other("local execution status unsupported"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    pub(super) fn status(root: ThreadId, id: uuid::Uuid) -> serde_json::Value {
+        serde_json::json!({"schema":1, "root":root, "id":id, "topic":"build 模型\nprogress",
+            "state":"running", "started_at":100.0, "updated_at":155.0})
+    }
+
+    #[test]
+    fn execution_hud_bounds_and_validates_each_published_record() {
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        let id = uuid::Uuid::new_v4();
+        let directory = home
+            .path()
+            .join("codex-plus/execution-status")
+            .join(root.to_string());
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = directory.join(format!("{id}.json"));
+        let original = status(root, id);
+        std::fs::write(&path, original.to_string()).unwrap();
+        let hud = read(home.path(), root, 160.0);
+        assert!(!hud.unavailable);
+        assert_eq!(hud.rows[0].elapsed_secs, 60);
+        assert_eq!(hud.rows[0].stage, None);
+        assert!(read(home.path(), ThreadId::new(), 160.0).rows.is_empty());
+        // A new read after reconnect retains the durable start time.
+        assert_eq!(read(home.path(), root, 165.0).rows[0].elapsed_secs, 65);
+        let mut reported = original.clone();
+        reported["stage"] = "compile".into();
+        std::fs::write(&path, reported.to_string()).unwrap();
+        assert_eq!(
+            read(home.path(), root, 160.0).rows[0].stage.as_deref(),
+            Some("compile")
+        );
+        for (field, value) in [
+            ("schema", serde_json::json!(2)),
+            ("root", serde_json::json!(ThreadId::new())),
+            ("id", serde_json::json!(uuid::Uuid::new_v4())),
+            ("state", serde_json::json!("invented")),
+            ("started_at", serde_json::json!(-1)),
+            ("started_at", serde_json::json!(156)),
+            ("updated_at", serde_json::json!(999)),
+            ("updated_at", serde_json::json!("NaN")),
+        ] {
+            let mut invalid = original.clone();
+            invalid[field] = value;
+            std::fs::write(&path, invalid.to_string()).unwrap();
+            let hud = read(home.path(), root, 160.0);
+            assert!(hud.unavailable, "{field}");
+            assert!(hud.rows.is_empty(), "{field}");
+        }
+        for contents in ["{".to_string(), "x".repeat(MAX_BYTES as usize + 1)] {
+            std::fs::write(&path, contents).unwrap();
+            assert!(read(home.path(), root, 160.0).unavailable);
+        }
+        std::fs::write(&path, original.to_string()).unwrap();
+        let stale = read(home.path(), root, 171.0);
+        assert!(stale.unavailable);
+        assert_eq!(stale.rows[0].problem.as_deref(), Some("stale"));
+        for state in [
+            "unknown",
+            "cancel_requested",
+            "launching",
+            "completed",
+            "failed",
+            "cancelled",
+        ] {
+            let mut record = original.clone();
+            record["state"] = state.into();
+            std::fs::write(&path, record.to_string()).unwrap();
+            let hud = read(home.path(), root, 160.0);
+            assert_eq!(
+                hud.rows.is_empty(),
+                matches!(state, "completed" | "failed" | "cancelled")
+            );
+            assert_eq!(hud.unavailable, state == "unknown");
+        }
+        std::fs::remove_file(&path).unwrap();
+        assert_eq!(read(home.path(), root, 160.0), ExecutionHud::default());
+        for index in 0..=MAX_FILES {
+            std::fs::write(directory.join(format!("tmp-{index}")), "").unwrap();
+        }
+        assert!(read(home.path(), root, 160.0).unavailable);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn execution_hud_rejects_symlink_directories_files_and_fifo() {
+        use std::os::unix::fs::symlink;
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        let id = uuid::Uuid::new_v4();
+        let parent = home.path().join("codex-plus/execution-status");
+        let directory = parent.join(root.to_string());
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = directory.join(format!("{id}.json"));
+        let target = home.path().join("target");
+        std::fs::write(&target, status(root, id).to_string()).unwrap();
+        symlink(&target, &path).unwrap();
+        assert!(read(home.path(), root, 160.0).unavailable);
+        std::fs::remove_file(&path).unwrap();
+        let fifo = std::ffi::CString::new(path.as_os_str().as_encoded_bytes()).unwrap();
+        assert_eq!(unsafe { libc::mkfifo(fifo.as_ptr(), 0o600) }, 0);
+        assert!(read(home.path(), root, 160.0).unavailable);
+        std::fs::remove_file(&path).unwrap();
+        std::fs::remove_dir(&directory).unwrap();
+        symlink(home.path(), &directory).unwrap();
+        assert!(read(home.path(), root, 160.0).unavailable);
+        std::fs::remove_file(&directory).unwrap();
+        std::fs::remove_dir(&parent).unwrap();
+        symlink(home.path(), &parent).unwrap();
+        assert!(read(home.path(), root, 160.0).unavailable);
