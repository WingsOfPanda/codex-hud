+    complete_turn_with_message(&mut chat, "turn-1", Some("done"));
+
+    assert!(chat.input_queue.queued_user_messages.is_empty());
+    assert_eq!(chat.bottom_pane.composer_text(), "A newer draft");
+    match next_submit_op(&mut op_rx) {
+        Op::UserTurn { items, .. } => assert_eq!(
+            items,
+            vec![UserInput::Text {
+                text: "An unrelated queued follow-up".into(),
+                text_elements: vec![],
+            }]
+        ),
+        other => panic!("expected unrelated queued follow-up, got {other:?}"),
+    }
+    let events = std::iter::from_fn(|| rx.try_recv().ok()).collect::<Vec<_>>();
+    assert!(
+        !events
+            .iter()
+            .any(|event| matches!(event, AppEvent::PlusUltracodeCommand { .. }))
+    );
+    let cells = events
+        .into_iter()
+        .filter_map(|event| {
+            if let AppEvent::InsertHistoryCell(cell) = event {
+                Some(cell)
+            } else {
+                None
+            }
+        })
+        .collect::<Vec<_>>();
+    assert!(cells.iter().any(|cell| {
+        cell.display_lines(100)
+            .iter()
+            .any(|line| line.to_string().contains("Usage: /ultracode on|off|status"))
+    }));
+}
