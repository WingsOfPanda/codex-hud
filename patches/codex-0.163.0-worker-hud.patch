+#[tokio::test]
+async fn weekly_reset_uses_matching_cached_window_and_live_clock_without_changing_selection() {
+    use crate::bottom_pane::StatusLineItem;
+    let (mut chat, mut rx, mut ops) = make_chatwidget_manual(None).await;
+    let now = chrono::Utc::now().timestamp();
+    let weekly = RateLimitWindow {
+        used_percent: 50,
+        window_duration_mins: Some(7 * 24 * 60),
+        resets_at: Some(now + 2 * 86400 + 5 * 3600),
+    };
+    let other = RateLimitWindow {
+        used_percent: 20,
+        window_duration_mins: Some(5 * 60),
+        resets_at: Some(now + 3600),
+    };
+    let mut snapshot = RateLimitSnapshot {
+        limit_id: None,
+        limit_name: None,
+        normal_model_slug: None,
+        primary: Some(other.clone()),
+        secondary: Some(weekly),
+        credits: None,
+        individual_limit: None,
+        plan_type: None,
+        spend_control_reached: None,
+        rate_limit_reached_type: None,
+    };
+    assert!(
+        !chat
+            .configured_status_line_items()
+            .contains(&"weekly-reset".to_string())
+    );
+    for _ in 0..2 {
+        chat.on_rate_limit_snapshot(Some(snapshot.clone()));
+        assert_eq!(
+            chat.status_line_value_for_item(StatusLineItem::WeeklyReset),
+            Some("resets in 2d 5h".into())
+        );
+        std::mem::swap(&mut snapshot.primary, &mut snapshot.secondary);
+    }
+    chat.local_settings.tui.status_line = Some(vec!["weekly-reset".into(), "model".into()]);
+    let selection = chat.local_settings.tui.status_line.clone();
+    let cached = chat
+        .rate_limit_snapshots_by_limit_id
+        .get_mut("codex")
+        .unwrap();
+    cached.captured_at -= chrono::Duration::days(10);
+    chat.refresh_ultracode_status();
+    assert!(
+        chat.bottom_pane
+            .status_line_stats_text()
+            .unwrap()
+            .contains("resets in 2d 5h")
+    );
+    chat.rate_limit_snapshots_by_limit_id
+        .get_mut("codex")
+        .unwrap()
+        .primary
+        .as_mut()
+        .unwrap()
+        .reset_timestamp = Some(now - 1);
+    chat.refresh_ultracode_status();
+    assert!(
+        chat.bottom_pane
+            .status_line_stats_text()
+            .unwrap()
+            .contains("reset due")
+    );
+    assert_eq!(chat.local_settings.tui.status_line, selection);
+    assert_no_submit_op(&mut ops);
+    assert!(
+        !std::iter::from_fn(|| rx.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::CodexOp(_)))
+    );
+    snapshot.primary = None;
+    snapshot.secondary = Some(other);
+    chat.on_rate_limit_snapshot(Some(snapshot));
+    assert_eq!(
+        chat.status_line_value_for_item(StatusLineItem::WeeklyReset),
+        Some("reset unknown".into())
+    );
+    chat.on_rate_limit_snapshot(None);
+    assert_eq!(
+        chat.status_line_value_for_item(StatusLineItem::WeeklyReset),
+        Some("reset unknown".into())
+    );
+}
