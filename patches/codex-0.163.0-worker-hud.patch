+#[test]
+fn shell_policy_bounded_failure_and_untrusted_log() {
+    let output = format!(
+        "codex-plus log: /tmp/log\n\x1b[31merror\x1b[0m\r{}\nlast error\ncodex-plus result: exit=7 log=/tmp/log log_incomplete=true\n",
+        "x".repeat(10000)
+    );
+    let lines = shell_result("echo \x1b[2Jbad", &output, 7);
+    let text = lines_to_single_string(&lines);
+    assert!(text.contains("exit 7"));
+    assert!(text.contains("Log: /tmp/log"));
+    assert!(text.contains("Log incomplete"));
+    assert!(text.contains("last error"));
+    assert!(!text.contains('\x1b'));
+    assert!(!text.contains('\r'));
+    assert!(text.len() < 1200);
+    assert!(
+        lines_to_single_string(&shell_result("ok", "success\n", 0)).contains("Log unavailable")
+    );
+    assert!(
+        lines_to_single_string(&shell_result("ok", "codex-plus log: relative\n", 0))
+            .contains("Log unavailable")
+    );
+}
