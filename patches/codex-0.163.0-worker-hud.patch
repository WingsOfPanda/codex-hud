+//! Read-only worker summary; clipping never takes space from the composer.
+
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::render::renderable::Renderable;
+use crate::status::format_tokens_compact;
+use crate::width::display_width;
+use codex_protocol::openai_models::ReasoningEffort;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use std::collections::HashMap;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum WorkerState {
+    Active,
+    Approval,
+    Input,
+    Idle,
+    Done,
+    Failed,
+    Interrupted,
+    Unloaded,
+    Error,
+}
+
+impl WorkerState {
+    pub(crate) fn label(&self) -> &'static str {
+        match self {
+            Self::Active => "active",
+            Self::Approval => "wait approval",
+            Self::Input => "wait input",
+            Self::Idle => "idle",
+            Self::Done => "done",
+            Self::Failed => "failed",
+            Self::Interrupted => "interrupted",
+            Self::Unloaded => "unloaded",
+            Self::Error => "error",
+        }
+    }
+
+    pub(crate) fn is_active(&self) -> bool {
+        matches!(self, Self::Active | Self::Approval | Self::Input)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct WorkerGroup {
+    pub(crate) key: String,
+    pub(crate) topic: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct WorkerRow {
+    pub(crate) group: Option<WorkerGroup>,
+    pub(crate) dispatch_elapsed_secs: Option<u64>,
+    pub(crate) task: String,
+    pub(crate) state: WorkerState,
+    pub(crate) elapsed_secs: Option<u64>,
+    pub(crate) total_tokens: Option<i64>,
+    pub(crate) model: Option<String>,
+    pub(crate) reasoning_effort: Option<ReasoningEffort>,
+    pub(crate) agent_role: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ShellRow {
+    pub(crate) command: String,
+    pub(crate) job_id: String,
+    // The stock API has no start time; this is time observed by this TUI only.
+    pub(crate) seen_secs: Option<u64>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct ExecutionHud {
+    pub(crate) rows: Vec<ExecutionRow>,
+    pub(crate) unavailable: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ExecutionRow {
+    pub(crate) topic: String,
+    pub(crate) stage: Option<String>,
+    pub(crate) elapsed_secs: u64,
+    pub(crate) problem: Option<String>,
+}
+
+#[derive(Default)]
+pub(crate) struct WorkerHud {
+    rows: Vec<WorkerRow>,
+    stale: bool,
+    visible: bool,
+    shells: Vec<ShellRow>,
+    shells_stale: bool,
+    shells_visible: bool,
+    watcher: Option<WatcherHealth>,
+    advisor: Option<AdvisorRow>,
+    executions: ExecutionHud,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum WatcherHealth {
+    Waiting(u64),
+    Uncertain(u64),
+    Unavailable,
+    Report(u64),
+}
+
+impl WatcherHealth {
+    fn label(&self) -> Option<String> {
+        match self {
+            Self::Waiting(0) => Some("Wake pending".to_string()),
+            Self::Waiting(_) => None,
+            Self::Uncertain(count) => Some(format!("Wake delivery uncertain · {count}")),
+            Self::Unavailable => Some("Watcher unavailable".to_string()),
+            Self::Report(count) => Some(format!("Restart report ready · {count}")),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct AdvisorRow {
+    pub(crate) started_at_ms: Option<u64>,
+    pub(crate) model: Option<String>,
+    pub(crate) state: AdvisorState,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum AdvisorState {
+    Ready,
+    Running(u64),
+    Done { calls: u64, last_secs: u64 },
+    Error,
+    Unavailable,
+}
+
+pub(crate) fn supported_advisor_model(model: &str) -> bool {
+    model == "claude-opus-5-5"
+        || model
+            .strip_prefix("gpt-")
+            .and_then(|version| version.strip_suffix("-astra"))
+            .is_some_and(|version| {
+                version.split('.').all(|part| {
+                    !part.is_empty()
+                        && part.bytes().all(|ch| ch.is_ascii_digit())
+                        && part.parse::<u64>().is_ok()
+                })
+            })
+}
+
+impl AdvisorRow {
+    fn line(&self) -> Line<'static> {
+        let status = match self.state {
+            AdvisorState::Ready => "ready · 0 calls".to_string(),
+            AdvisorState::Running(secs) => format!("reviewing · {}:{:02}", secs / 60, secs % 60),
+            AdvisorState::Done { calls, last_secs } => format!(
+                "{calls} {} · last {}:{:02}",
+                if calls == 1 { "call" } else { "calls" },
+                last_secs / 60,
+                last_secs % 60
+            ),
+            AdvisorState::Error => "error".to_string(),
+            AdvisorState::Unavailable => "unavailable".to_string(),
+        };
+        let label = match self.model.as_deref() {
+            Some(model) => format!("Advisor · {} (xhigh)", model_label(Some(model))),
+            None => "Advisor".to_string(),
+        };
+        let line = Line::from(format!("  {label} · {status}"));
+        if matches!(self.state, AdvisorState::Error | AdvisorState::Unavailable) {
+            line.not_dim()
+        } else {
+            line.dim()
+        }
+    }
+}
+
+impl WorkerHud {
+    pub(crate) fn set_executions(&mut self, executions: ExecutionHud) -> bool {
+        if self.executions == executions {
+            return false;
+        }
+        self.executions = executions;
+        true
+    }
+
+    pub(crate) fn set_advisor(&mut self, advisor: Option<AdvisorRow>) -> bool {
+        if self.advisor == advisor {
+            return false;
+        }
+        self.advisor = advisor;
+        true
+    }
+
+    pub(crate) fn set_watcher(&mut self, watcher: Option<WatcherHealth>) -> bool {
+        if self.watcher == watcher {
+            return false;
+        }
+        self.watcher = watcher;
+        true
+    }
+
+    pub(crate) fn set(&mut self, rows: Vec<WorkerRow>, stale: bool, visible: bool) -> bool {
+        if self.rows == rows && self.stale == stale && self.visible == visible {
+            return false;
+        }
+        self.rows = rows;
+        self.stale = stale;
+        self.visible = visible;
+        true
+    }
+
+    pub(crate) fn set_shells(&mut self, rows: Vec<ShellRow>, stale: bool, visible: bool) -> bool {
+        if self.shells == rows && self.shells_stale == stale && self.shells_visible == visible {
+            return false;
+        }
+        self.shells = rows;
+        self.shells_stale = stale;
+        self.shells_visible = visible;
+        true
+    }
+
+    fn display_rows(&self) -> Vec<Vec<&WorkerRow>> {
+        let mut rows: Vec<Vec<&WorkerRow>> = Vec::new();
+        let mut groups = HashMap::new();
+        for row in &self.rows {
+            if let Some(group) = &row.group {
+                let index = *groups.entry(&group.key).or_insert_with(|| {
+                    rows.push(Vec::new());
+                    rows.len() - 1
+                });
+                rows[index].push(row);
+            } else if row.state.is_active() {
+                rows.push(vec![row]);
+            }
+        }
+        rows.retain(|members| members.iter().any(|row| row.state.is_active()));
+        rows
+    }
+
+    pub(super) fn lines(&self, width: u16) -> Vec<Line<'static>> {
+        self.lines_with_budget(width, 6)
+    }
+
+    pub(crate) fn lines_with_budget(&self, width: u16, row_budget: u16) -> Vec<Line<'static>> {
+        let row_budget = usize::from(row_budget.min(6));
+        if width == 0 || row_budget == 0 {
+            return Vec::new();
+        }
+        let mut display_rows = if self.visible {
+            self.display_rows()
+        } else {
+            Vec::new()
+        };
+        let shells: Vec<_> = self
+            .shells
+            .iter()
+            .filter(|shell| {
+                self.shells_visible
+                    && !(self
+                        .advisor
+                        .as_ref()
+                        .is_some_and(|row| matches!(row.state, AdvisorState::Running(_)))
+                        && advisor_command(&shell.command))
+            })
+            .collect();
+        let mut alerts = Vec::new();
+        alerts.extend(self.watcher.as_ref().and_then(WatcherHealth::label));
+        if self.visible && self.stale {
+            alerts.push("Workers stale · counts unavailable".to_string());
+        }
+        if self.shells_visible && self.shells_stale {
+            alerts.push("Shells stale · counts unavailable".to_string());
+        }
+        let mut lines = Vec::new();
+        if !alerts.is_empty() {
+            lines.push(Line::from(format!("  {}", alerts.join(" · "))).not_dim());
+        }
+        if let Some(advisor) = &self.advisor {
+            lines.push(advisor.line());
+        }
+        let total = display_rows.len() + shells.len() + self.executions.rows.len();
+        // Coalesce priority rows when necessary, retaining hidden activity counts.
+        if lines.len() > row_budget {
+            let extra = lines.split_off(row_budget);
+            let last = lines.last_mut().unwrap();
+            for line in extra {
+                last.push_span(" · ");
+                last.extend(line.spans);
+            }
+        }
+        let available = row_budget.saturating_sub(lines.len());
+        if available == 0 {
+            if total > 0 {
+                lines
+                    .last_mut()
+                    .unwrap()
+                    .spans
+                    .insert(0, format!("  +{total} more · ").into());
+            }
+            return lines;
+        }
+        let activity_limit = available.saturating_sub(usize::from(total > available));
+        display_rows.sort_by_key(|members| {
+            !members
+                .iter()
+                .any(|row| matches!(row.state, WorkerState::Approval | WorkerState::Input))
+        });
+        // Reserve a row for each nonempty activity category before filling the remaining space.
+        let worker_limit = display_rows.len().min(activity_limit.saturating_sub(
+            usize::from(!shells.is_empty()) + usize::from(!self.executions.rows.is_empty()),
+        ));
+        let shell_limit = shells.len().min(
+            activity_limit
+                .saturating_sub(worker_limit + usize::from(!self.executions.rows.is_empty())),
+        );
+        let execution_limit = self.executions.rows.len().min(
+            activity_limit
+                .saturating_sub(worker_limit)
+                .saturating_sub(shell_limit),
+        );
+        for members in display_rows.iter().take(worker_limit) {
+            let row = members[0];
+            let current: Vec<_> = members.iter().filter(|row| row.state.is_active()).collect();
+            let grouped = row.group.is_some();
+            let elapsed = if self.stale {
+                None
+            } else if grouped {
+                members
+                    .iter()
+                    .try_fold(0, |age, row| Some(age.max(row.dispatch_elapsed_secs?)))
+            } else {
+                row.elapsed_secs
+            };
+            let time = elapsed
+                .map(|secs| format!("{}:{:02}", secs / 60, secs % 60))
+                .unwrap_or_else(|| "?".to_string());
+            let total_tokens = if self.stale {
+                None
+            } else {
+                members.iter().try_fold(0i64, |total, row| {
+                    total.checked_add(row.total_tokens.filter(|tokens| *tokens >= 0)?)
+                })
+            };
+            let tokens = total_tokens
+                .map(format_tokens_compact)
+                .unwrap_or_else(|| "?".to_string());
+            let state = if self.stale {
+                "stale"
+            } else if current.iter().any(|row| row.state == WorkerState::Approval) {
+                WorkerState::Approval.label()
+            } else if current.iter().any(|row| row.state == WorkerState::Input) {
+                WorkerState::Input.label()
+            } else {
+                ""
+            };
+            let first = current[0];
+            let model = if current.iter().any(|row| row.model.is_none()) {
+                "?".to_string()
+            } else if current.iter().all(|row| row.model == first.model) {
+                model_label(first.model.as_deref())
+            } else {
+                "mixed".to_string()
+            };
+            let effort = if current.iter().any(|row| row.reasoning_effort.is_none()) {
+                "?".to_string()
+            } else if current
+                .iter()
+                .all(|row| row.reasoning_effort == first.reasoning_effort)
+            {
+                effort_label(first.reasoning_effort.as_ref())
+            } else {
+                "mixed".to_string()
+            };
+            let role = if current.iter().any(|row| row.agent_role.is_none()) {
+                "general"
+            } else if current.iter().all(|row| row.agent_role == first.agent_role) {
+                first.agent_role.as_deref().unwrap_or("general")
+            } else {
+                "mixed"
+            };
+            let prefix = format!("  {model} ({effort}) [{role}] · ");
+            let state = if state.is_empty() {
+                String::new()
+            } else {
+                format!(" · {state}")
+            };
+            let metrics = format!("{state} · {time} · {tokens} tok");
+            let count = if grouped {
+                if self.stale {
+                    " (? agents)".to_string()
+                } else {
+                    let suffix = if current.len() == 1 { "" } else { "s" };
+                    format!(" ({} agent{suffix})", current.len())
+                }
+            } else {
+                String::new()
+            };
+            let task_width = usize::from(width)
+                .saturating_sub(display_width(&prefix) + display_width(&metrics))
+                .max(12.min(usize::from(width).saturating_sub(display_width(&prefix))))
+                .saturating_sub(display_width(&count));
+            let label = row.group.as_ref().map_or(&row.task, |group| &group.topic);
+            let task =
+                truncate_line_with_ellipsis_if_overflow(Line::from(label.clone()), task_width);
+            lines.push(Line::from(format!("{prefix}{task}{count}{metrics}")).dim());
+        }
+        for shell in shells.iter().take(shell_limit) {
+            let state = if self.shells_stale { " · stale" } else { "" };
+            let seen = if self.shells_stale {
+                None
+            } else {
+                shell.seen_secs
+            };
+            let seen = seen
+                .map(|secs| format!("{}:{:02}", secs / 60, secs % 60))
+                .unwrap_or_else(|| "?".into());
+            let prefix = "  Background · ";
+            let metrics = format!("{state} · seen {seen}");
+            let command_width = usize::from(width)
+                .saturating_sub(display_width(prefix) + display_width(&metrics))
+                .max(12.min(usize::from(width).saturating_sub(display_width(prefix))));
+            // Keep raw syntax for coalescing; shorten managed commands for display only.
+            let label = crate::chatwidget::shell_policy::shell_hud_label(&shell.command);
+            let command = truncate_line_with_ellipsis_if_overflow(
+                Line::from(sanitize_label(&label, 160)),
+                command_width,
+            );
+            lines.push(Line::from(format!("{prefix}{command}{metrics}")).dim());
+        }
+        for execution in self.executions.rows.iter().take(execution_limit) {
+            let secs = execution.elapsed_secs;
+            let metrics = format!(" · {}:{:02}", secs / 60, secs % 60);
+            let prefix = "  Background · ";
+            let mut label = sanitize_label(&execution.topic, 160);
+            if let Some(stage) = &execution.stage {
+                label.push_str(&format!(" · {}", sanitize_label(stage, 80)));
+            }
+            if let Some(problem) = &execution.problem {
+                label.push_str(&format!(" · {problem}"));
+            }
+            let label = truncate_line_with_ellipsis_if_overflow(
+                Line::from(label),
+                usize::from(width).saturating_sub(display_width(prefix) + display_width(&metrics)),
+            );
+            let line = Line::from(format!("{prefix}{label}{metrics}"));
+            lines.push(if execution.problem.is_some() {
+                line.not_dim()
+            } else {
+                line.dim()
+            });
+        }
+        let more = total
+            .saturating_sub(worker_limit)
+            .saturating_sub(shell_limit)
+            .saturating_sub(execution_limit);
+        if more > 0 {
+            lines.push(Line::from(format!("  +{more} more")).dim());
+        }
+        lines
+    }
+}
+
+pub(crate) fn advisor_command(command: &str) -> bool {
+    advisor_topic(command).is_some()
+}
+
+pub(crate) fn advisor_topic(command: &str) -> Option<String> {
+    fn invocation(args: &[String], depth: u8) -> Option<String> {
+        if depth > 2 {
+            return None;
+        }
+        let program = args.first()?;
+        let launcher = program == "codex-plus"
+            || program == "./bin/codex-plus"
+            || (std::path::Path::new(program).is_absolute()
+                && program.ends_with("/bin/codex-plus"));
+        if launcher {
+            if args.get(1).is_some_and(|arg| arg == "advisor") {
+                let mut options = HashMap::new();
+                let mut context_files = 0;
+                let mut claude_options = false;
+                let mut args = args[2..].iter();
+                while let Some(arg) = args.next() {
+                    let (flag, value) = match arg.split_once('=') {
+                        Some(pair) => pair,
+                        None => (arg.as_str(), args.next()?.as_str()),
+                    };
+                    if flag != "--context-file" && options.insert(flag, value).is_some() {
+                        return None;
+                    }
+                    match flag {
+                        "--brief" => {}
+                        "--provider" if matches!(value, "claude" | "astra") => {}
+                        "--host"
+                            if !value.is_empty()
+                                && value.len() <= 253
+                                && !value.starts_with('-')
+                                && value.bytes().all(|byte| {
+                                    byte.is_ascii_alphanumeric()
+                                        || matches!(byte, b'-' | b'_' | b'.')
+                                }) =>
+                        {
+                            claude_options = true;
+                        }
+                        "--remote-command"
+                            if !value.is_empty()
+                                && value.len() <= 4096
+                                && !value.chars().any(char::is_control) =>
+                        {
+                            claude_options = true;
+                        }
+                        "--context-file"
+                            if context_files < 8 && !value.is_empty() && value.len() <= 4096 =>
+                        {
+                            context_files += 1;
+                            claude_options = true;
+                        }
+                        _ => return None,
+                    }
+                }
+                if options.get("--provider") == Some(&"astra") && claude_options {
+                    return None;
+                }
+                let brief: String = options
+                    .get("--brief")?
+                    .chars()
+                    .map(|ch| if ch.is_control() { ' ' } else { ch })
+                    .collect();
+                return Some(
+                    brief
+                        .split_whitespace()
+                        .take(10)
+                        .collect::<Vec<_>>()
+                        .join(" "),
+                )
+                .filter(|topic| !topic.is_empty());
+            }
+            if args.len() > 3 && args[1] == "run" && args[2] == "--" {
+                return invocation(&args[3..], depth + 1);
+            }
+        }
+        if args.len() == 3
+            && matches!(
+                std::path::Path::new(program)
+                    .file_name()
+                    .and_then(|s| s.to_str()),
+                Some("bash" | "sh" | "zsh")
+            )
+            && matches!(args[1].as_str(), "-c" | "-lc")
+        {
+            return topic(&args[2], depth + 1);
+        }
+        None
+    }
+    fn topic(command: &str, depth: u8) -> Option<String> {
+        let (policy, command) = match command.split_once('\n') {
+            Some((
+                marker @ ("# codex-plus-shell: auto"
+                | "# codex-plus-shell: background"
+                | "# codex-plus-shell: foreground"),
+                body,
+            )) => (
+                Some(marker),
+                crate::chatwidget::shell_policy::strip_task_metadata(body).0,
+            ),
+            _ => (None, command),
+        };
+        if policy == Some("# codex-plus-shell: foreground") {
+            let body = command;
+            if let Some((marker, body)) = body.split_once('\n') {
+                if let Some(topic) = marker.strip_prefix("# codex-plus-advisor: ") {
+                    return (!topic.trim().is_empty()
+                        && topic.chars().count() <= 120
+                        && !topic.chars().any(char::is_control)
+                        && !body.trim().is_empty())
+                    .then(|| topic.trim().to_string());
+                }
+            }
+        }
+        let args = shlex::split(command)?;
+        // Noncanonical shell syntax may contain operators; retaining it is safer than hiding it.
+        if shlex::try_join(args.iter().map(String::as_str)).as_deref() != Ok(command) {
+            return None;
+        }
+        invocation(&args, depth)
+    }
+    topic(command, 0)
+}
+
+fn sanitize_label(label: &str, limit: usize) -> String {
+    let label: String = label
+        .chars()
+        .take(limit)
+        .map(|ch| if ch.is_control() { ' ' } else { ch })
+        .collect();
+    let label = label.trim();
+    if label.is_empty() {
+        "shell".to_string()
+    } else {
+        label.to_string()
+    }
+}
