+#[tokio::test]
+async fn plus_goal_editor_does_not_submit_when_managed_objective_is_missing() -> Result<()> {
+    let (mut app, mut rx, mut op_rx) = make_test_app_with_channels().await;
+    let mut app_server =
+        crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref()).await?;
+    let started = app_server
+        .start_thread(app.chat_widget.config_ref())
+        .await?;
+    let root = started.session.thread_id;
+    app.enqueue_primary_thread_session(started.session, started.turns)
+        .await?;
+    let path = app
+        .config
+        .codex_home
+        .join("attachments")
+        .join(Uuid::new_v4().to_string())
+        .join("goal-objective.md");
+    let reference = goal_files::objective_file_reference(&AppServerPath::from_app_server(
+        path.to_string_lossy().into_owned(),
+    ))
+    .expect("managed reference");
+    let goal = serde_json::from_value(serde_json::json!({"id":"original-goal","revision":7,"state":"paused","objective":reference})).unwrap();
+    app.show_plus_goal_editor(&mut app_server, root, goal).await;
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    assert!(
+        !std::iter::from_fn(|| rx.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::PlusGoalDraft { .. }))
+    );
+    while let Ok(op) = op_rx.try_recv() {
+        assert!(
+            !matches!(op, Op::UserTurn { .. }),
+            "unexpected model submission: {op:?}"
+        );
+    }
+    assert!(!path.exists());
+    app_server.shutdown().await?;
+    Ok(())
+}
