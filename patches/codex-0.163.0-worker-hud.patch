diff --git a/codex-rs/tui/src/plus_goals.rs b/codex-rs/tui/src/plus_goals.rs
new file mode 100644
index 000000000..557176b27
--- /dev/null
+++ b/codex-rs/tui/src/plus_goals.rs
@@ -0,0 +1,310 @@
+//! Plus state lives in the helper; rendering reads its local projection only.
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use serde_json::Value;
+use std::path::Path;
+
+#[derive(Debug, thiserror::Error)]
+#[error("Plus goal input could not be recorded: {0}")]
+pub(crate) struct InputError(pub String);
+
+#[derive(Clone, Debug, Deserialize)]
+pub(crate) struct Snapshot {
+    pub version: u32,
+    pub root: String,
+    pub goal: Option<Goal>,
+    #[serde(default)]
+    pub history: Vec<Goal>,
+    #[serde(default)]
+    pub instructions: String,
+    pub attention: Option<Value>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub(crate) struct Goal {
+    pub id: String,
+    pub revision: u64,
+    pub state: String,
+    pub objective: String,
+    pub checkpoint: Option<Value>,
+    pub error: Option<String>,
+    #[serde(default)]
+    pub running_jobs: usize,
+}
+
+impl Goal {
+    pub(crate) fn label(&self) -> Option<String> {
+        Some(match self.state.as_str() {
+            "active" => "Goal active".into(),
+            "waiting" => {
+                let jobs = self.running_jobs;
+                if jobs == 0 {
+                    "Goal waiting".into()
+                } else {
+                    format!("Goal waiting · {jobs} jobs")
+                }
+            }
+            "needs_input" => "Goal needs input".into(),
+            "paused" => "Goal paused".into(),
+            "complete" => "Goal complete".into(),
+            "cleared" | "replaced" => return None,
+            _ => "Goal needs input".into(),
+        })
+    }
+}
+
+pub(crate) fn read(home: &Path, root: ThreadId) -> Result<Option<Snapshot>, String> {
+    let path = home.join("codex-plus/goals").join(format!("{root}.json"));
+    let bytes = match crate::app::worker_hud::read_status_bytes_with_limit(&path, 64 * 1024) {
+        Ok(Some(bytes)) => bytes,
+        Ok(None) => return Ok(None),
+        Err(error) => return Err(error.to_string()),
+    };
+    let snapshot: Snapshot = serde_json::from_slice(&bytes).map_err(|e| e.to_string())?;
+    if snapshot.version != 1 || snapshot.root != root.to_string() {
+        return Err("Goal status ownership/version mismatch".into());
+    }
+    Ok(Some(snapshot))
+}
+
+pub(crate) async fn command(
+    home: &Path,
+    root: ThreadId,
+    args: &[String],
+) -> Result<Snapshot, String> {
+    let exe = std::env::current_exe().map_err(|e| e.to_string())?;
+    let helper = exe.with_file_name("codex-plus-runtime");
+    let mut cmd = tokio::process::Command::new(helper);
+    cmd.arg("goal")
+        .args(args)
+        .arg("--thread")
+        .arg(root.to_string())
+        .arg("--json")
+        .env("CODEX_HOME", home)
+        .env_remove("CODEX_THREAD_ID")
+        .stdin(std::process::Stdio::null())
+        .kill_on_drop(true);
+    let result = tokio::time::timeout(std::time::Duration::from_secs(30), cmd.output())
+        .await
+        .map_err(|_| "Goal helper timed out".to_string())?
+        .map_err(|e| format!("Goal helper unavailable: {e}"))?;
+    if !result.status.success() {
+        let json = serde_json::from_slice::<Value>(&result.stdout).ok();
+        return Err(json
+            .as_ref()
+            .and_then(|v| v.get("error"))
+            .and_then(Value::as_str)
+            .map(str::to_string)
+            .unwrap_or_else(|| {
+                let stderr = String::from_utf8_lossy(&result.stderr);
+                if stderr.trim().is_empty() {
+                    format!("Goal helper exited {}", result.status)
+                } else {
+                    stderr.chars().take(2048).collect::<String>().trim().into()
+                }
+            }));
+    }
+    let snapshot: Snapshot = serde_json::from_slice(&result.stdout).map_err(|e| e.to_string())?;
+    if snapshot.root != root.to_string() || snapshot.version != 1 {
+        return Err("Goal helper returned a different session".into());
+    }
+    Ok(snapshot)
+}
+
+pub(crate) fn mutation_args(action: &str, goal: &Goal) -> Vec<String> {
+    vec![
+        action.into(),
+        "--id".into(),
+        goal.id.clone(),
+        "--revision".into(),
+        goal.revision.to_string(),
+    ]
+}
+
+pub(crate) fn indicator(
+    home: &Path,
+    root: ThreadId,
+    snapshot: Snapshot,
+    now: f64,
+    turn_running: bool,
+) -> Option<String> {
+    if snapshot.attention.is_some() {
+        return Some("Goal needs input".into());
+    }
+    let mut goal = snapshot.goal?;
+    if matches!(goal.state.as_str(), "active" | "waiting") {
+        let path = home.join("codex-plus").join(format!("{root}.status.json"));
+        let healthy = crate::app::worker_hud::read_status_bytes(&path)
+            .ok()
+            .flatten()
+            .and_then(|data| serde_json::from_slice::<Value>(&data).ok())
+            .is_some_and(|health| {
+                health["version"] == 1
+                    && health["parent"] == root.to_string()
+                    && health["updated_at"].as_f64().is_some_and(|at| {
+                            at.is_finite() && at >= 0.0 && now.is_finite() && now >= 0.0 && (now - at).abs() <= 15.0
+                    })
+                    && matches!(health["state"].as_str(), Some("waiting" | "idle"))
+            });
+        if !healthy {
+            return Some("Goal needs input".into());
+        }
+        if goal.state == "waiting" && turn_running {
+            goal.state = "active".into();
+        }
+    }
+    goal.label()
+}
+
+pub(crate) const INSTRUCTIONS: &str = "Codex Plus owns /goal. Native goal tools do not control Plus goals. At the start of each turn, inspect `codex-plus goal status --thread $CODEX_THREAD_ID --json` when a Plus goal exists. Follow its instructions for exact goal ID, revision, input epoch and admitted turn. Before ending a goal turn, stage an explicit checkpoint using `codex-plus goal checkpoint`: continue with next action and evidence references, wait on exact registered jobs, request input, or complete with verification evidence. Read the status instructions for the JSON schema and current binding. Ordinary user input has priority; a goal does not expand permissions. Paused, changed, uncertain or stale goal bindings never authorize continuation. Preserve these instructions through compaction.";
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn plus_goal_labels_have_no_clock() {
+        let mut goal = Goal {
+            id: "id".into(),
+            revision: 2,
+            state: "waiting".into(),
+            objective: "x".into(),
+            checkpoint: Some(serde_json::json!({"jobs":["a","b"]})),
+            error: None,
+            running_jobs: 2,
+        };
+        assert_eq!(goal.label().as_deref(), Some("Goal waiting · 2 jobs"));
+        for (state, label) in [
+            ("active", "Goal active"),
+            ("needs_input", "Goal needs input"),
+            ("paused", "Goal paused"),
+            ("complete", "Goal complete"),
+        ] {
+            goal.state = state.into();
+            assert_eq!(goal.label().as_deref(), Some(label));
+        }
+        assert_eq!(
+            mutation_args("pause", &goal),
+            ["pause", "--id", "id", "--revision", "2"]
+        );
+    }
+
+    #[test]
+    fn plus_goal_projection_is_read_only_and_rejects_other_roots_and_malformed_data() {
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        assert!(read(home.path(), root).unwrap().is_none());
+        let dir = home.path().join("codex-plus/goals");
+        assert!(!dir.exists());
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join(format!("{root}.json"));
+        let data = serde_json::json!({"version":1,"root":root,"input_epoch":2,"goal":null});
+        std::fs::write(&path, data.to_string()).unwrap();
+        let before = std::fs::read(&path).unwrap();
+        assert!(read(home.path(), root).unwrap().unwrap().goal.is_none());
+        assert_eq!(std::fs::read(&path).unwrap(), before);
+        std::fs::write(
+            &path,
+            data.to_string()
+                .replace(&root.to_string(), &ThreadId::new().to_string()),
+        )
+        .unwrap();
+        assert!(read(home.path(), root).is_err());
+        std::fs::write(&path, "malformed").unwrap();
+        assert!(read(home.path(), root).is_err());
+        std::fs::write(&path, vec![b' '; 64 * 1024 + 1]).unwrap();
+        assert!(read(home.path(), root).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn plus_goal_projection_rejects_symlinks() {
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        let dir = home.path().join("codex-plus/goals");
+        std::fs::create_dir_all(&dir).unwrap();
+        let target = home.path().join("target");
+        std::fs::write(&target, "{}").unwrap();
+        std::os::unix::fs::symlink(target, dir.join(format!("{root}.json"))).unwrap();
+        assert!(read(home.path(), root).is_err());
+    }
+
+    #[test]
+    fn plus_goal_zero_job_monitor_health_and_active_turn_gate_waiting() {
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        let snapshot: Snapshot = serde_json::from_value(serde_json::json!({"version":1,"root":root,"input_epoch":0,"goal":{"id":"goal","revision":1,"state":"waiting","objective":"x","running_jobs":0}})).unwrap();
+        assert_eq!(
+            indicator(home.path(), root, snapshot.clone(), 100.0, false).as_deref(),
+            Some("Goal needs input")
+        );
+        std::fs::create_dir_all(home.path().join("codex-plus")).unwrap();
+        let path = home
+            .path()
+            .join("codex-plus")
+            .join(format!("{root}.status.json"));
+        std::fs::write(&path, serde_json::json!({"version":1,"parent":root,"state":"waiting","updated_at":100.0,"jobs":0}).to_string()).unwrap();
+        let before = std::fs::read(&path).unwrap();
+        assert_eq!(
+            indicator(home.path(), root, snapshot.clone(), 100.0, false).as_deref(),
+            Some("Goal waiting")
+        );
+        assert_eq!(
+            indicator(home.path(), root, snapshot.clone(), 100.0, true).as_deref(),
+            Some("Goal active")
+        );
+        assert_eq!(
+            indicator(home.path(), root, snapshot.clone(), 116.0, false).as_deref(),
+            Some("Goal needs input")
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), before);
+        let mut paused = snapshot;
+        paused.goal.as_mut().unwrap().state = "paused".into();
+        assert_eq!(
+            indicator(home.path(), root, paused, 1000.0, false).as_deref(),
+            Some("Goal paused")
+        );
+    }
+}
+
+pub(crate) async fn attest(home: &Path, root: &str, cwd: &Path, kind: &str) {
+    let Ok(root) = ThreadId::from_string(root) else {
+        return;
+    };
+    let args = vec![
+        "provenance".into(),
+        "--cwd".into(),
+        cwd.to_string_lossy().into_owned(),
+        "--load-kind".into(),
+        kind.into(),
+    ];
+    if let Err(error) = command(home, root, &args).await {
+        tracing::debug!(%error, "Plus goal runtime isolation not established");
+    }
+}
+
+pub(crate) fn validate_config(
+    config: &crate::legacy_core::config::Config,
+) -> color_eyre::Result<()> {
+    use codex_config::ConfigLayerSource;
+    for layer in config.config_layer_stack.layers_low_to_high() {
+        if matches!(
+            &layer.name,
+            ConfigLayerSource::SessionFlags
+                | ConfigLayerSource::User {
+                    profile: Some(_),
+                    ..
+                }
+        ) && layer
+            .config
+            .get("features")
+            .and_then(|v| v.get("goals"))
+            .and_then(toml::Value::as_bool)
+            == Some(true)
+        {
+            return Err(color_eyre::eyre::eyre!(
+                "Codex Plus owns /goal; features.goals=true conflicts with Plus goals. Remove the conflicting launch/profile override."
+            ));
+        }
+    }
+    Ok(())
+}
diff --git a/codex-rs/tui/src/plus_ultracode.rs b/codex-rs/tui/src/plus_ultracode.rs
new file mode 100644
index 000000000..375ffdc02
--- /dev/null
+++ b/codex-rs/tui/src/plus_ultracode.rs
@@ -0,0 +1,455 @@
+//! Mode state belongs to the helper; footer refresh only reads its projection.
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use serde_json::Value;
+use std::path::Path;
+
+pub(crate) const INSTRUCTIONS: &str = include_str!("plus_ultracode_instructions.txt");
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Action {
+    On,
+    Off,
+    Status,
+}
+
+impl Action {
+    pub(crate) fn parse(text: &str) -> Option<Self> {
+        Some(match text.trim() {
+            "on" => Self::On,
+            "off" => Self::Off,
+            "status" | "" => Self::Status,
+            _ => return None,
+        })
+    }
+
+    pub(crate) fn as_str(self) -> &'static str {
+        match self {
+            Self::On => "on",
+            Self::Off => "off",
+            Self::Status => "status",
+        }
+    }
+}
+
+#[derive(Debug, Deserialize)]
+pub(crate) struct Snapshot {
+    version: u32,
+    root: String,
+    requested: Requested,
+    effective: Option<Effective>,
+    availability: Availability,
+    pending: Vec<Value>,
+    unavailable_reason: Option<String>,
+    #[serde(default)]
+    journal_directory: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct Requested {
+    enabled: bool,
+    revision: u64,
+    policy_version: u32,
+}
+
+#[derive(Debug, Deserialize)]
+struct Effective {
+    enabled: bool,
+    revision: u64,
+    policy_version: u32,
+    submission: String,
+    turn: String,
+    generation: String,
+}
+
+#[derive(Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+enum Availability {
+    Available,
+    Unavailable,
+}
+
+impl Snapshot {
+    fn validate(&self, root: ThreadId) -> Result<(), String> {
+        if self.version != 1 || self.root != root.to_string() {
+            return Err("Ultracode status ownership/version mismatch".into());
+        }
+        if self.effective.as_ref().is_some_and(|effective| {
+            effective.submission.is_empty()
+                || effective.turn.is_empty()
+                || effective.generation.is_empty()
+                || effective.policy_version != 1
+        }) || self.requested.policy_version != 1
+        {
+            return Err("Ultracode status has no qualified turn identity or policy".into());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn footer_label(&self) -> Option<&'static str> {
+        self.requested.enabled.then_some("ultracode")
+    }
+
+    pub(crate) fn label(&self) -> Option<String> {
+        if !self.requested.enabled
+            && self.pending.is_empty()
+            && !self
+                .effective
+                .as_ref()
+                .is_some_and(|effective| effective.enabled)
+        {
+            return None;
+        }
+        if self.availability == Availability::Unavailable {
+            return Some("Ultracode unavailable".into());
+        }
+        let pending = !self.pending.is_empty()
+            || self
+                .effective
+                .as_ref()
+                .map_or(self.requested.enabled, |effective| {
+                    effective.revision != self.requested.revision
+                        || effective.enabled != self.requested.enabled
+                });
+        if pending {
+            return Some(format!(
+                "Ultracode {} pending",
+                if self.requested.enabled { "on" } else { "off" }
+            ));
+        }
+        self.effective
+            .as_ref()
+            .is_some_and(|effective| effective.enabled)
+            .then(|| "Ultracode".into())
+    }
+
+    pub(crate) fn summary(&self) -> String {
+        let requested = if self.requested.enabled { "on" } else { "off" };
+        let mut text = format!(
+            "{}\nRequested: {requested}, revision {}.",
+            self.label().unwrap_or_else(|| "Ultracode off".into()),
+            self.requested.revision,
+        );
+        if let Some(effective) = &self.effective {
+            text.push_str(&format!(
+                "\nAdmitted turn: {} at revision {} (turn {}).",
+                if effective.enabled { "on" } else { "off" },
+                effective.revision,
+                effective.turn,
+            ));
+        } else {
+            text.push_str("\nNo admitted effective turn.");
+        }
+        if self.availability == Availability::Unavailable {
+            if let Some(reason) = &self.unavailable_reason {
+                text.push_str(&format!("\nUnavailable: {reason}"));
+            } else {
+                text.push_str(
+                    "\nThis session has no qualified startup bootstrap. Start a new Plus root session.",
+                );
+            }
+        }
+        if let Some(directory) = &self.journal_directory {
+            text.push_str(&format!("\nPhase artifacts: {directory}"));
+        }
+        text
+    }
+}
+
+pub(crate) fn read(home: &Path, root: ThreadId) -> Result<Option<Snapshot>, String> {
+    let path = home
+        .join("codex-plus/ultracode")
+        .join(format!("{root}.json"));
+    let bytes = match crate::app::worker_hud::read_status_bytes_with_limit(&path, 64 * 1024) {
+        Ok(Some(bytes)) => bytes,
+        Ok(None) => return Ok(None),
+        Err(error) => return Err(error.to_string()),
+    };
+    let snapshot: Snapshot = serde_json::from_slice(&bytes).map_err(|error| error.to_string())?;
+    snapshot.validate(root)?;
+    Ok(Some(snapshot))
+}
+
+pub(crate) fn check_cold_load_fallback(home: &Path, root: ThreadId) -> Result<(), String> {
+    if matches!(read(home, root), Ok(None)) {
+        return Ok(());
+    }
+    Err("Cannot safely resume this session: its saved Ultracode startup instructions could not be read. Check the local Codex Plus helper and retry this resume so the original developer instructions can be restored.".into())
+}
+
+pub(crate) async fn command(
+    home: &Path,
+    root: ThreadId,
+    args: &[&str],
+) -> Result<Snapshot, String> {
+    let bytes = helper_output(home, root, args, None).await?;
+    let snapshot: Snapshot = serde_json::from_slice(&bytes).map_err(|error| error.to_string())?;
+    snapshot.validate(root)?;
+    Ok(snapshot)
+}
+
+async fn helper_output(
+    home: &Path,
+    root: ThreadId,
+    args: &[&str],
+    instructions: Option<&str>,
+) -> Result<Vec<u8>, String> {
+    use tokio::io::AsyncWriteExt;
+
+    let helper = std::env::current_exe()
+        .map_err(|error| error.to_string())?
+        .with_file_name("codex-plus-runtime");
+    let mut command = tokio::process::Command::new(helper);
+    command
+        .arg("ultracode")
+        .args(args)
+        .arg("--thread")
+        .arg(root.to_string())
+        .arg("--json")
+        .env("CODEX_HOME", home)
+        .env_remove("CODEX_THREAD_ID")
+        .stdin(if instructions.is_some() {
+            std::process::Stdio::piped()
+        } else {
+            std::process::Stdio::null()
+        })
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .kill_on_drop(true);
+    let result = tokio::time::timeout(std::time::Duration::from_secs(30), async {
+        let mut child = command.spawn()?;
+        if let Some(instructions) = instructions {
+            let mut stdin = child
+                .stdin
+                .take()
+                .expect("piped Ultracode provenance input");
+            stdin.write_all(instructions.as_bytes()).await?;
+        }
+        child.wait_with_output().await
+    })
+    .await
+    .map_err(|_| "Ultracode helper timed out".to_string())?
+    .map_err(|error| format!("Ultracode helper unavailable: {error}"))?;
+    if !result.status.success() {
+        let json = serde_json::from_slice::<Value>(&result.stdout).ok();
+        return Err(json
+            .as_ref()
+            .and_then(|value| value.get("error"))
+            .and_then(Value::as_str)
+            .map(str::to_owned)
+            .unwrap_or_else(|| {
+                format!(
+                    "Ultracode helper exited {}: {}",
+                    result.status,
+                    String::from_utf8_lossy(&result.stderr)
+                        .chars()
+                        .take(2048)
+                        .collect::<String>()
+                        .trim(),
+                )
+            }));
+    }
+    Ok(result.stdout)
+}
+
+pub(crate) async fn load_instructions(
+    home: &Path,
+    root: ThreadId,
+) -> Result<Option<String>, String> {
+    #[derive(Deserialize)]
+    struct Saved {
+        root: String,
+        developer_instructions: Option<String>,
+    }
+    let bytes = helper_output(home, root, &["load-instructions"], None).await?;
+    let saved: Saved = serde_json::from_slice(&bytes)
+        .map_err(|_| "Ultracode saved startup instructions unavailable".to_string())?;
+    if saved.root != root.to_string()
+        || saved
+            .developer_instructions
+            .as_ref()
+            .is_some_and(|text| text.len() > 1024 * 1024 || !text.contains(INSTRUCTIONS))
+    {
+        return Err("Ultracode saved startup instruction ownership/policy mismatch".into());
+    }
+    Ok(saved.developer_instructions)
+}
+
+pub(crate) async fn attest(home: &Path, root: &str, kind: &str, instructions: Option<&str>) {
+    let Ok(root) = ThreadId::from_string(root) else {
+        return;
+    };
+    let Some(instructions) =
+        instructions.filter(|text| text.len() <= 1024 * 1024 && text.contains(INSTRUCTIONS))
+    else {
+        return;
+    };
+    if let Err(error) = helper_output(
+        home,
+        root,
+        &[
+            "provenance",
+            "--load-kind",
+            kind,
+            "--developer-instructions-stdin",
+        ],
+        Some(instructions),
+    )
+    .await
+    {
+        tracing::debug!(%error, "Ultracode startup bootstrap not qualified");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn snapshot(root: ThreadId) -> Value {
+        serde_json::json!({
+            "version": 1, "root": root,
+            "requested": {"enabled": false, "revision": 0, "policy_version": 1},
+            "effective": null, "availability": "available", "pending": [],
+        })
+    }
+
+    #[test]
+    fn ultracode_actions_do_not_parse_effort_or_extra_arguments() {
+        for (text, action) in [
+            ("on", Action::On),
+            ("off", Action::Off),
+            ("status", Action::Status),
+        ] {
+            assert_eq!(Action::parse(text), Some(action));
+            assert_eq!(action.as_str(), text);
+        }
+        for text in ["ultra", "high", "on extra", "enable"] {
+            assert_eq!(Action::parse(text), None);
+        }
+    }
+
+    #[test]
+    fn ultracode_footer_label_uses_only_the_saved_requested_setting() {
+        for enabled in [false, true] {
+            for availability in ["available", "unavailable"] {
+                for pending in [
+                    serde_json::json!([]),
+                    serde_json::json!([{"state":"pending"}]),
+                ] {
+                    for effective_enabled in [None, Some(false), Some(true)] {
+                        let mut value = snapshot(ThreadId::new());
+                        value["requested"]["enabled"] = enabled.into();
+                        value["requested"]["revision"] = 2.into();
+                        value["availability"] = availability.into();
+                        value["pending"] = pending.clone();
+                        value["effective"] = effective_enabled.map_or(Value::Null, |enabled| {
+                            serde_json::json!({"enabled":enabled,"revision":1,"policy_version":1,"submission":"s","turn":"t","generation":"g"})
+                        });
+                        let snapshot: Snapshot = serde_json::from_value(value).unwrap();
+                        assert_eq!(snapshot.footer_label(), enabled.then_some("ultracode"));
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn ultracode_labels_require_available_matching_effective_revision() {
+        let mut value = snapshot(ThreadId::new());
+        let label = |value: &Value| {
+            serde_json::from_value::<Snapshot>(value.clone())
+                .unwrap()
+                .label()
+        };
+        assert_eq!(label(&value), None);
+        value["requested"]["enabled"] = true.into();
+        value["requested"]["revision"] = 1.into();
+        assert_eq!(label(&value).as_deref(), Some("Ultracode on pending"));
+        value["effective"] = serde_json::json!({"enabled":true,"revision":1,"policy_version":1,"submission":"s","turn":"t","generation":"g"});
+        assert_eq!(label(&value).as_deref(), Some("Ultracode"));
+        value["requested"]["enabled"] = false.into();
+        value["requested"]["revision"] = 2.into();
+        assert_eq!(label(&value).as_deref(), Some("Ultracode off pending"));
+        value["availability"] = "unavailable".into();
+        assert_eq!(label(&value).as_deref(), Some("Ultracode unavailable"));
+        let summary = serde_json::from_value::<Snapshot>(value).unwrap().summary();
+        assert!(summary.contains("Admitted turn: on at revision 1"));
+        assert!(summary.contains("Start a new Plus root session"));
+    }
+
+    #[test]
+    fn ultracode_off_hides_an_unqualified_idle_root_but_status_explains_it() {
+        let mut value = snapshot(ThreadId::new());
+        value["availability"] = "unavailable".into();
+        value["unavailable_reason"] = "No qualified startup bootstrap".into();
+        let snapshot: Snapshot = serde_json::from_value(value.clone()).unwrap();
+        assert_eq!(snapshot.label(), None);
+        assert!(
+            snapshot
+                .summary()
+                .contains("No qualified startup bootstrap")
+        );
+        value["requested"]["enabled"] = true.into();
+        let snapshot: Snapshot = serde_json::from_value(value).unwrap();
+        assert_eq!(snapshot.label().as_deref(), Some("Ultracode unavailable"));
+    }
+
+    #[test]
+    fn ultracode_projection_is_read_only_and_rejects_untrusted_data() {
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        assert!(read(home.path(), root).unwrap().is_none());
+        let directory = home.path().join("codex-plus/ultracode");
+        assert!(!directory.exists());
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = directory.join(format!("{root}.json"));
+        let mut value = snapshot(root);
+        std::fs::write(&path, value.to_string()).unwrap();
+        let before = std::fs::read(&path).unwrap();
+        assert!(read(home.path(), root).unwrap().unwrap().label().is_none());
+        assert_eq!(std::fs::read(&path).unwrap(), before);
+        value["root"] = ThreadId::new().to_string().into();
+        std::fs::write(&path, value.to_string()).unwrap();
+        assert!(read(home.path(), root).is_err());
+        for bytes in [b"malformed".to_vec(), vec![b' '; 64 * 1024 + 1]] {
+            std::fs::write(&path, bytes).unwrap();
+            assert!(read(home.path(), root).is_err());
+        }
+    }
+
+    #[test]
+    fn ultracode_cold_load_fallback_requires_absence_of_root_mode_state() {
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        assert!(check_cold_load_fallback(home.path(), root).is_ok());
+        let directory = home.path().join("codex-plus/ultracode");
+        std::fs::create_dir_all(&directory).unwrap();
+        let other_root = ThreadId::new();
+        std::fs::write(
+            directory.join(format!("{other_root}.json")),
+            snapshot(other_root).to_string(),
+        )
+        .unwrap();
+        assert!(check_cold_load_fallback(home.path(), root).is_ok());
+        let path = directory.join(format!("{root}.json"));
+        std::fs::write(&path, snapshot(root).to_string()).unwrap();
+        let error = check_cold_load_fallback(home.path(), root).unwrap_err();
+        assert!(error.contains("Cannot safely resume this session"));
+        assert!(error.contains("retry this resume"));
+        std::fs::write(path, "malformed").unwrap();
+        assert!(check_cold_load_fallback(home.path(), root).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn ultracode_projection_rejects_symlinks() {
+        let home = tempfile::tempdir().unwrap();
+        let root = ThreadId::new();
+        let directory = home.path().join("codex-plus/ultracode");
+        std::fs::create_dir_all(&directory).unwrap();
+        let target = home.path().join("target");
+        std::fs::write(&target, snapshot(root).to_string()).unwrap();
+        std::os::unix::fs::symlink(target, directory.join(format!("{root}.json"))).unwrap();
+        assert!(read(home.path(), root).is_err());
+    }
+}
