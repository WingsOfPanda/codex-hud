 use super::*;
 
+fn parallel_mcp_item(id: &str, failed: bool) -> AppServerThreadItem {
+    serde_json::from_value(json!({
+        "type": "mcpToolCall", "id": id, "server": "test", "tool": id,
+        "status": if failed { "failed" } else { "completed" }, "arguments": {},
+        "result": {"content": [{"type": "text", "text": format!("result-{id}")}]},
+        "durationMs": 5
+    }))
+    .unwrap()
+}
+
+fn start_parallel_mcp(chat: &mut ChatWidget, id: &str) {
+    let mut item = parallel_mcp_item(id, false);
+    if let AppServerThreadItem::McpToolCall { status, result, .. } = &mut item {
+        *status = codex_app_server_protocol::McpToolCallStatus::InProgress;
+        *result = None;
+    }
+    chat.on_mcp_tool_call_started(item);
+}
