+fn weekly_reset_display(
+    snapshot: Option<&RateLimitSnapshotDisplay>,
+    now: chrono::DateTime<chrono::Utc>,
+) -> String {
+    let reset = snapshot
+        .and_then(weekly_status_window)
+        .filter(|(window, _)| matches_window_label(window, "weekly"))
+        .and_then(|(window, _)| window.reset_timestamp)
+        .and_then(|seconds| chrono::DateTime::from_timestamp(seconds, 0));
+    let Some(reset) = reset else {
+        return "reset unknown".into();
+    };
+    if reset <= now {
+        return "reset due".into();
+    }
+    let millis = (reset - now).num_milliseconds();
+    if millis < 60_000 {
+        return "resets in <1m".into();
+    }
+    let minutes = (millis + 59_999) / 60_000;
+    if minutes >= 24 * 60 {
+        format!("resets in {}d {}h", minutes / (24 * 60), minutes / 60 % 24)
+    } else if minutes >= 60 {
+        format!("resets in {}h {}m", minutes / 60, minutes % 60)
+    } else {
+        format!("resets in {minutes}m")
+    }
+}
+
+#[cfg(test)]
+mod weekly_reset_tests {
+    use super::*;
+
+    #[test]
+    fn weekly_reset_countdown_rounds_remaining_minutes_and_marks_expiry() {
+        let now = chrono::DateTime::from_timestamp(1_800_000_000, 0).unwrap();
+        let mut snapshot = RateLimitSnapshotDisplay {
+            limit_name: "codex".into(),
+            normal_model_slug: None,
+            captured_at: now.with_timezone(&chrono::Local),
+            primary: None,
+            secondary: Some(RateLimitWindowDisplay {
+                used_percent: 50.0,
+                resets_at: Some("unrelated formatted clock time".into()),
+                reset_timestamp: None,
+                window_minutes: Some(7 * 24 * 60),
+            }),
+            credits: None,
+            individual_limit: None,
+        };
+        assert_eq!(weekly_reset_display(None, now), "reset unknown");
+        assert_eq!(weekly_reset_display(Some(&snapshot), now), "reset unknown");
+        for (seconds, expected) in [
+            (-1, "reset due"),
+            (0, "reset due"),
+            (1, "resets in <1m"),
+            (59, "resets in <1m"),
+            (60, "resets in 1m"),
+            (61, "resets in 2m"),
+            (3599, "resets in 1h 0m"),
+            (3600, "resets in 1h 0m"),
+            (3601, "resets in 1h 1m"),
+            (86399, "resets in 1d 0h"),
+            (86400, "resets in 1d 0h"),
+            (2 * 86400 + 5 * 3600, "resets in 2d 5h"),
+        ] {
+            snapshot.secondary.as_mut().unwrap().reset_timestamp = Some(now.timestamp() + seconds);
+            assert_eq!(weekly_reset_display(Some(&snapshot), now), expected);
+        }
+        snapshot.secondary.as_mut().unwrap().reset_timestamp = Some(i64::MAX);
+        assert_eq!(weekly_reset_display(Some(&snapshot), now), "reset unknown");
+    }
+}
