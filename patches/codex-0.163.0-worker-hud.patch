+#[tokio::test]
+async fn worker_hud_footer_selection_and_config_panel_preserve_the_draft() -> Result<()> {
+    use crate::bottom_pane::worker_hud::{ShellRow, WatcherHealth};
+
+    let mut app = crate::app::test_support::make_test_app().await;
+    app.local_settings.tui.copy_on_select = CopyOnSelect::Never;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(true)?;
+    let size = tui.terminal.size()?;
+    app.chat_widget
+        .apply_external_edit("draft stays here".into());
+    app.chat_widget.set_shell_hud(
+        (0..8)
+            .map(|n| ShellRow {
+                command: format!("hud-job-{n}"),
+                job_id: n.to_string(),
+                seen_secs: Some(3),
+            })
+            .collect(),
+        false,
+        true,
+    );
+    app.chat_widget
+        .set_watcher_health(Some(WatcherHealth::Uncertain(1)));
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(history_cell::new_warning_event("Example warning".into())),
+    );
+    app.render_owned_transcript(&mut tui, size)?;
+    let draft = app.chat_widget.capture_thread_input_state();
+    let buffer = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal);
+    let text = buffer_text(buffer);
+    let lines: Vec<_> = text
+        .lines()
+        .filter(|line| !line.trim().is_empty())
+        .collect();
+    let cursor = tui.terminal.last_known_cursor_pos;
+    assert_eq!(
+        text.lines().nth(usize::from(cursor.y)).map(str::trim),
+        Some("› draft stays here"),
+        "{text}"
+    );
+    assert!(
+        text.lines()
+            .skip(usize::from(cursor.y) + 1)
+            .filter(|line| !line.trim().is_empty())
+            .count()
+            <= 9,
+        "{text}"
+    );
+    assert_eq!(
+        lines
+            .iter()
+            .filter(|line| line.contains("Background ·")
+                || line.contains("Wake delivery uncertain")
+                || line.contains("+4 more"))
+            .count(),
+        6,
+        "{text}"
+    );
+    assert_eq!(
+        lines
+            .iter()
+            .filter(|line| line.contains("Background ·"))
+            .count(),
+        4
+    );
+    assert!(lines.iter().any(|line| line.trim() == "+4 more"), "{text}");
+    let badge = buffer
+        .area
+        .positions()
+        .find(|position| buffer[*position].symbol() == "⚠")
+        .unwrap();
+    for event in [
+        mouse(Down(Left), badge.x, badge.y),
+        mouse(Drag(Left), badge.x + 11, badge.y),
+        mouse(Up(Left), badge.x + 11, badge.y),
+    ] {
+        assert!(app.handle_rendered_selection_event(&mut tui, &event)?);
+    }
+    {
+        let mut selection = app.chat_widget.rendered_selection.borrow_mut();
+        let crate::rendered_selection::RenderedSelection { view, cells, .. } = &mut *selection;
+        let selected = view.selected_text(cells).unwrap();
+        assert!(selected.contains("warning"), "{selected}");
+        assert!(!selected.contains("hud-job"), "{selected}");
+    }
+    assert!(app.handle_rendered_selection_event(&mut tui, &TuiEvent::Key(KeyCode::Esc.into()))?);
+    app.chat_widget.open_config_panel();
+    app.chat_widget
+        .set_watcher_health(Some(WatcherHealth::Report(1)));
+    app.render_owned_transcript(&mut tui, size)?;
+    app.chat_widget.handle_key_event(KeyCode::Esc.into());
+    assert!(app.chat_widget.no_modal_or_popup_active());
+    app.render_owned_transcript(&mut tui, size)?;
+    assert_eq!(app.chat_widget.capture_thread_input_state(), draft);
+    let text = buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(
+        text.contains("Restart report ready") && text.contains("hud-job"),
+        "{text}"
+    );
+    tui.set_owned_screen(false)?;
+    Ok(())
+}
