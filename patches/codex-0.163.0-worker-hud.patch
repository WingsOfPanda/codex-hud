+#[test]
+fn shell_policy_exact_marker_and_nested_wrappers() {
+    for (marker, policy) in [
+        ("auto", ShellVisibility::Auto),
+        ("background", ShellVisibility::Background),
+        ("foreground", ShellVisibility::Foreground),
+    ] {
+        let body = format!("# codex-plus-shell: {marker}\necho ok");
+        assert_eq!(shell_directive(&body), Some((policy, "echo ok".into())));
+        let inner = shlex::try_join(["bash", "-lc", &body]).unwrap();
+        let outer = shlex::try_join(["/bin/zsh", "-lc", &inner]).unwrap();
+        assert_eq!(shell_directive(&outer), Some((policy, "echo ok".into())));
+    }
+    for text in [
+        "echo '# codex-plus-shell: auto'",
+        "echo ok\n# codex-plus-shell: background",
+        " # codex-plus-shell: auto\necho ok",
+        "# codex-plus-shell: auto extra\necho ok",
+        "# codex-plus-shell: automatic\necho ok",
+    ] {
+        assert!(shell_directive(text).is_none(), "{text}");
+    }
+    assert!(!eligible_shell(ExecCommandSource::UserShell));
+    assert!(!eligible_shell(ExecCommandSource::UnifiedExecInteraction));
+}
