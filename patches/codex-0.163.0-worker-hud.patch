+fn effort_label(effort: Option<&ReasoningEffort>) -> String {
+    effort
+        .map(ReasoningEffort::as_str)
+        .unwrap_or("?")
+        .chars()
+        .map(|ch| if ch.is_control() { ' ' } else { ch })
