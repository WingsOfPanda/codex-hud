+//! Shared rows keep overlapping MCP and web completions attached to their original call.
+
+use super::*;
+use std::sync::Arc;
+use std::sync::RwLock;
+
+#[derive(Clone, Debug)]
+pub(crate) struct RetainedToolCallCell {
+    data: Arc<RwLock<RetainedToolCallData>>,
+}
+
+#[derive(Debug)]
+struct RetainedToolCallData {
+    cell: Box<dyn HistoryCell>,
+    active: bool,
+    native_rendered: bool,
+}
+
+impl RetainedToolCallCell {
+    pub(crate) fn new(cell: impl HistoryCell + 'static) -> Self {
+        Self {
+            data: Arc::new(RwLock::new(RetainedToolCallData {
+                cell: Box::new(cell),
+                active: true,
+                native_rendered: false,
+            })),
+        }
+    }
+
+    pub(crate) fn is_active(&self) -> bool {
+        self.data
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .active
+    }
+
+    /// Return whether native scrollback already needs a correction for this row.
+    pub(crate) fn finish(&self, update: impl FnOnce(&mut dyn HistoryCell)) -> bool {
+        let mut data = self
+            .data
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let native_rendered = data.native_rendered;
+        update(data.cell.as_mut());
+        data.active = false;
+        data.native_rendered = false;
+        native_rendered
+    }
+
+    pub(crate) fn mark_interrupted(&self) {
+        if !self.is_active() {
+            return;
+        }
+        self.finish(|cell| {
+            if let Some(cell) = cell.as_any_mut().downcast_mut::<McpToolCallCell>() {
+                cell.mark_failed();
+            } else if let Some(cell) = cell.as_any_mut().downcast_mut::<WebSearchCell>() {
+                cell.mark_interrupted();
+            }
+        });
+    }
+
+    pub(crate) fn mark_native_rendered(&self) {
+        self.data
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .native_rendered = true;
+    }
+
+    pub(crate) fn shares_state_with(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.data, &other.data)
+    }
+
+    pub(crate) fn freeze_snapshot(&self) {
+        let mut data = self
+            .data
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(cell) = data.cell.as_any_mut().downcast_mut::<McpToolCallCell>() {
+            cell.freeze_snapshot();
+        } else if let Some(cell) = data.cell.as_any_mut().downcast_mut::<WebSearchCell>() {
+            cell.freeze_snapshot();
+        }
+    }
+
+    fn with_cell<T>(&self, f: impl FnOnce(&dyn HistoryCell) -> T) -> T {
+        let data = self
+            .data
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        f(data.cell.as_ref())
+    }
+}
+
+impl HistoryCell for RetainedToolCallCell {
+    fn has_stable_transcript_height(&self) -> bool {
+        false
+    }
+
+    fn activity_ids(&self) -> Vec<String> {
+        self.with_cell(|cell| cell.activity_ids())
+    }
+
+    fn display_lines(&self, width: u16) -> Vec<Line<'static>> {
+        self.with_cell(|cell| cell.display_lines(width))
+    }
+
+    fn compact_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.with_cell(|cell| cell.compact_hyperlink_lines(width))
+    }
+
+    fn retained_hyperlink_lines(&self, width: u16, detailed: bool) -> Vec<HyperlinkLine> {
+        self.with_cell(|cell| cell.retained_hyperlink_lines(width, detailed))
+    }
+
+    fn expanded_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.with_cell(|cell| cell.expanded_hyperlink_lines(width))
+    }
+
+    fn activity_disclosure(&self, width: u16) -> Option<ActivityDisclosure> {
+        self.with_cell(|cell| cell.activity_disclosure(width))
+    }
+
+    fn display_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.with_cell(|cell| cell.display_hyperlink_lines(width))
+    }
+
+    fn transcript_lines(&self, width: u16) -> Vec<Line<'static>> {
+        self.with_cell(|cell| cell.transcript_lines(width))
+    }
+
+    fn transcript_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.with_cell(|cell| cell.transcript_hyperlink_lines(width))
+    }
+
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        self.with_cell(|cell| cell.raw_lines())
+    }
+
+    fn live_raw_lines(&self) -> Vec<Line<'static>> {
+        self.with_cell(|cell| cell.live_raw_lines())
+    }
+
+    fn transcript_animation_tick(&self) -> Option<u64> {
+        self.with_cell(|cell| cell.transcript_animation_tick())
+    }
+}
