+//! Per-client worker metadata refresh. These requests never start or steer a turn.
+
+use super::*;
+use crate::app_server_session::source_agent_path;
+use crate::bottom_pane::worker_hud::ShellRow;
+use crate::bottom_pane::worker_hud::WatcherHealth;
+use crate::bottom_pane::worker_hud::WorkerGroup;
+use crate::bottom_pane::worker_hud::WorkerRow;
+use crate::bottom_pane::worker_hud::WorkerState;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::SortDirection;
+use codex_app_server_protocol::Thread;
+use codex_app_server_protocol::ThreadActiveFlag;
+use codex_app_server_protocol::ThreadBackgroundTerminal;
+use codex_app_server_protocol::ThreadBackgroundTerminalsListParams;
+use codex_app_server_protocol::ThreadBackgroundTerminalsListResponse;
+use codex_app_server_protocol::ThreadListParams;
+use codex_app_server_protocol::ThreadListResponse;
+use codex_app_server_protocol::ThreadSourceKind;
+use codex_app_server_protocol::ThreadStatus;
+use codex_app_server_protocol::ThreadTurnsListParams;
+use codex_app_server_protocol::ThreadTurnsListResponse;
+use codex_app_server_protocol::Turn;
+use codex_app_server_protocol::TurnItemsView;
+use futures::StreamExt;
+use futures::TryStreamExt;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+const REFRESH_INTERVAL: Duration = Duration::from_secs(1);
+const FETCH_TIMEOUT: Duration = Duration::from_secs(4);
+const WATCHER_TIMEOUT: Duration = Duration::from_millis(250);
+const WATCHER_MAX_BYTES: u64 = 16 * 1024;
+const WATCHER_STALE_SECS: f64 = 15.0;
+const TURN_USAGE_MAX_BYTES: u64 = 1024 * 1024;
+const TURN_USAGE_MAX_RECORDS: usize = 4096;
+
+#[derive(Default)]
+pub(super) struct WorkerHudState {
+    root: Option<ThreadId>,
+    pending: Option<Uuid>,
+    fetched_at: Option<Instant>,
+    attempted_at: Option<Instant>,
+    rows: Vec<WorkerRow>,
+    stale: bool,
+    shells: ShellHudState,
+    watcher_pending: Option<Uuid>,
+    watcher_attempted_at: Option<Instant>,
+    watcher: Option<WatcherHealth>,
+    advisor: Option<crate::bottom_pane::worker_hud::AdvisorRow>,
+    pub(super) goal: Option<(String, String)>,
+    pub(super) dismissed_complete: Option<String>,
+}
+
+#[derive(Default)]
+struct ShellHudState {
+    pending: Option<Uuid>,
+    fetched_at: Option<Instant>,
+    attempted_at: Option<Instant>,
+    terminals: Vec<ThreadBackgroundTerminal>,
+    first_seen: HashMap<(String, String), Instant>,
+    stale: bool,
+}
+
+impl ShellHudState {
+    fn rows(&self) -> Vec<ShellRow> {
+        self.terminals
+            .iter()
+            .map(|terminal| ShellRow {
+                command: terminal.command.clone(),
+                job_id: terminal.process_id.clone(),
+                seen_secs: self
+                    .first_seen
+                    .get(&(terminal.item_id.clone(), terminal.process_id.clone()))
+                    .map(|at| at.elapsed().as_secs()),
+            })
+            .collect()
+    }
+
+    fn finish(
+        &mut self,
+        request_id: Uuid,
+        result: Result<Vec<ThreadBackgroundTerminal>, String>,
+        now: Instant,
+    ) -> bool {
+        if self.pending != Some(request_id) {
+            return false;
+        }
+        self.pending = None;
+        match result {
+            Ok(terminals) => {
+                let mut first_seen = HashMap::new();
+                for terminal in &terminals {
+                    let key = (terminal.item_id.clone(), terminal.process_id.clone());
+                    first_seen.insert(
+                        key.clone(),
+                        self.first_seen.get(&key).copied().unwrap_or(now),
+                    );
+                }
+                self.first_seen = first_seen;
+                self.terminals = terminals;
+                self.fetched_at = Some(now);
+                self.stale = false;
+            }
+            Err(err) => {
+                tracing::debug!(%err, "shell HUD metadata unavailable");
+                self.stale = true;
+            }
+        }
+        true
+    }
+}
+
+async fn fetch_shells<F, Fut>(
+    root: ThreadId,
+    mut request: F,
+) -> Result<Vec<ThreadBackgroundTerminal>, String>
+where
+    F: FnMut(ThreadBackgroundTerminalsListParams) -> Fut,
+    Fut: std::future::Future<Output = Result<ThreadBackgroundTerminalsListResponse, String>>,
+{
+    let mut terminals = Vec::new();
+    let mut cursor = None;
+    let mut seen_cursors = HashSet::new();
+    loop {
+        if !seen_cursors.insert(cursor.clone()) || terminals.len() >= 1_000 {
+            return Err("shell list incomplete".to_string());
+        }
+        let page = request(ThreadBackgroundTerminalsListParams {
+            thread_id: root.to_string(),
+            cursor,
+            limit: Some(100),
+        })
+        .await?;
+        if terminals.len() + page.data.len() > 1_000 {
+            return Err("shell list incomplete".to_string());
+        }
+        terminals.extend(page.data);
+        match page.next_cursor {
+            Some(next) => cursor = Some(next),
+            None => return Ok(terminals),
+        }
+    }
+}
+
+impl WorkerHudState {
+    fn bind(&mut self, root: Option<ThreadId>) {
+        if self.root != root {
+            *self = Self {
+                root,
+                ..Self::default()
+            };
+        }
+    }
+
+    fn finish(
+        &mut self,
+        root: ThreadId,
+        request_id: Uuid,
+        result: Result<Vec<WorkerRow>, String>,
+    ) -> bool {
+        if self.root != Some(root) || self.pending != Some(request_id) {
+            return false;
+        }
+        self.pending = None;
+        match result {
+            Ok(rows) => {
+                self.rows = rows;
+                self.fetched_at = Some(Instant::now());
+                self.stale = false;
+            }
+            Err(err) => {
+                tracing::debug!(%err, "worker HUD metadata unavailable");
+                self.stale = true;
+            }
+        }
+        true
+    }
+
+    fn finish_shells(
+        &mut self,
+        root: ThreadId,
+        request_id: Uuid,
+        result: Result<Vec<ThreadBackgroundTerminal>, String>,
+        now: Instant,
+    ) -> bool {
+        self.root == Some(root) && self.shells.finish(request_id, result, now)
+    }
+
+    fn finish_watcher(
+        &mut self,
+        root: ThreadId,
+        request_id: Uuid,
+        health: Option<WatcherHealth>,
+    ) -> bool {
+        if self.root != Some(root) || self.watcher_pending != Some(request_id) {
+            return false;
+        }
+        self.watcher_pending = None;
+        self.watcher = health;
+        true
+    }
+}
+
+impl App {
+    pub(super) fn invalidate_worker_hud(&mut self) {
+        self.worker_hud.pending = None;
+        self.worker_hud.stale = true;
+        self.worker_hud.shells.pending = None;
+        self.worker_hud.shells.stale = true;
+        self.chat_widget.set_shell_hud(
+            self.worker_hud.shells.rows(),
+            true,
+            self.primary_thread_id.is_some(),
+        );
+        self.chat_widget.set_worker_hud(
+            self.worker_hud.rows.clone(),
+            true,
+            self.primary_thread_id.is_some(),
+        );
+    }
+
+    pub(super) fn refresh_worker_hud(
+        &mut self,
+        app_server: &AppServerSession,
+        frame_requester: &tui::FrameRequester,
+    ) {
+        self.worker_hud.bind(self.primary_thread_id);
+        let goal_indicator = self
+            .worker_hud
+            .goal
+            .clone()
+            .filter(|(id, label)| {
+                self.current_displayed_thread_id() == self.primary_thread_id
+                    && !(label == "Goal complete"
+                        && self.worker_hud.dismissed_complete.as_ref() == Some(id))
+            })
+            .map(|(_, label)| {
+                let label = if label.starts_with("Goal waiting")
+                    && self.chat_widget.is_agent_turn_running()
+                {
+                    "Goal active".into()
+                } else if self.reconnect.offline && matches!(label.as_str(), "Goal active") {
+                    "Goal needs input".into()
+                } else {
+                    label
+                };
+                crate::bottom_pane::GoalStatusIndicator::Plus(label)
+            });
+        self.chat_widget.set_plus_goal_indicator(goal_indicator);
+        self.refresh_watcher_health(app_server.uses_remote_workspace());
+        self.refresh_shell_hud(app_server);
+        let Some(root) = self.primary_thread_id else {
+            self.chat_widget.set_worker_hud(Vec::new(), false, false);
+            return;
+        };
+        if self.reconnect.offline {
+            self.worker_hud.pending = None;
+        }
+        let stale = self.reconnect.offline
+            || self.worker_hud.fetched_at.is_none()
+            || self.worker_hud.stale
+            || self
+                .worker_hud
+                .fetched_at
+                .is_some_and(|at| at.elapsed() > FETCH_TIMEOUT);
+        self.chat_widget
+            .set_worker_hud(self.worker_hud.rows.clone(), stale, true);
+        frame_requester.schedule_frame_in(REFRESH_INTERVAL);
+        if self.reconnect.offline
+            || self.worker_hud.pending.is_some()
+            || self
+                .worker_hud
+                .attempted_at
+                .is_some_and(|at| at.elapsed() < REFRESH_INTERVAL)
+        {
+            return;
+        }
+        let request_id = Uuid::new_v4();
+        self.worker_hud.pending = Some(request_id);
+        self.worker_hud.attempted_at = Some(Instant::now());
+        let request_handle = app_server.request_handle();
+        let sqlite = (!app_server.uses_remote_workspace()).then(|| self.config.sqlite.clone());
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let deadline = tokio::time::Instant::now() + FETCH_TIMEOUT;
+            let result = tokio::time::timeout_at(deadline, async {
+                let mut threads = Vec::new();
+                let mut cursor = None;
+                let mut seen_cursors = HashSet::new();
+                loop {
+                    if !seen_cursors.insert(cursor.clone()) || threads.len() >= 1_000 {
+                        return Err("worker list incomplete".to_string());
+                    }
+                    let page = request_handle
+                        .request_typed::<ThreadListResponse>(ClientRequest::ThreadList {
+                            request_id: RequestId::String(Uuid::new_v4().to_string()),
+                            params: ThreadListParams {
+                                excluded_thread_ids: None,
+                                cursor,
+                                limit: Some(100),
+                                sort_key: None,
+                                sort_direction: Some(SortDirection::Asc),
+                                model_providers: Some(vec![]),
+                                source_kinds: Some(vec![ThreadSourceKind::SubAgentThreadSpawn]),
+                                originators: None,
+                                archived: Some(false),
+                                section_id: None,
+                                project_id: None,
+                                cwd: None,
+                                use_state_db_only: true,
+                                search_term: None,
+                                parent_thread_id: Some(root.to_string()),
+                                ancestor_thread_id: None,
+                            },
+                        })
+                        .await
+                        .map_err(|err| err.to_string())?;
+                    threads.extend(page.data.into_iter().filter(|thread| {
+                        thread.parent_thread_id.as_deref() == Some(root.to_string().as_str())
+                    }));
+                    match page.next_cursor {
+                        Some(next) => cursor = Some(next),
+                        None => break,
+                    }
+                }
+                let now = SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .unwrap_or_default()
+                    .as_secs();
+                let rows = futures::stream::iter(threads.into_iter().map(|thread| {
+                    let request_handle = request_handle.clone();
+                    async move {
+                        if !matches!(thread.status, ThreadStatus::Active { .. }) {
+                            let row = worker_row(&thread, None, now);
+                            return Ok((thread, row, None));
+                        }
+                        let turns = request_handle
+                            .request_typed::<ThreadTurnsListResponse>(
+                                ClientRequest::ThreadTurnsList {
+                                    request_id: RequestId::String(Uuid::new_v4().to_string()),
+                                    params: ThreadTurnsListParams {
+                                        thread_id: thread.id.clone(),
+                                        cursor: None,
+                                        limit: Some(1),
+                                        sort_direction: Some(SortDirection::Desc),
+                                        items_view: Some(TurnItemsView::NotLoaded),
+                                    },
+                                },
+                            )
+                            .await
+                            .map_err(|err| err.to_string())?;
+                        let turn = turns.data.into_iter().next();
+                        let row = worker_row(&thread, turn.as_ref(), now);
+                        Ok::<_, String>((thread, row, turn.map(|turn| turn.id)))
+                    }
+                }))
+                .buffered(8)
+                .try_collect::<Vec<_>>()
+                .await?;
+                Ok(rows)
+            })
+            .await
+            .map_err(|_| "worker metadata timed out".to_string())
+            .and_then(|result| result);
+            let result = match result {
+                Ok(mut workers) => {
+                    // Optional metrics must never invalidate a valid runtime snapshot.
+                    let metrics_deadline =
+                        deadline.min(tokio::time::Instant::now() + Duration::from_millis(250));
+                    let _ = tokio::time::timeout_at(
+                        metrics_deadline,
+                        read_worker_tokens(sqlite.as_ref(), &mut workers),
+                    )
+                    .await;
+                    let mut rows: Vec<_> = workers.into_iter().map(|(_, row, _)| row).collect();
+                    rows.sort_by_key(|row| !row.state.is_active());
+                    Ok(rows)
+                }
+                Err(err) => Err(err),
+            };
+            app_event_tx.send(AppEvent::WorkerHudLoaded {
+                primary_thread_id: root,
+                request_id,
+                result,
+            });
+        });
+    }
+
+    fn refresh_shell_hud(&mut self, app_server: &AppServerSession) {
+        let Some(root) = self.primary_thread_id else {
+            self.chat_widget.set_shell_hud(Vec::new(), false, false);
+            return;
+        };
+        let shells = &mut self.worker_hud.shells;
+        if self.reconnect.offline {
+            shells.pending = None;
+        }
+        let stale = self.reconnect.offline
+            || shells.stale
+            || shells.fetched_at.is_none()
+            || shells
+                .fetched_at
+                .is_some_and(|at| at.elapsed() > FETCH_TIMEOUT);
+        self.chat_widget.set_shell_hud(shells.rows(), stale, true);
+        if self.reconnect.offline
+            || shells.pending.is_some()
+            || shells
+                .attempted_at
+                .is_some_and(|at| at.elapsed() < REFRESH_INTERVAL)
+        {
+            return;
+        }
+        let request_id = Uuid::new_v4();
+        shells.pending = Some(request_id);
+        shells.attempted_at = Some(Instant::now());
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = tokio::time::timeout(
+                FETCH_TIMEOUT,
+                fetch_shells(root, |params| {
+                    let request_handle = request_handle.clone();
+                    async move {
+                        request_handle
+                            .request_typed::<ThreadBackgroundTerminalsListResponse>(
+                                ClientRequest::ThreadBackgroundTerminalsList {
+                                    request_id: RequestId::String(Uuid::new_v4().to_string()),
+                                    params,
+                                },
+                            )
+                            .await
+                            .map_err(|err| err.to_string())
+                    }
+                }),
+            )
+            .await
+            .map_err(|_| "shell metadata timed out".to_string())
+            .and_then(|result| result);
+            app_event_tx.send(AppEvent::ShellHudLoaded {
+                primary_thread_id: root,
+                request_id,
+                result,
+            });
+        });
+    }
+
+    pub(super) fn finish_shell_hud(
+        &mut self,
+        root: ThreadId,
+        request_id: Uuid,
+        result: Result<Vec<ThreadBackgroundTerminal>, String>,
+    ) {
+        if !self.reconnect.offline
+            && self.primary_thread_id == Some(root)
+            && self
+                .worker_hud
+                .finish_shells(root, request_id, result, Instant::now())
+        {
+            self.chat_widget.set_shell_hud(
+                self.worker_hud.shells.rows(),
+                self.worker_hud.shells.stale,
+                true,
+            );
+        }
+    }
+
+    fn refresh_watcher_health(&mut self, remote: bool) {
+        if remote || self.primary_thread_id.is_none() {
+            self.worker_hud.watcher_pending = None;
+            self.worker_hud.watcher = None;
+            self.chat_widget.set_watcher_health(None);
+            self.worker_hud.advisor = None;
+            self.worker_hud.goal = None;
+            self.chat_widget.set_advisor(None);
+            return;
+        }
+        self.chat_widget
+            .set_watcher_health(self.worker_hud.watcher.clone());
+        self.chat_widget
+            .set_advisor(self.worker_hud.advisor.clone());
+        if self.worker_hud.watcher_pending.is_some()
+            || self
+                .worker_hud
+                .watcher_attempted_at
+                .is_some_and(|at| at.elapsed() < REFRESH_INTERVAL)
+        {
+            return;
+        }
+        let root = self.primary_thread_id.expect("checked above");
+        let request_id = Uuid::new_v4();
+        self.worker_hud.watcher_pending = Some(request_id);
+        self.worker_hud.watcher_attempted_at = Some(Instant::now());
+        let path = self
+            .config
+            .codex_home
+            .join("codex-plus")
+            .join(format!("{root}.status.json"));
+        let advisor_path = self
+            .config
+            .codex_home
+            .join("codex-plus")
+            .join(format!("{root}.advisor.json"));
+        let ready = super::advisor::ready_model(&self.model_catalog.models);
+        let app_event_tx = self.app_event_tx.clone();
+        let goal_home = self.config.codex_home.clone();
+        let fallback_goal = self.worker_hud.goal.clone().map(|(id, label)| {
+            (
+                id,
+                if label.starts_with("Goal waiting") || label == "Goal active" {
+                    "Goal needs input".into()
+                } else {
+                    label
+                },
+            )
+        });
+        tokio::spawn(async move {
+            let read = tokio::task::spawn_blocking(move || {
+                let now = SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .unwrap_or_default()
+                    .as_secs_f64();
+                (
+                    read_watcher_health(path.as_path(), root, now),
+                    super::advisor::read_advisor(&advisor_path, root, now, ready),
+                    match crate::plus_goals::read(goal_home.as_path(), root) {
+                        Ok(Some(snapshot)) => {
+                            let id = snapshot
+                                .goal
+                                .as_ref()
+                                .map(|goal| goal.id.clone())
+                                .unwrap_or_default();
+                            crate::plus_goals::indicator(
+                                goal_home.as_path(),
+                                root,
+                                snapshot,
+                                now,
+                                false,
+                            )
+                            .map(|label| (id, label))
+                        }
+                        Ok(None) => None,
+                        Err(_) => Some((String::new(), "Goal needs input".into())),
+                    },
+                )
+            });
+            let (health, advisor, goal) = tokio::time::timeout(WATCHER_TIMEOUT, read)
+                .await
+                .ok()
+                .and_then(Result::ok)
+                .unwrap_or((
+                    Some(WatcherHealth::Unavailable),
+                    Some(super::advisor::unavailable()),
+                    fallback_goal,
+                ));
+            app_event_tx.send(AppEvent::WatcherHealthLoaded {
+                primary_thread_id: root,
+                request_id,
+                health,
+                advisor,
+                goal,
+            });
+        });
+    }
+
+    pub(super) fn finish_watcher_health(
+        &mut self,
+        root: ThreadId,
+        request_id: Uuid,
+        health: Option<WatcherHealth>,
+        advisor: Option<crate::bottom_pane::worker_hud::AdvisorRow>,
+        goal: Option<(String, String)>,
+    ) {
+        if self.primary_thread_id == Some(root)
+            && self.worker_hud.finish_watcher(root, request_id, health)
+        {
+            self.chat_widget
+                .set_watcher_health(self.worker_hud.watcher.clone());
+            self.worker_hud.advisor = advisor;
+            self.worker_hud.goal = goal;
+            self.chat_widget
+                .set_advisor(self.worker_hud.advisor.clone());
+        }
+    }
+
+    pub(super) fn finish_worker_hud(
+        &mut self,
+        root: ThreadId,
+        request_id: Uuid,
+        result: Result<Vec<WorkerRow>, String>,
+    ) {
+        if !self.reconnect.offline
+            && self.primary_thread_id == Some(root)
+            && self.worker_hud.finish(root, request_id, result)
+        {
+            self.chat_widget.set_worker_hud(
+                self.worker_hud.rows.clone(),
+                self.worker_hud.stale || self.reconnect.offline,
+                true,
+            );
+        }
+    }
+}
+
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum WatcherState {
+    Waiting,
+    Uncertain,
+    Error,
+    Report,
+    Idle,
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WatcherStatus {
+    version: u32,
+    parent: ThreadId,
+    updated_at: f64,
+    state: WatcherState,
+    jobs: u64,
+    uncertain: u64,
+    reports: u64,
+}
+
+pub(crate) fn read_status_bytes(path: &std::path::Path) -> std::io::Result<Option<Vec<u8>>> {
+    read_status_bytes_with_limit(path, WATCHER_MAX_BYTES)
+}
+
+pub(crate) fn read_status_bytes_with_limit(
+    path: &std::path::Path,
+    max_bytes: u64,
+) -> std::io::Result<Option<Vec<u8>>> {
+    use std::io::Read;
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        // Opening a replaced path must not wait on a pipe instead of a status file.
+        options.custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW);
+    }
+    let file = match options.open(path) {
+        Ok(file) => file,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(err) => return Err(err),
+    };
+    let metadata = file.metadata()?;
+    if !metadata.is_file() || metadata.len() > max_bytes {
+        return Err(std::io::Error::other("invalid local status file"));
+    }
+    let mut bytes = Vec::new();
+    file.take(max_bytes + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > max_bytes {
+        return Err(std::io::Error::other("oversized local status file"));
+    }
+    Ok(Some(bytes))
+}
+
+fn read_watcher_health(path: &std::path::Path, root: ThreadId, now: f64) -> Option<WatcherHealth> {
+    let bytes = match read_status_bytes(path) {
+        Ok(bytes) => bytes?,
+        Err(_) => return Some(WatcherHealth::Unavailable),
+    };
+    let Ok(status) = serde_json::from_slice::<WatcherStatus>(&bytes) else {
+        return Some(WatcherHealth::Unavailable);
+    };
+    if status.version != 1
+        || status.parent != root
+        || !status.updated_at.is_finite()
+        || status.updated_at < 0.0
+    {
+        return Some(WatcherHealth::Unavailable);
+    }
+    match status.state {
+        WatcherState::Waiting if now - status.updated_at > WATCHER_STALE_SECS => {
+            Some(WatcherHealth::Unavailable)
+        }
+        WatcherState::Waiting => Some(WatcherHealth::Waiting(status.jobs)),
+        WatcherState::Uncertain => Some(WatcherHealth::Uncertain(status.uncertain)),
+        WatcherState::Error => Some(WatcherHealth::Unavailable),
+        WatcherState::Report => Some(WatcherHealth::Report(status.reports)),
+        WatcherState::Idle => None,
+    }
+}
+
+fn worker_row(thread: &Thread, turn: Option<&Turn>, now: u64) -> WorkerRow {
+    let state = worker_state(&thread.status, turn);
+    let elapsed_secs = worker_elapsed(&state, turn, now);
+    let task = [
+        source_agent_path(&thread.source).map(|path| {
+            path.rsplit('/')
+                .next()
+                .unwrap_or_default()
+                .replace('_', " ")
+        }),
+        thread.name.clone(),
+        thread.agent_nickname.clone(),
+        Some(thread.id.clone()),
+    ]
+    .into_iter()
+    .flatten()
+    .map(|label| {
+        label
+            .chars()
+            .map(|ch| if ch.is_control() { ' ' } else { ch })
+            .collect::<String>()
+            .trim()
+            .to_string()
+    })
+    .find(|label| !label.is_empty())
+    .unwrap_or_default();
+    WorkerRow {
+        group: worker_group(thread),
+        dispatch_elapsed_secs: u64::try_from(thread.created_at)
+            .ok()
+            .and_then(|created| now.checked_sub(created)),
+        task,
+        state,
+        elapsed_secs,
+        model: thread.model.clone(),
+        reasoning_effort: thread.reasoning_effort.clone(),
+        total_tokens: None,
+    }
+}
+
+fn worker_group(thread: &Thread) -> Option<WorkerGroup> {
+    let path = source_agent_path(&thread.source)?;
+    let (parent_path, leaf) = path.rsplit_once('/')?;
+    let parts: Vec<_> = leaf.split("__").collect();
+    if parts.len() != 3
+        || parts
+            .iter()
+            .any(|part| !part.bytes().any(|ch| ch.is_ascii_alphanumeric()))
+    {
+        return None;
+    }
+    let parent = thread.parent_thread_id.as_deref().unwrap_or(parent_path);
+    Some(WorkerGroup {
+        key: format!("{parent}\0{}\0{}", parts[0], parts[1]),
+        topic: parts[0].replace('_', " "),
+    })
+}
+
+async fn read_worker_tokens(
+    sqlite: Option<&codex_state::SqliteConfig>,
+    workers: &mut [(Thread, WorkerRow, Option<String>)],
+) {
+    let Some(sqlite) = sqlite else {
+        return;
+    };
+    for (thread, row, turn_id) in workers
+        .iter_mut()
+        .filter(|(_, row, _)| row.group.is_none() && row.elapsed_secs.is_some())
+    {
+        let (Some(path), Some(turn_id)) = (thread.path.clone(), turn_id.clone()) else {
+            continue;
+        };
+        let thread_id = thread.id.clone();
+        row.total_tokens =
+            tokio::task::spawn_blocking(move || read_turn_tokens(&path, &thread_id, &turn_id))
+                .await
+                .ok()
+                .flatten();
+    }
+    if !workers.iter().any(|(_, row, _)| row.group.is_some()) {
+        return;
+    }
+    let Ok(pool) = sqlite
+        .open_read_only_pool(&sqlite.state_db_path(), Some(Duration::from_millis(50)))
+        .await
+    else {
+        return;
+    };
+    for (thread, row, _) in workers.iter_mut().filter(|(_, row, _)| row.group.is_some()) {
+        // Forks can inherit the parent's cumulative total, so attribution is unknown.
+        if thread.forked_from_id.is_some() {
+            continue;
+        }
+        row.total_tokens =
+            sqlx::query_scalar::<_, i64>("SELECT tokens_used FROM threads WHERE id = ?")
+                .bind(&thread.id)
+                .fetch_optional(&pool)
+                .await
+                .ok()
+                .flatten()
+                .filter(|tokens| *tokens >= 0);
+    }
+    pool.close().await;
+}
+
+fn read_turn_tokens(path: &std::path::Path, thread_id: &str, turn_id: &str) -> Option<i64> {
+    use std::io::Read;
+    use std::io::Seek;
+    use std::io::SeekFrom;
+
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW);
+    }
+    let mut file = options.open(path).ok()?;
+    let metadata = file.metadata().ok()?;
+    if !metadata.is_file() {
+        return None;
+    }
+    // shortcut: usage outside the bounded tail stays unknown; expand only with evidence.
+    let start = metadata.len().saturating_sub(TURN_USAGE_MAX_BYTES);
+    file.seek(SeekFrom::Start(start)).ok()?;
+    let mut bytes = Vec::new();
+    file.take(metadata.len() - start)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    let first = if start > 0 {
+        bytes.iter().position(|byte| *byte == b'\n')? + 1
+    } else {
+        0
+    };
+    let last = bytes.iter().rposition(|byte| *byte == b'\n')?;
+    if first > last {
+        return None;
+    }
+    for (index, line) in bytes[first..last].rsplit(|byte| *byte == b'\n').enumerate() {
+        if index >= TURN_USAGE_MAX_RECORDS {
+            return None;
+        }
+        let record: serde_json::Value = serde_json::from_slice(line).ok()?;
+        if record.get("type")?.as_str()? != "token_usage_record" {
+            continue;
+        }
+        let payload = record.get("payload")?;
+        if payload.get("thread_id")?.as_str()? != thread_id
+            || payload.get("turn_id")?.as_str()? != turn_id
+        {
+            continue;
+        }
+        return payload
+            .get("turn_token_usage")?
+            .get("total_tokens")?
+            .as_i64()
+            .filter(|tokens| *tokens >= 0);
+    }
+    None
+}
+
+fn worker_state(status: &ThreadStatus, turn: Option<&Turn>) -> WorkerState {
+    match status {
+        ThreadStatus::Active { active_flags }
+            if active_flags.contains(&ThreadActiveFlag::WaitingOnApproval) =>
+        {
+            WorkerState::Approval
+        }
+        ThreadStatus::Active { active_flags }
+            if active_flags.contains(&ThreadActiveFlag::WaitingOnUserInput) =>
+        {
+            WorkerState::Input
+        }
+        ThreadStatus::Active { .. } => WorkerState::Active,
+        ThreadStatus::SystemError => WorkerState::Error,
+        ThreadStatus::NotLoaded => WorkerState::Unloaded,
+        ThreadStatus::Idle => match turn.map(|turn| &turn.status) {
+            Some(TurnStatus::Completed) => WorkerState::Done,
+            Some(TurnStatus::Failed) => WorkerState::Failed,
+            Some(TurnStatus::Interrupted) => WorkerState::Interrupted,
+            _ => WorkerState::Idle,
+        },
+    }
+}
+
+fn worker_elapsed(state: &WorkerState, turn: Option<&Turn>, now: u64) -> Option<u64> {
+    turn.and_then(|turn| {
+        let start = u64::try_from(turn.started_at?).ok()?;
+        let end = if state.is_active() {
+            if turn.status != TurnStatus::InProgress {
+                return None;
+            }
+            now
+        } else {
+            u64::try_from(turn.completed_at?).ok()?
+        };
+        end.checked_sub(start)
+    })
+}
