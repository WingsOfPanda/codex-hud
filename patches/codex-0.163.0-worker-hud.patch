+        for width in [120, 48] {
+            let (rows, cursor) = status_rows(&composer, separate, width, None);
+            let identity = rows.iter().position(|row| row.contains("MODEL")).unwrap();
+            if width == 120 {
+                assert!(rows[identity].contains("Main [default]"), "{rows:?}");
+            }
+            assert!(
+                !rows.iter().any(|row| row.contains("Goal active")),
