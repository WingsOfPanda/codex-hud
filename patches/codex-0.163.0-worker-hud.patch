+//! Plus goals share the bottom pane's layout, while native goals retain their footer.
+
+use super::*;
+use crate::terminal_palette::rgb_color;
+use crate::terminal_palette::with_test_default_colors;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+use ratatui::style::Color;
+use tokio::sync::mpsc::unbounded_channel;
+
+fn pane() -> BottomPane {
+    let (tx, _rx) = unbounded_channel();
+    tests::test_pane(AppEventSender::new(tx))
+}
+
+fn render(
+    pane: &BottomPane,
+    width: u16,
+    height: Option<u16>,
+    options: ComposerRenderOptions<'_>,
+) -> (Vec<String>, Option<(u16, u16)>) {
+    let view = pane.as_renderable_with_options(options);
+    let area = Rect::new(
+        0,
+        0,
+        width,
+        height.unwrap_or_else(|| view.desired_height(width)),
+    );
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer);
+    let rows = buffer
+        .content
+        .chunks(usize::from(width))
+        .map(|row| row.iter().map(|cell| cell.symbol()).collect::<String>())
+        .collect();
+    (rows, view.cursor_pos(area))
+}
+
+fn assert_above_input(rows: &[String], cursor: Option<(u16, u16)>) {
+    let goal = rows.iter().position(|row| row.contains("Goal")).unwrap();
+    let input = rows.iter().position(|row| row.contains('›')).unwrap();
+    assert!(goal < input, "{rows:?}");
+    assert_eq!(rows.iter().filter(|row| row.contains("Goal")).count(), 1);
+    assert_eq!(
+        rows[goal].trim_end().chars().count(),
+        rows[goal].chars().count() - 2
+    );
+    assert!(cursor.is_some_and(|(_, y)| usize::from(y) == input));
+}
+
+#[test]
+fn plus_goal_row_measurement_cursor_and_clear_share_both_layouts() {
+    for enabled in [false, true] {
+        for separate in [false, true] {
+            let mut pane = pane();
+            pane.set_status_line_enabled(enabled);
+            pane.set_status_line(Some("MODEL".into()));
+            pane.set_status_line_stats(Some("Context 75% left".into()));
+            pane.set_collaboration_mode_indicator(Some(CollaborationModeIndicator::Plan));
+            pane.composer.set_text_content("x".into(), vec![], vec![]);
+            let options = ComposerRenderOptions {
+                separate_status_line: separate,
+                ..Default::default()
+            };
+            for width in [12, 48, 120] {
+                let baseline = pane
+                    .as_renderable_with_options(options)
+                    .desired_height(width);
+                pane.set_goal_status_indicator(Some(GoalStatusIndicator::Plus(
+                    "Goal paused".into(),
+                )));
+                assert_eq!(
+                    pane.as_renderable_with_options(options)
+                        .desired_height(width),
+                    baseline + 1
+                );
+                let (rows, cursor) = render(&pane, width, None, options);
+                assert_above_input(&rows, cursor);
+                assert!(!rows.iter().any(|row| row.contains("Plan")), "{rows:?}");
+                assert!(rows.iter().any(|row| row.contains('x')));
+                for height in 0..=3 {
+                    let (rows, cursor) = render(&pane, width, Some(height), options);
+                    if let Some((x, y)) = cursor {
+                        assert!(x < width && y < height, "{rows:?}");
+                    }
+                    if height >= 3 {
+                        assert!(cursor.is_some(), "{rows:?}");
+                        assert!(rows.iter().any(|row| row.contains('x')), "{rows:?}");
+                    }
+                }
+                pane.set_goal_status_indicator(None);
+                assert_eq!(
+                    pane.as_renderable_with_options(options)
+                        .desired_height(width),
+                    baseline
+                );
+                let (rows, _) = render(&pane, width, None, options);
+                assert!(!rows.iter().any(|row| row.contains("Goal")));
+            }
+        }
+    }
+}
+
+#[test]
+fn plus_goal_header_keeps_previews_queue_help_and_composer_gap() {
+    for separate in [false, true] {
+        for running in [false, true] {
+            let mut pane = pane();
+            pane.set_task_running(running);
+            pane.set_status_line(Some("MODEL".into()));
+            pane.set_status_line_enabled(true);
+            pane.set_pending_input_preview(vec!["queued followup".into()], vec![], vec![]);
+            pane.set_pending_thread_approvals(vec!["pending approval".into()]);
+            pane.set_goal_status_indicator(Some(GoalStatusIndicator::Plus("Goal waiting".into())));
+            pane.set_queue_submissions(true);
+            let gap = ComposerGap::default();
+            let options = ComposerRenderOptions {
+                separate_status_line: separate,
+                command_popup_placement: CommandPopupPlacement::Overlay,
+                composer_gap: Some(&gap),
+                ..Default::default()
+            };
+            for help in [false, true] {
+                if help {
+                    pane.handle_key_event(KeyEvent::new(KeyCode::Char('?'), KeyModifiers::NONE));
+                    assert!(pane.shortcut_overlay_visible());
+                }
+                let (rows, cursor) = render(&pane, 100, None, options);
+                assert_above_input(&rows, cursor);
+                assert!(
+                    rows.iter().any(|row| row.contains("queued followup")),
+                    "{rows:?}"
+                );
+                assert!(
+                    rows.iter().any(|row| row.contains("pending approval")),
+                    "{rows:?}"
+                );
+                if help {
+                    assert!(
+                        rows.iter().any(|row| row.contains("Keyboard shortcuts")),
+                        "{rows:?}"
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn plus_goal_long_labels_use_one_ellipsized_row() {
+    let mut pane = pane();
+    pane.set_status_line_enabled(false);
+    pane.composer.set_text_content("x".into(), vec![], vec![]);
+    let label = "Goal waiting · 18446744073709551615 jobs";
+    pane.set_goal_status_indicator(Some(GoalStatusIndicator::Plus(label.into())));
+    for width in [3, 12, 48, 120] {
+        let line = PlusGoalStatus(pane.composer.plus_goal_status_line().unwrap());
+        assert_eq!(line.desired_height(width), 1);
+        let mut buffer = Buffer::empty(Rect::new(0, 0, width, 1));
+        line.render(buffer.area, &mut buffer);
+        let text = buffer
+            .content
+            .iter()
+            .map(|cell| cell.symbol())
+            .collect::<String>();
+        if width <= 4 {
+            assert!(text.trim().is_empty(), "{text:?}");
+        } else if usize::from(width) < label.chars().count() + 4 {
+            assert!(text.trim_end().ends_with('…'), "{text:?}");
+        } else {
+            assert!(text.contains(label), "{text:?}");
+        }
+        if width > 4 {
+            assert_eq!(text.trim_end().chars().count(), usize::from(width - 2));
+        }
+    }
+}
+
+#[test]
+fn plus_goal_blue_and_mono_fallback_keep_native_goal_footer_unchanged() {
+    with_test_default_colors(
+        crate::terminal_probe::DefaultColors {
+            fg: (255, 255, 255),
+            bg: (0, 0, 0),
+        },
+        || {
+            let mut pane = pane();
+            pane.set_goal_status_indicator(Some(GoalStatusIndicator::Plus("Goal active".into())));
+            let header = pane.composer.plus_goal_status_line().unwrap();
+            assert_eq!(header.spans[0].style.fg, Some(rgb_color((137, 180, 250))));
+            let mut buffer = Buffer::empty(Rect::new(0, 0, 100, 1));
+            PlusGoalStatus(header).render(buffer.area, &mut buffer);
+            assert!(
+                buffer
+                    .content
+                    .iter()
+                    .filter(|cell| cell.symbol() != " ")
+                    .all(|cell| cell.fg == rgb_color((137, 180, 250)))
+            );
+            assert!(
+                footer::status_line_right_indicator_line(
+                    Some(CollaborationModeIndicator::Plan),
+                    Some(&GoalStatusIndicator::Plus("Goal active".into())),
+                    false,
+                    true,
+                )
+                .is_none()
+            );
+            for indicator in [
+                GoalStatusIndicator::Active { usage: None },
+                GoalStatusIndicator::Paused,
+                GoalStatusIndicator::Blocked,
+                GoalStatusIndicator::UsageLimited,
+                GoalStatusIndicator::BudgetLimited { usage: None },
+                GoalStatusIndicator::Complete { usage: None },
+            ] {
+                pane.set_goal_status_indicator(Some(indicator.clone()));
+                assert!(pane.composer.plus_goal_status_line().is_none());
+                let line =
+                    footer::status_line_right_indicator_line(None, Some(&indicator), false, false)
+                        .unwrap();
+                assert_eq!(line.spans[0].style.fg, Some(Color::Magenta));
+                pane.set_status_line_enabled(true);
+                pane.set_status_line(Some("MODEL".into()));
+                let (rows, cursor) = render(&pane, 100, None, Default::default());
+                let input = rows.iter().position(|row| row.contains('›')).unwrap();
+                let goal = rows
+                    .iter()
+                    .position(|row| row.contains(&line.to_string()))
+                    .unwrap();
+                assert!(goal > input, "{rows:?}");
+                assert!(cursor.is_some());
+            }
+        },
+    );
+}
