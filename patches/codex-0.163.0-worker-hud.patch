+    for interrupted in [false, true] {
+        let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+        drain_insert_history(&mut rx);
+        start_parallel_mcp(&mut chat, "mcp");
+        chat.on_web_search_begin("web".into());
+        if interrupted {
+            chat.finalize_turn();
+        } else {
+            chat.on_task_complete(None, None, false);
+        }
+        let cells = std::iter::from_fn(|| rx.try_recv().ok())
+            .filter_map(|event| {
+                if let AppEvent::InsertHistoryCell(cell) = event {
+                    Some(cell)
+                } else {
+                    None
+                }
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(cells.len(), 2);
+        let text = cells
+            .iter()
+            .map(|cell| lines_to_single_string(&cell.raw_lines()))
+            .collect::<String>();
+        assert!(
+            !text.contains("Calling") && !text.contains("Browsing"),
+            "{text}"
+        );
+        assert!(
+            text.contains("interrupted") && text.contains("Interrupted web search"),
+            "{text}"
+        );
+        chat.on_mcp_tool_call_completed(parallel_mcp_item("mcp", false));
+        chat.on_web_search_end(
+            "web".into(),
+            "late".into(),
+            codex_app_server_protocol::WebSearchAction::Other,
+        );
+        assert!(drain_insert_history(&mut rx).is_empty());
+        assert!(chat.transcript.mcp_calls.is_empty());
+        assert!(chat.transcript.web_calls.is_empty());
+        let completed = cells
+            .iter()
+            .map(|cell| lines_to_single_string(&cell.raw_lines()))
+            .collect::<String>();
+        assert_eq!(completed.matches("result-mcp").count(), 1, "{completed}");
+        assert!(
+            completed.contains("Searched the web for late"),
+            "{completed}"
+        );
+        assert!(
+            !completed.contains("interrupted") && !completed.contains("Interrupted"),
+            "{completed}"
+        );
+    }
