new file mode 100644
index 000000000..091d6b725
--- /dev/null
+++ b/codex-rs/tui/src/exec_cell/advisor.rs
@@ -0,0 +1,286 @@
+//! Compact advisor presentation; execution and detailed output remain ordinary shell history.
+
+use super::model::ExecCell;
+use crate::bottom_pane::worker_hud::{
+    AdvisorRow, AdvisorState, advisor_topic, supported_advisor_model,
+};
+use crate::chatwidget::shell_policy::{ShellVisibility, eligible_shell, shell_directive};
+use crate::exec_command::escape_command;
+use crate::terminal_hyperlinks::HyperlinkLine;
+use crate::width::display_width;
+use ratatui::text::Line;
+
+impl ExecCell {
+    pub(crate) fn is_advisor(&self) -> bool {
+        self.advisor_topic().is_some()
+    }
+
+    fn advisor_topic(&self) -> Option<String> {
+        let [call] = self.group.calls.as_slice() else {
+            return None;
+        };
+        if !eligible_shell(call.source) {
+            return None;
+        }
+        let command = escape_command(&call.command);
+        if matches!(
+            shell_directive(&command),
+            Some((ShellVisibility::Auto | ShellVisibility::Background, _))
+        ) {
+            return None;
+        }
+        advisor_topic(&command)
+    }
+
+    pub(crate) fn set_advisor_turn_start(&mut self, started_at_ms: u64) {
+        self.advisor_after_ms = started_at_ms;
+    }
+
+    pub(crate) fn set_advisor(&mut self, row: Option<AdvisorRow>) -> bool {
+        let row = row.filter(|row| {
+            self.is_advisor()
+                && matches!(row.state, AdvisorState::Running(_))
+                && row
+                    .started_at_ms
+                    .is_some_and(|time| time >= self.advisor_after_ms)
+        });
+        if self.advisor == row {
+            return false;
+        }
+        self.advisor = row;
+        true
+    }
+
+    pub(super) fn advisor_lines(&self, width: u16) -> Option<Vec<HyperlinkLine>> {
+        let topic = self.advisor_topic()?;
+        let call = &self.group.calls[0];
+        let (label, secs) = if let Some(duration) = call.duration {
+            let output = call.output.as_ref()?;
+            if output.exit_code != 0 {
+                ("Advisor failed on", duration.as_secs())
+            } else {
+                // Only this command's actual advisor result establishes success on replay.
+                output.lines().find_map(|line| {
+                    let value: serde_json::Value = serde_json::from_str(&line).ok()?;
+                    let model = value.get("model")?.as_str()?;
+                    (value.get("effort")?.as_str()? == "xhigh" && supported_advisor_model(model))
+                        .then_some(())
+                })?;
+                ("Advised on", duration.as_secs())
+            }
+        } else {
+            let row = self.advisor.as_ref()?;
+            let AdvisorState::Running(secs) = row.state else {
+                return None;
+            };
+            ("Advisor on", secs)
+        };
+        Some(if width == 0 {
+            Vec::new()
+        } else {
+            let prefix = format!("• {label} ");
+            let timer = format!(" · {}:{:02}", secs / 60, secs % 60);
+            let topic_width =
+                usize::from(width).saturating_sub(display_width(&prefix) + display_width(&timer));
+            let topic = crate::line_truncation::truncate_line_with_ellipsis_if_overflow(
+                Line::from(topic),
+                topic_width,
+            );
+            vec![crate::history_cell::activity_preview::clipped_line(
+                Line::from(format!("{prefix}{topic}{timer}")),
+                width,
+            )]
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::exec_cell::{CommandOutput, new_active_exec_command};
+    use crate::history_cell::HistoryCell;
+    use codex_app_server_protocol::CommandExecutionSource;
+    use std::time::Duration;
+
+    fn cell(command: &str) -> ExecCell {
+        let mut cell = new_active_exec_command(
+            "advisor".into(),
+            vec!["bash".into(), "-lc".into(), command.into()],
+            vec![],
+            CommandExecutionSource::UnifiedExecStartup,
+            None,
+            false,
+        );
+        cell.set_advisor_turn_start(100_000);
+        cell
+    }
+
+    fn running(started_at_ms: u64, secs: u64) -> AdvisorRow {
+        AdvisorRow {
+            started_at_ms: Some(started_at_ms),
+            model: Some("gpt-6-astra".into()),
+            state: AdvisorState::Running(secs),
+        }
+    }
+
+    fn text(cell: &ExecCell) -> String {
+        cell.compact_hyperlink_lines(100)
+            .iter()
+            .map(|line| line.line.to_string())
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    #[test]
+    fn advisor_transcript_updates_one_row_then_uses_actual_completion() {
+        let mut cell = cell("codex-plus run -- codex-plus advisor --brief task");
+        assert!(cell.set_advisor(Some(running(100_001, 59))));
+        assert_eq!(text(&cell), "• Advisor on task · 0:59");
+        assert!(!cell.set_advisor(Some(running(100_001, 59))));
+        assert!(cell.set_advisor(Some(running(100_001, 60))));
+        assert_eq!(text(&cell), "• Advisor on task · 1:00");
+        assert_eq!(cell.compact_hyperlink_lines(18).len(), 1);
+        assert!(cell.compact_hyperlink_lines(0).is_empty());
+        cell.complete_call(
+            "advisor",
+            CommandOutput::new(
+                0,
+                "{\"model\":\"gpt-6.1-astra\",\"effort\":\"xhigh\",\"verdict\":\"revise\"}".into(),
+            ),
+            Duration::from_secs(252),
+        );
+        assert_eq!(text(&cell), "• Advised on task · 4:12");
+        assert!(
+            cell.transcript_lines(100)
+                .iter()
+                .any(|line| line.to_string().contains("verdict"))
+        );
+        insta::assert_snapshot!("advisor_transcript_done", text(&cell));
+    }
+
+    #[test]
+    fn advisor_transcript_rejects_old_unknown_and_unrelated_status() {
+        for command in [
+            "codex-plus advisor --brief task | cat",
+            "echo unrelated",
+            "echo 'codex-plus advisor --brief task'",
+            "printf '%s' 'codex-plus advisor --brief task'",
+            "ADVISOR='codex-plus advisor --brief task' unrelated",
+            "codex-plus advisor --brief task;",
+            "# codex-plus-shell: background\ncodex-plus advisor --brief task",
+            "# codex-plus-shell: auto\n# codex-plus-advisor: task\npython3 consult.py",
+            "# codex-plus-shell: background\n# codex-plus-advisor: task\npython3 consult.py",
+            "python3 .build/audit-fixes/consult.py",
+        ] {
+            let mut cell = cell(command);
+            assert!(!cell.set_advisor(Some(running(100_001, 59))), "{command}");
+            assert!(cell.advisor_lines(100).is_none());
+        }
+        let mut cell = cell("codex-plus advisor --brief task");
+        assert!(!cell.set_advisor(Some(running(99_999, 59))));
+        assert!(cell.advisor_lines(100).is_none());
+        // A delayed event uses the daemon's launch time, rather than receipt time.
+        cell.set_advisor_turn_start(90_000);
+        cell.set_advisor(Some(running(90_001, 59)));
+        assert!(text(&cell).contains("Advisor on task"));
+        cell.set_advisor(Some(AdvisorRow {
+            started_at_ms: Some(90_001),
+            model: Some("gpt-6-astra".into()),
+            state: AdvisorState::Done {
+                calls: 1,
+                last_secs: 59,
+            },
+        }));
+        assert!(cell.advisor_lines(100).is_none());
+        assert!(!text(&cell).contains("Advised on"));
+    }
+
+    #[test]
+    fn advisor_transcript_replay_and_failure_need_no_local_status() {
+        let command = "# codex-plus-shell: foreground\n# codex-plus-advisor: wake and cancellation fixes\npython3 .build/audit-fixes/consult.py";
+        let mut replay = cell(command);
+        replay.complete_call(
+            "advisor",
+            CommandOutput::new(
+                0,
+                "codex-plus log: /tmp/log\n{\"model\":\"gpt-6-astra\",\"effort\":\"xhigh\"}\n"
+                    .into(),
+            ),
+            Duration::from_secs(65),
+        );
+        assert_eq!(
+            text(&replay),
+            "• Advised on wake and cancellation fixes · 1:05"
+        );
+        let mut failure = cell(command);
+        failure.complete_call(
+            "advisor",
+            CommandOutput::new(130, "interrupted".into()),
+            Duration::from_secs(7),
+        );
+        assert_eq!(
+            text(&failure),
+            "• Advisor failed on wake and cancellation fixes · 0:07"
+        );
+        let mut malformed = cell("codex-plus advisor --brief task");
+        malformed.complete_call(
+            "advisor",
+            CommandOutput::new(
+                0,
+                "{\"model\":\"gpt-6-astra\\nSECRET\",\"effort\":\"xhigh\"}".into(),
+            ),
+            Duration::from_secs(7),
+        );
+        assert!(malformed.advisor_lines(100).is_none());
+    }
+
+    #[test]
+    fn advisor_transcript_accepts_exact_claude_result_only() {
+        for (model, effort, accepted) in [
+            ("claude-opus-5-5", "xhigh", true),
+            ("claude-opus-5-5-preview", "xhigh", false),
+            ("provider/claude-opus-5-5", "xhigh", false),
+            ("claude-opus-5-5\nSECRET", "xhigh", false),
+            ("claude-opus-5-5", "high", false),
+        ] {
+            let mut replay =
+                cell("codex-plus advisor --context-file 'review context.txt' --brief task");
+            replay.complete_call(
+                "advisor",
+                CommandOutput::new(
+                    0,
+                    serde_json::json!({ "model": model, "effort": effort }).to_string(),
+                ),
+                Duration::from_secs(65),
+            );
+            assert_eq!(
+                replay.advisor_lines(100).is_some(),
+                accepted,
+                "{model} {effort}"
+            );
+            if accepted {
+                assert_eq!(text(&replay), "• Advised on task · 1:05");
+            }
+        }
+    }
+
+    #[test]
+    fn advisor_wrapper_keeps_topic_and_minutes_before_timer_when_clipped() {
+        let command = "# codex-plus-shell: foreground\n# codex-plus-advisor: wake and cancellation fixes\npython3 .build/audit-fixes/consult.py";
+        let mut advisor = cell(command);
+        assert!(advisor.is_advisor());
+        assert!(!advisor.set_advisor(Some(running(99_999, 301))));
+        assert!(advisor.advisor_lines(100).is_none());
+        assert!(advisor.set_advisor(Some(running(100_001, 301))));
+        assert_eq!(
+            text(&advisor),
+            "• Advisor on wake and cancellation fixes · 5:01"
+        );
+        let short = advisor.compact_hyperlink_lines(28)[0].line.to_string();
+        assert!(short.ends_with(" · 5:01"), "{short}");
+        assert!(display_width(&short) <= 28);
+        let mut unrelated = cell("python3 unrelated.py");
+        assert!(!unrelated.set_advisor(Some(running(100_001, 301))));
+        assert!(unrelated.advisor_lines(100).is_none());
+    }
+}
