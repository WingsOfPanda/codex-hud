+fn status_rows(
+    composer: &ChatComposer,
+    separate_status_line: bool,
+    width: u16,
+    height: Option<u16>,
+) -> (Vec<String>, Option<(u16, u16)>) {
+    let options = ComposerRenderOptions {
+        separate_status_line,
+        ..Default::default()
+    };
+    let area = Rect::new(
+        0,
+        0,
+        width,
+        height.unwrap_or_else(|| composer.desired_height_with_options(width, options)),
+    );
+    let mut buffer = Buffer::empty(area);
+    composer.render_with_options(area, &mut buffer, None, options);
+    let rows = buffer
+        .content()
+        .chunks(usize::from(width))
+        .map(|cells| {
+            cells
+                .iter()
+                .map(|cell| cell.symbol())
+                .collect::<String>()
+                .trim()
+                .to_string()
+        })
+        .collect();
+    (rows, composer.cursor_pos_with_options(area, options))
+}
