+#[test]
+fn shell_policy_persisted_pages_match_compact_and_quick_replay() {
+    let cwd = test_path_buf("/workspace").abs();
+    for (policy, duration, compact) in [
+        ("auto", Some(2000), false),
+        ("auto", Some(2001), true),
+        ("auto", None, false),
+        ("background", None, true),
+        ("foreground", Some(9000), false),
+    ] {
+        let mut item = command_item(CommandExecutionStatus::Completed);
+        if let ThreadItem::CommandExecution {
+            command,
+            duration_ms,
+            aggregated_output,
+            ..
+        } = &mut item
+        {
+            *command = shlex::try_join([
+                "bash",
+                "-lc",
+                &format!("# codex-plus-shell: {policy}\necho result"),
+            ])
+            .unwrap();
+            *duration_ms = duration;
+            *aggregated_output = Some(
+                "codex-plus log: /tmp/job.log\nnoise\ncodex-plus result: exit=0 log=/tmp/job.log\n"
+                    .into(),
+            );
+        }
+        let cells = thread_items_to_transcript_cells(
+            None,
+            &cwd,
+            [item],
+            RawReasoningVisibility::Hidden,
+            None,
+        );
+        let text = cells
+            .iter()
+            .flat_map(|cell| cell.transcript_lines(80))
+            .flat_map(|line| line.spans)
+            .map(|span| span.content.into_owned())
+            .collect::<String>();
+        assert_eq!(
+            text.contains("Shell completed"),
+            compact,
+            "{policy} {duration:?}: {text}"
+        );
+        assert_eq!(text.contains("noise"), !compact);
+        assert!(!text.contains("codex-plus-shell"));
+        if compact {
+            assert!(text.contains("Log: /tmp/job.log"));
+        }
+    }
+}
