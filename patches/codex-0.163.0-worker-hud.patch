diff --git a/codex-rs/tui/src/app/advisor.rs b/codex-rs/tui/src/app/advisor.rs
new file mode 100644
index 000000000..887906dc3
--- /dev/null
+++ b/codex-rs/tui/src/app/advisor.rs
@@ -0,0 +1,259 @@
+//! Local advisory status only; consulting the model belongs to the explicit CLI helper.
+
+use super::worker_hud::read_status_bytes;
+use crate::bottom_pane::worker_hud::AdvisorRow;
+use crate::bottom_pane::worker_hud::AdvisorState;
+use crate::bottom_pane::worker_hud::supported_advisor_model;
+use codex_protocol::ThreadId;
+use std::path::Path;
+
+pub(super) fn unavailable() -> AdvisorRow {
+    AdvisorRow {
+        started_at_ms: None,
+        model: None,
+        state: AdvisorState::Unavailable,
+    }
+}
+
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum State {
+    Running,
+    Done,
+    Error,
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Status {
+    version: u32,
+    parent: ThreadId,
+    model: String,
+    effort: String,
+    state: State,
+    started_at: f64,
+    updated_at: f64,
+    finished_at: Option<f64>,
+    calls: u64,
+    last_duration_secs: Option<f64>,
+    error: Option<String>,
+}
+
+pub(super) fn read_advisor(path: &Path, root: ThreadId, now: f64) -> Option<AdvisorRow> {
+    let bytes = match read_status_bytes(path) {
+        Ok(Some(bytes)) => bytes,
+        Ok(None) => {
+            return Some(AdvisorRow {
+                started_at_ms: None,
+                model: None,
+                state: AdvisorState::Ready,
+            });
+        }
+        Err(_) => return Some(unavailable()),
+    };
+    let Ok(status) = serde_json::from_slice::<Status>(&bytes) else {
+        return Some(unavailable());
+    };
+    let epoch = |time: f64| time.is_finite() && time >= 0.0;
+    if status.version != 1
+        || status.parent != root
+        || !supported_advisor_model(&status.model)
+        || status.effort != "xhigh"
+        || status.calls == 0
+        || !epoch(status.started_at)
+        || !epoch(status.updated_at)
+        || status.updated_at < status.started_at
+        || status
+            .finished_at
+            .is_some_and(|time| !epoch(time) || time < status.started_at)
+        || status.last_duration_secs.is_some_and(|time| !epoch(time))
+        || status.error.as_ref().is_some_and(|code| {
+            code.is_empty()
+                || code.len() > 64
+                || !code
+                    .bytes()
+                    .all(|ch| ch.is_ascii_lowercase() || ch.is_ascii_digit() || ch == b'_')
+        })
+    {
+        return Some(unavailable());
+    }
+    let state = match status.state {
+        State::Running if status.finished_at.is_none() && status.error.is_none() => {
+            if now - status.updated_at > 15.0 || status.updated_at > now + 5.0 {
+                AdvisorState::Unavailable
+            } else {
+                AdvisorState::Running((now - status.started_at).max(0.0) as u64)
+            }
+        }
+        State::Done if status.finished_at.is_some() && status.error.is_none() => {
+            let Some(duration) = status.last_duration_secs else {
+                return Some(unavailable());
+            };
+            AdvisorState::Done {
+                calls: status.calls,
+                last_secs: duration as u64,
+            }
+        }
+        State::Error if status.finished_at.is_some() && status.error.is_some() => {
+            AdvisorState::Error
+        }
+        _ => return Some(unavailable()),
+    };
+    Some(AdvisorRow {
+        started_at_ms: Some((status.started_at * 1000.0) as u64),
+        model: Some(status.model),
+        state,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn status(root: ThreadId, state: &str) -> serde_json::Value {
+        serde_json::json!({"version":1,"parent":root.to_string(),"model":"gpt-6-astra","effort":"xhigh",
+            "state":state,"started_at":100.0,"updated_at":105.0,"finished_at":null,"calls":2,
+            "last_duration_secs":222.0,"error":null})
+    }
+
+    #[test]
+    fn advisor_missing_ready_and_persistent_terminal_states() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("advisor.json");
+        let root = ThreadId::new();
+        let ready = read_advisor(&path, root, 110.0).unwrap();
+        assert_eq!(ready.state, AdvisorState::Ready);
+        assert_eq!(ready.model, None);
+        assert!(!path.exists());
+        let mut value = status(root, "running");
+        std::fs::write(&path, value.to_string()).unwrap();
+        let row = read_advisor(&path, root, 110.0).unwrap();
+        assert_eq!(row.model.as_deref(), Some("gpt-6-astra"));
+        assert_eq!(row.state, AdvisorState::Running(10));
+        assert_eq!(
+            read_advisor(&path, root, 120.0).unwrap().state,
+            AdvisorState::Running(20)
+        );
+        assert_eq!(
+            read_advisor(&path, root, 120.1).unwrap().state,
+            AdvisorState::Unavailable
+        );
+        value["state"] = serde_json::json!("done");
+        value["finished_at"] = serde_json::json!(110.0);
+        std::fs::write(&path, value.to_string()).unwrap();
+        assert_eq!(
+            read_advisor(&path, root, 9999.0).unwrap().state,
+            AdvisorState::Done {
+                calls: 2,
+                last_secs: 222
+            }
+        );
+        value["state"] = serde_json::json!("error");
+        value["error"] = serde_json::json!("exec_failed");
+        std::fs::write(&path, value.to_string()).unwrap();
+        assert_eq!(
+            read_advisor(&path, root, 9999.0).unwrap().state,
+            AdvisorState::Error
+        );
+    }
+
+    #[test]
+    fn advisor_accepts_exact_claude_status_and_preserves_lifecycle() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("advisor.json");
+        let root = ThreadId::new();
+        let mut value = status(root, "running");
+        value["model"] = serde_json::json!("claude-opus-5-5");
+        std::fs::write(&path, value.to_string()).unwrap();
+        let row = read_advisor(&path, root, 110.0).unwrap();
+        assert_eq!(row.model.as_deref(), Some("claude-opus-5-5"));
+        assert_eq!(row.state, AdvisorState::Running(10));
+        assert_eq!(
+            read_advisor(&path, root, 120.1).unwrap().state,
+            AdvisorState::Unavailable
+        );
+        value["state"] = serde_json::json!("done");
+        value["finished_at"] = serde_json::json!(110.0);
+        std::fs::write(&path, value.to_string()).unwrap();
+        assert_eq!(
+            read_advisor(&path, root, 9999.0).unwrap().state,
+            AdvisorState::Done {
+                calls: 2,
+                last_secs: 222
+            }
+        );
+        value["state"] = serde_json::json!("error");
+        value["error"] = serde_json::json!("exec_failed");
+        std::fs::write(&path, value.to_string()).unwrap();
+        assert_eq!(
+            read_advisor(&path, root, 9999.0).unwrap().state,
+            AdvisorState::Error
+        );
+        for model in [
+            "claude-opus-5-5-preview",
+            "provider/claude-opus-5-5",
+            "claude-opus-5-5\nsecret",
+        ] {
+            value["model"] = serde_json::json!(model);
+            std::fs::write(&path, value.to_string()).unwrap();
+            assert_eq!(
+                read_advisor(&path, root, 110.0),
+                Some(unavailable()),
+                "{model}"
+            );
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn advisor_rejects_symlink_and_fifo_without_blocking() {
+        use std::os::unix::ffi::OsStrExt;
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("advisor.json");
+        let root = ThreadId::new();
+        let source = dir.path().join("source");
+        std::fs::write(&source, status(root, "running").to_string()).unwrap();
+        std::os::unix::fs::symlink(&source, &path).unwrap();
+        assert_eq!(read_advisor(&path, root, 110.0), Some(unavailable()));
+        std::fs::remove_file(&path).unwrap();
+        let cpath = std::ffi::CString::new(path.as_os_str().as_bytes()).unwrap();
+        assert_eq!(unsafe { libc::mkfifo(cpath.as_ptr(), 0o600) }, 0);
+        let at = std::time::Instant::now();
+        assert_eq!(read_advisor(&path, root, 110.0), Some(unavailable()));
+        assert!(at.elapsed() < std::time::Duration::from_millis(250));
+    }
+
+    #[test]
+    fn advisor_rejects_wrong_root_schema_and_escaped_status_text() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("advisor.json");
+        let root = ThreadId::new();
+        for (key, value) in [
+            ("parent", serde_json::json!(ThreadId::new().to_string())),
+            ("model", serde_json::json!("gpt-6-astra\nsecret")),
+            ("effort", serde_json::json!("high")),
+            ("calls", serde_json::json!(0)),
+            ("version", serde_json::json!(2)),
+            ("started_at", serde_json::json!(-1)),
+            ("updated_at", serde_json::json!(99)),
+            ("state", serde_json::json!("unknown")),
+            ("error", serde_json::json!("secret\u{1b}[2J")),
+            ("brief", serde_json::json!("secret")),
+            ("last_duration_secs", serde_json::json!(-1)),
+            ("finished_at", serde_json::json!(101)),
+        ] {
+            let mut invalid = status(root, "running");
+            invalid[key] = value;
+            std::fs::write(&path, invalid.to_string()).unwrap();
+            assert_eq!(
+                read_advisor(&path, root, 110.0),
+                Some(unavailable()),
+                "{key}"
+            );
+        }
+        for bytes in [b"broken".to_vec(), vec![b' '; 16385]] {
+            std::fs::write(&path, bytes).unwrap();
+            assert_eq!(read_advisor(&path, root, 110.0), Some(unavailable()));
+        }
+    }
+}
