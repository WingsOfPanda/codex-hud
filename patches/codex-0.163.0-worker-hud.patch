+                    seen_secs: Some(60),
+                })
+                .collect(),
+            false,
+            true,
+        );
+        pane.set_advisor(Some(worker_hud::AdvisorRow {
+            started_at_ms: None,
+            model: Some("gpt-6-astra".into()),
+            state: worker_hud::AdvisorState::Ready,
+        }));
+        for running in [false, true] {
+            pane.set_task_running(running);
+            pane.handle_key_event(KeyEvent::new(KeyCode::Char('x'), KeyModifiers::NONE));
