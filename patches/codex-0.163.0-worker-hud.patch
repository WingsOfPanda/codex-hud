+#[tokio::test]
+async fn shell_policy_timer_rearms_after_an_earlier_coalesced_frame() {
+    let (mut chat, _, _) = make_chatwidget_manual(None).await;
+    let (requester, mut frames) = crate::tui::FrameRequester::test_channel();
+    chat.frame_requester = requester;
+    chat.on_task_started();
+    begin_exec(&mut chat, "managed", "# codex-plus-shell: auto\nsleep 9");
+    while frames.try_recv().is_ok() {}
+    let now = Instant::now();
+    let started = chat.managed_shells["managed"].started;
+    chat.update_shell_visibility_at(started + Duration::from_secs(1));
+    let deadline = frames
+        .try_recv()
+        .expect("timer must survive a coalesced early redraw");
+    assert!(deadline > now + Duration::from_millis(900));
+    assert!(!chat.managed_shells["managed"].quiet);
+}
