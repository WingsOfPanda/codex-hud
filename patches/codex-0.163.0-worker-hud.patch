+#[tokio::test]
+async fn plus_goal_editor_expands_managed_objective_and_freezes_edit_identity() -> Result<()> {
+    let (mut app, mut rx, mut op_rx) = make_test_app_with_channels().await;
+    let mut app_server =
+        crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref()).await?;
+    let started = app_server
+        .start_thread(app.chat_widget.config_ref())
+        .await?;
+    let root = started.session.thread_id;
+    app.enqueue_primary_thread_session(started.session, started.turns)
+        .await?;
+    let codex_home = app_server
+        .codex_home_path(&app.config.codex_home)
+        .expect("codex home");
+    let original = format!(
+        "{}detail",
+        "reviewed objective ".repeat(MAX_THREAD_GOAL_OBJECTIVE_CHARS)
+    );
+    let (reference, _) = goal_files::materialize_goal_draft(
+        &mut app_server,
+        Some(&codex_home),
+        goal_files::GoalDraft {
+            objective: original.clone(),
+            ..Default::default()
+        },
+    )
+    .await
+    .expect("materialize original objective");
+    let goal = serde_json::from_value(serde_json::json!({"id":"original-goal","revision":7,"state":"paused","objective":reference})).unwrap();
+    app.show_plus_goal_editor(&mut app_server, root, goal).await;
+    assert!(render_bottom_popup(&app.chat_widget, 80).contains("Edit Plus goal"));
+    app.chat_widget.handle_paste("!".into());
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    let events = std::iter::from_fn(|| rx.try_recv().ok()).collect::<Vec<_>>();
+    let observed = format!("{events:?}");
+    let (draft, expected) = events
+        .into_iter()
+        .find_map(|event| {
+            if let AppEvent::PlusGoalDraft {
+                thread_id,
+                draft,
+                expected,
+                edit: true,
+            } = event
+            {
+                assert_eq!(thread_id, root);
+                Some((draft, expected))
+            } else {
+                None
+            }
+        })
+        .unwrap_or_else(|| panic!("edited Plus goal draft missing: {observed}"));
+    assert_eq!(expected, Some(("original-goal".into(), 7)));
+    assert_eq!(draft.objective, format!("{original}!"));
+    let (edited_reference, _) =
+        goal_files::materialize_goal_draft(&mut app_server, Some(&codex_home), draft)
+            .await
+            .expect("materialize edited objective");
+    assert_ne!(edited_reference, reference);
+    assert_eq!(
+        goal_files::objective_text_for_edit(&mut app_server, Some(&codex_home), &reference)
+            .await
+            .expect("original retained"),
+        original
+    );
+    assert_eq!(
+        goal_files::objective_text_for_edit(&mut app_server, Some(&codex_home), &edited_reference)
+            .await
+            .expect("edited objective"),
+        format!("{original}!")
+    );
+    while let Ok(op) = op_rx.try_recv() {
+        assert!(
+            !matches!(op, Op::UserTurn { .. }),
+            "unexpected model submission: {op:?}"
+        );
+    }
+    app_server.shutdown().await?;
+    Ok(())
+}
