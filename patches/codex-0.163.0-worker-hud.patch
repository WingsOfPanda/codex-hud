+        assert_eq!(state.shells.first_seen[&("a".into(), "1".into())], later);
+        state.bind(Some(other));
+        state.shells.pending = Some(request);
+        assert!(!state.finish_shells(root, request, Ok(vec![shell("a", "1")]), now));
+        assert!(state.shells.terminals.is_empty() && state.shells.first_seen.is_empty());
