+#[tokio::test]
+async fn plus_goal_confirmation_freezes_revision_and_defers_draft_files() {
+    let (mut app, mut rx, mut op_rx) = make_test_app_with_channels().await;
+    let root = ThreadId::new();
+    let draft = goal_files::GoalDraft {
+        objective: "Use pasted objective".into(),
+        pending_pastes: vec![("placeholder".into(), "private objective".into())],
+        ..Default::default()
+    };
+    app.show_plus_goal_draft_confirmation(root, draft, Some(("original-goal".into(), 7)));
+    assert!(!app.config.codex_home.join("attachments").exists());
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    let (actual_root, draft, expected) = std::iter::from_fn(|| rx.try_recv().ok())
+        .find_map(|event| {
+            if let AppEvent::PlusGoalDraft {
+                thread_id,
+                draft,
+                expected,
+                edit: false,
+            } = event
+            {
+                Some((thread_id, draft, expected))
+            } else {
+                None
+            }
+        })
+        .expect("confirmed Plus goal draft");
+    assert_eq!(actual_root, root);
+    assert_eq!(expected, Some(("original-goal".into(), 7)));
+    assert_eq!(draft.pending_pastes[0].1, "private objective");
+    assert!(!app.config.codex_home.join("attachments").exists());
+    assert!(op_rx.try_recv().is_err());
+}
