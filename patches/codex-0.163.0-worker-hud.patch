+
+    #[test]
+    fn advisor_ready_uses_newest_numeric_astra_with_xhigh_only() {
+        fn preset(model: &str, effort: ReasoningEffort) -> ModelPreset {
+            let value = serde_json::json!({
+                "id":model, "model":model, "display_name":model, "description":"",
+                "default_reasoning_effort":"high", "supported_reasoning_efforts":[],
+                "is_default":false, "show_in_picker":true, "supported_in_api":true
+            });
+            let mut preset: ModelPreset = serde_json::from_value(value).unwrap();
+            preset.supported_reasoning_efforts = vec![ReasoningEffortPreset {
+                effort,
+                description: String::new(),
+            }];
+            preset
+        }
+        let mut hidden = preset("gpt-99-astra", ReasoningEffort::XHigh);
+        hidden.show_in_picker = false;
+        let models = vec![
+            hidden,
+            preset("gpt-6.9-astra", ReasoningEffort::XHigh),
+            preset("gpt-6.10-astra", ReasoningEffort::XHigh),
+            preset("gpt-7-astra", ReasoningEffort::High),
+            preset("gpt-9-sol", ReasoningEffort::XHigh),
+            preset("gpt-latest-astra", ReasoningEffort::XHigh),
+            preset("provider/gpt-8-astra", ReasoningEffort::XHigh),
+        ];
+        assert_eq!(ready_model(&models).as_deref(), Some("gpt-6.10-astra"));
+        assert_eq!(ready_model(&[]), None);
+        for slug in [
+            "gpt-6..1-astra",
+            "gpt--astra",
+            "gpt-6-astra-foo",
+            "gpt-999999999999999999999-astra",
+        ] {
+            assert_eq!(astra_version(slug), None);
+        }
+    }
+
+    #[test]
+    fn advisor_missing_ready_and_persistent_terminal_states() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("advisor.json");
+        let root = ThreadId::new();
+        assert_eq!(read_advisor(&path, root, 110.0, None), None);
+        assert!(!path.exists());
+        assert_eq!(
+            read_advisor(&path, root, 110.0, Some("gpt-7.2-astra".into()))
+                .unwrap()
+                .state,
+            AdvisorState::Ready
+        );
+        let mut value = status(root, "running");
+        std::fs::write(&path, value.to_string()).unwrap();
+        let row = read_advisor(&path, root, 110.0, Some("gpt-7-astra".into())).unwrap();
+        assert_eq!(row.model.as_deref(), Some("gpt-6-astra"));
+        assert_eq!(row.state, AdvisorState::Running(10));
+        assert_eq!(
+            read_advisor(&path, root, 120.0, None).unwrap().state,
+            AdvisorState::Running(20)
+        );
+        assert_eq!(
+            read_advisor(&path, root, 120.1, None).unwrap().state,
+            AdvisorState::Unavailable
+        );
+        value["state"] = serde_json::json!("done");
+        value["finished_at"] = serde_json::json!(110.0);
+        std::fs::write(&path, value.to_string()).unwrap();
+        assert_eq!(
+            read_advisor(&path, root, 9999.0, None).unwrap().state,
+            AdvisorState::Done {
+                calls: 2,
+                last_secs: 222
+            }
+        );
+        value["state"] = serde_json::json!("error");
+        value["error"] = serde_json::json!("exec_failed");
+        std::fs::write(&path, value.to_string()).unwrap();
+        assert_eq!(
+            read_advisor(&path, root, 9999.0, None).unwrap().state,
+            AdvisorState::Error
+        );
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn advisor_rejects_symlink_and_fifo_without_blocking() {
+        use std::os::unix::ffi::OsStrExt;
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("advisor.json");
+        let root = ThreadId::new();
+        let source = dir.path().join("source");
+        std::fs::write(&source, status(root, "running").to_string()).unwrap();
+        std::os::unix::fs::symlink(&source, &path).unwrap();
+        assert_eq!(read_advisor(&path, root, 110.0, None), Some(unavailable()));
+        std::fs::remove_file(&path).unwrap();
+        let cpath = std::ffi::CString::new(path.as_os_str().as_bytes()).unwrap();
+        assert_eq!(unsafe { libc::mkfifo(cpath.as_ptr(), 0o600) }, 0);
+        let at = std::time::Instant::now();
+        assert_eq!(read_advisor(&path, root, 110.0, None), Some(unavailable()));
+        assert!(at.elapsed() < std::time::Duration::from_millis(250));
+    }
+
+    #[test]
+    fn advisor_rejects_wrong_root_schema_and_escaped_status_text() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("advisor.json");
+        let root = ThreadId::new();
+        for (key, value) in [
+            ("parent", serde_json::json!(ThreadId::new().to_string())),
+            ("model", serde_json::json!("gpt-6-astra\nsecret")),
+            ("effort", serde_json::json!("high")),
+            ("calls", serde_json::json!(0)),
+            ("version", serde_json::json!(2)),
+            ("started_at", serde_json::json!(-1)),
+            ("updated_at", serde_json::json!(99)),
+            ("state", serde_json::json!("unknown")),
+            ("error", serde_json::json!("secret\u{1b}[2J")),
+            ("brief", serde_json::json!("secret")),
+            ("last_duration_secs", serde_json::json!(-1)),
+            ("finished_at", serde_json::json!(101)),
+        ] {
+            let mut invalid = status(root, "running");
+            invalid[key] = value;
+            std::fs::write(&path, invalid.to_string()).unwrap();
+            assert_eq!(
+                read_advisor(&path, root, 110.0, None),
+                Some(unavailable()),
+                "{key}"
+            );
+        }
+        for bytes in [b"broken".to_vec(), vec![b' '; 16385]] {
+            std::fs::write(&path, bytes).unwrap();
+            assert_eq!(read_advisor(&path, root, 110.0, None), Some(unavailable()));
+        }
+    }
+}
