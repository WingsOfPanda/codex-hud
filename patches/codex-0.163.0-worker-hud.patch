+#[test]
+fn automatic_hints_hide_while_busy_without_hiding_explicit_help_or_search() {
+    let mut composer = composer();
+    composer.set_task_running(true);
+    composer.set_text_content("editable draft".into(), vec![], vec![]);
+    let options = ComposerRenderOptions {
+        separate_status_line: true,
+        ..Default::default()
+    };
+    assert_eq!(composer.footer_hint_height(80, options), 0);
+    composer.footer.mode = FooterMode::EscHint;
+    assert_eq!(composer.footer_hint_height(80, options), 0);
+    composer.footer.mode = FooterMode::ShortcutOverlay;
+    assert_eq!(composer.footer_hint_height(80, options), 1);
+    composer.footer.mode = FooterMode::HistorySearch;
+    assert!(composer.footer_hint_height(80, options) > 0);
+    assert_eq!(composer.draft.textarea.text(), "editable draft");
+}
