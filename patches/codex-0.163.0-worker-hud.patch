+#[tokio::test]
+async fn late_tool_results_preserve_output_before_and_after_native_commit() -> Result<()> {
+    for (commit_interruption, immediate) in [(false, false), (true, false), (true, true)] {
+        let mut app = crate::app::test_support::make_test_app().await;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        let mcp = history_cell::RetainedToolCallCell::new(history_cell::new_active_mcp_tool_call(
+            "mcp".into(),
+            history_cell::McpInvocation {
+                server: "test".into(),
+                tool: "lookup".into(),
+                arguments: None,
+            },
+            false,
+        ));
+        let web = history_cell::RetainedToolCallCell::new(
+            history_cell::new_active_web_search_call("web".into(), String::new(), false),
+        );
+        if !immediate {
+            app.insert_history_cell(&mut tui, Box::new(mcp.clone()));
+            app.insert_history_cell(&mut tui, Box::new(web.clone()));
+        }
+        mcp.mark_interrupted();
+        web.mark_interrupted();
+        if immediate {
+            app.insert_history_cell(&mut tui, Box::new(mcp.clone()));
+            app.insert_history_cell(&mut tui, Box::new(web.clone()));
+        }
+        if commit_interruption {
+            app.flush_native_history(&mut tui);
+        }
+        let mcp_rendered = mcp.finish(|cell| {
+            let result = serde_json::from_value(serde_json::json!({"content": [{"type": "text", "text": "authoritative late output"}]})).unwrap();
+            cell.as_any_mut().downcast_mut::<history_cell::McpToolCallCell>().unwrap().complete(std::time::Duration::from_millis(5), Ok(result));
+        });
+        let web_rendered = web.finish(|cell| {
+            let cell = cell
+                .as_any_mut()
+                .downcast_mut::<history_cell::WebSearchCell>()
+                .unwrap();
+            cell.update(
+                codex_app_server_protocol::WebSearchAction::Other,
+                "late query".into(),
+            );
+            cell.complete();
+        });
+        assert_eq!(mcp_rendered, commit_interruption);
+        assert_eq!(web_rendered, commit_interruption);
+        if mcp_rendered {
+            app.refresh_retained_tool_call(&mut tui, &mcp);
+        }
+        if web_rendered {
+            app.refresh_retained_tool_call(&mut tui, &web);
+        }
+        app.flush_native_history(&mut tui);
+        let lines = tui.pending_history_lines_for_test();
+        let text = lines
+            .iter()
+            .map(|line| line.line.to_string())
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert_eq!(
+            text.matches("authoritative late output").count(),
+            1,
+            "{text}"
+        );
+        assert_eq!(text.matches("late query").count(), 1, "{text}");
+        assert_eq!(app.transcript_cells.len(), 2);
+        let replay = app
+            .render_transcript_lines_for_reflow(80)
+            .lines
+            .iter()
+            .map(|line| line.line.to_string())
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert_eq!(
+            replay.matches("authoritative late output").count(),
+            1,
+            "{replay}"
+        );
+        assert_eq!(replay.matches("late query").count(), 1, "{replay}");
+        assert!(
+            !replay.contains("interrupted") && !replay.contains("Interrupted"),
+            "{replay}"
+        );
+        app.flush_native_history(&mut tui);
+        assert_eq!(tui.pending_history_lines_for_test(), lines);
+    }
+    Ok(())
+}
