diff --git a/codex-rs/tui/src/chatwidget/shell_policy.rs b/codex-rs/tui/src/chatwidget/shell_policy.rs
new file mode 100644
index 000000000..6521fffda
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/shell_policy.rs
@@ -0,0 +1,284 @@
+//! Explicit presentation policy for noninteractive agent shell commands.
+
+use super::*;
+use crate::bottom_pane::worker_hud::ShellRow;
+use codex_shell_command::parse_command::extract_shell_command;
+
+pub(crate) const SHELL_FOREGROUND_LIMIT: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ShellVisibility {
+    Auto,
+    Background,
+    Foreground,
+}
+
+pub(super) struct ManagedShell {
+    pub(super) policy: ShellVisibility,
+    pub(super) started: Instant,
+    pub(super) quiet: bool,
+    pub(super) process_id: Option<String>,
+    pub(super) command: String,
+    raw_command: String,
+}
+
+/// Recognize only a complete first directive line, after shell wrappers.
+pub(crate) fn shell_directive(command: &str) -> Option<(ShellVisibility, String)> {
+    let mut script = command.to_string();
+    // Each unwrap removes a shell invocation; repeated scripts cannot make progress.
+    for _ in 0..16 {
+        let (first, body) = script.split_once('\n').unwrap_or((&script, ""));
+        let policy = match first {
+            "# codex-plus-shell: auto" => Some(ShellVisibility::Auto),
+            "# codex-plus-shell: background" => Some(ShellVisibility::Background),
+            "# codex-plus-shell: foreground" => Some(ShellVisibility::Foreground),
+            _ => None,
+        };
+        if let Some(policy) = policy {
+            // Keep explicit advisor identity when the managed label becomes an ExecCell command.
+            if policy == ShellVisibility::Foreground && body.starts_with("# codex-plus-advisor: ") {
+                return Some((policy, script));
+            }
+            return Some((policy, shell_command_label(body)));
+        }
+        let parts = split_command_string(&script);
+        let (_, inner) = extract_shell_command(&parts)?;
+        if inner == script {
+            return None;
+        }
+        script = inner.to_string();
+    }
+    None
+}
+
+fn shell_command_label(body: &str) -> String {
+    let parts = split_command_string(body);
+    if parts.len() > 3
+        && std::path::Path::new(&parts[0])
+            .file_name()
+            .is_some_and(|name| name == "codex-plus")
+        && parts[1] == "run"
+        && parts[2] == "--"
+    {
+        return crate::exec_command::escape_command(&parts[3..]);
+    }
+    body.to_string()
+}
+
+pub(crate) fn eligible_shell(source: ExecCommandSource) -> bool {
+    matches!(
+        source,
+        ExecCommandSource::Agent | ExecCommandSource::UnifiedExecStartup
+    )
+}
+
+pub(crate) fn quiet_shell(policy: ShellVisibility, duration: Option<Duration>) -> bool {
+    policy == ShellVisibility::Background
+        || (policy == ShellVisibility::Auto
+            && duration.is_some_and(|duration| duration > SHELL_FOREGROUND_LIMIT))
+}
+
+fn shell_text(text: &str, limit: usize) -> String {
+    let text = codex_ansi_escape::ansi_escape_line(text)
+        .spans
+        .into_iter()
+        .map(|span| span.content.into_owned())
+        .collect::<String>();
+    let mut chars = text
+        .chars()
+        .map(|ch| if ch.is_control() { ' ' } else { ch });
+    let mut clean: String = chars.by_ref().take(limit).collect();
+    if chars.next().is_some() {
+        clean.push('…');
+    }
+    clean
+}
+
+pub(crate) fn shell_result(command: &str, output: &str, exit: i32) -> Vec<Line<'static>> {
+    let command = command.split_whitespace().collect::<Vec<_>>().join(" ");
+    let command = shell_text(&command, 240);
+    let outcome = if exit == 0 { "completed" } else { "failed" };
+    let mut lines = vec![Line::from(format!(
+        "Shell {outcome} (exit {exit}): {command}"
+    ))];
+    // Output is untrusted text. A log reference is displayed, never opened or executed.
+    let first_log = output
+        .lines()
+        .next()
+        .and_then(|line| line.strip_prefix("codex-plus log: "));
+    let last_result = output
+        .lines()
+        .last()
+        .filter(|line| line.starts_with("codex-plus result: exit="));
+    let final_log = last_result
+        .and_then(|line| line.split_once(" log="))
+        .map(|(_, log)| log.strip_suffix(" log_incomplete=true").unwrap_or(log));
+    let log = first_log
+        .or(final_log)
+        .filter(|log| std::path::Path::new(log).is_absolute());
+    if let Some(log) = log {
+        lines.push(Line::from(format!("Log: {}", shell_text(log, 512))));
+    }
+    if last_result.is_some_and(|line| line.ends_with(" log_incomplete=true")) {
+        lines.push(Line::from("Log incomplete"));
+    } else if log.is_none() {
+        lines.push(Line::from("Log unavailable"));
+    }
+    if exit != 0 {
+        let excerpt: Vec<_> = output
+            .lines()
+            .filter(|line| {
+                !line.is_empty()
+                    && !line.starts_with("codex-plus log: ")
+                    && !line.starts_with("codex-plus result: ")
+            })
+            .rev()
+            .take(5)
+            .collect();
+        lines.extend(
+            excerpt
+                .into_iter()
+                .rev()
+                .map(|line| Line::from(shell_text(line, 240))),
+        );
+    }
+    lines
+}
+
+impl ChatWidget {
+    pub(super) fn register_managed_shell(&mut self, item: &ThreadItem) -> bool {
+        let ThreadItem::CommandExecution {
+            id,
+            command,
+            source,
+            process_id,
+            ..
+        } = item
+        else {
+            return false;
+        };
+        if !eligible_shell(*source) {
+            return false;
+        }
+        let raw_command = command.clone();
+        let Some((policy, command)) = shell_directive(command) else {
+            return false;
+        };
+        if let Some(shell) = self.managed_shells.get_mut(id) {
+            if process_id.is_some() {
+                shell.process_id = process_id.clone();
+            }
+        } else {
+            self.managed_shells.insert(
+                id.clone(),
+                ManagedShell {
+                    policy,
+                    started: Instant::now(),
+                    quiet: policy == ShellVisibility::Background,
+                    process_id: process_id.clone(),
+                    command: command.clone(),
+                    raw_command,
+                },
+            );
+            if policy == ShellVisibility::Auto {
+                self.frame_requester
+                    .schedule_frame_in(SHELL_FOREGROUND_LIMIT + Duration::from_millis(1));
+            }
+        }
+        if *source == ExecCommandSource::Agent
+            && !self
+                .unified_exec_processes
+                .iter()
+                .any(|process| process.call_id == *id)
+        {
+            self.track_unified_exec_process_begin(id, process_id.as_deref(), command.as_str());
+        }
+        true
+    }
+
+    pub(super) fn update_shell_visibility(&mut self) {
+        self.update_shell_visibility_at(Instant::now());
+    }
+
+    pub(super) fn update_shell_visibility_at(&mut self, now: Instant) {
+        let mut changed = false;
+        let mut next_deadline: Option<Duration> = None;
+        for shell in self.managed_shells.values_mut() {
+            if !shell.quiet
+                && quiet_shell(
+                    shell.policy,
+                    Some(now.saturating_duration_since(shell.started)),
+                )
+            {
+                shell.quiet = true;
+                changed = true;
+            }
+            if shell.policy == ShellVisibility::Auto && !shell.quiet {
+                let remaining = (SHELL_FOREGROUND_LIMIT + Duration::from_millis(1))
+                    .saturating_sub(now.saturating_duration_since(shell.started));
+                next_deadline =
+                    Some(next_deadline.map_or(remaining, |current| current.min(remaining)));
+            }
+        }
+        // FrameRequester coalesces deadlines: every earlier draw must rearm this timer.
+        if let Some(remaining) = next_deadline {
+            self.frame_requester.schedule_frame_in(remaining);
+        }
+        if changed {
+            self.discard_managed_shell_preview(true);
+            self.publish_shell_hud();
+            self.request_redraw();
+        }
+    }
+
+    /// Managed previews never become persisted progress when another activity arrives.
+    pub(super) fn discard_managed_shell_preview(&mut self, quiet_only: bool) {
+        let discard = self
+            .transcript
+            .active_cell
+            .as_ref()
+            .and_then(|cell| cell.as_any().downcast_ref::<ExecCell>())
+            .is_some_and(|cell| {
+                !cell.group.calls.is_empty()
+                    && cell.iter_calls().all(|call| {
+                        call.duration.is_none()
+                            && self.managed_shells.get(&call.call_id).is_some_and(|shell| {
+                                shell.policy != ShellVisibility::Foreground
+                                    && (!quiet_only || shell.quiet)
+                            })
+                    })
+            });
+        if discard {
+            self.transcript.take_active_cell();
+            self.bump_active_cell_revision();
+        }
+    }
+
+    pub(super) fn publish_shell_hud(&mut self) {
+        let (remote, stale, visible) = &self.remote_shell_hud;
+        let mut rows = remote.clone();
+        rows.retain(|row| {
+            !self.managed_shells.iter().any(|(id, shell)| {
+                !shell.quiet && shell.process_id.as_ref().unwrap_or(id) == &row.job_id
+            })
+        });
+        for (id, shell) in &self.managed_shells {
+            if !shell.quiet {
+                continue;
+            }
+            let job_id = shell.process_id.as_ref().unwrap_or(id);
+            if !rows.iter().any(|row| &row.job_id == job_id) {
+                rows.push(ShellRow {
+                    command: shell.raw_command.clone(),
+                    job_id: job_id.clone(),
+                    seen_secs: Some(shell.started.elapsed().as_secs()),
+                });
+            }
+        }
+        self.bottom_pane.set_shell_hud(
+            rows,
+            *stale,
+            *visible || self.managed_shells.values().any(|shell| shell.quiet),
+        );
+    }
+}
