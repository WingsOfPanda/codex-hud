+        let mut state = WorkerHudState::default();
+        state.bind(Some(root));
+        let now = Instant::now();
+        let request = Uuid::new_v4();
+        state.shells.pending = Some(request);
+        assert!(!state.finish_shells(other, request, Ok(vec![shell("a", "1")]), now));
