+                started_at_ms: None,
+                model: Some("gpt-6-astra".into()),
+                state: crate::bottom_pane::worker_hud::AdvisorState::Running(1),
+            }));
+            let command = format!("# codex-plus-shell: background\n{body}");
+            if local {
+                chat.on_task_started();
+                begin_unified_exec_startup(&mut chat, "advisor", "proc", &command);
+            } else {
+                chat.set_shell_hud(
+                    vec![crate::bottom_pane::worker_hud::ShellRow {
+                        command,
+                        job_id: "proc".into(),
+                        seen_secs: Some(1),
+                    }],
+                    false,
+                    true,
+                );
+            }
