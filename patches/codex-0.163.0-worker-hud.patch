+#[test]
+fn shell_policy_threshold_and_missing_duration() {
+    assert!(!quiet_shell(ShellVisibility::Auto, None));
+    assert!(!quiet_shell(
+        ShellVisibility::Auto,
+        Some(SHELL_FOREGROUND_LIMIT)
+    ));
+    assert!(quiet_shell(
+        ShellVisibility::Auto,
+        Some(SHELL_FOREGROUND_LIMIT + Duration::from_millis(1))
+    ));
+    assert!(quiet_shell(ShellVisibility::Background, None));
+    assert!(!quiet_shell(
+        ShellVisibility::Foreground,
+        Some(Duration::from_secs(60))
+    ));
+}
