+        }
+        let cells = thread_items_to_transcript_cells(
+            None,
+            &cwd,
+            [item],
+            RawReasoningVisibility::Hidden,
+            None,
+        );
+        let text = cells
+            .iter()
+            .flat_map(|cell| cell.transcript_lines(80))
+            .flat_map(|line| line.spans)
+            .map(|span| span.content.into_owned())
+            .collect::<String>();
+        assert_eq!(
+            text.contains("Shell completed"),
+            compact,
+            "{policy} {duration:?}: {text}"
+        );
+        assert_eq!(text.contains("noise"), !compact);
+        assert!(!text.contains("codex-plus-shell"));
+        if compact {
+            assert!(text.contains("Log: /tmp/job.log"));
+        }
+    }
+}
