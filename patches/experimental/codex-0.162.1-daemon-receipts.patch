+#[tokio::test]
+async fn queue_keyed_receipts_deduplicate_and_cancel_before_late_add() -> Result<()> {
+    skip_if_remote!(Ok(()), "uses a host-local command approval fixture");
+    let (mut app, _home, _server) = queue_app(vec![blocked_turn_response()?]).await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let _active = start_blocked_turn(&mut app, &thread_id).await?;
+    let mut params = submission(&thread_id, "keyed notification");
+    params.client_user_message_id = "receipt-key".into();
+    params.idempotency_key = Some("receipt-key".into());
+    let first: ThreadQueueAddResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueAdd {
+            request_id,
+            params: params.clone(),
+        })
+        .await?;
+    let retry: ThreadQueueAddResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueAdd { request_id, params })
+        .await?;
+    assert_eq!(first, retry);
+    assert_eq!(Some("pending".into()), first.receipt_state);
+    assert_eq!(1, list_queue(&mut app, &thread_id).await?.data.len());
+    let get: codex_app_server_protocol::ThreadQueueReceiptResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueReceipt {
+            request_id,
+            params: codex_app_server_protocol::ThreadQueueReceiptParams {
+                thread_id: thread_id.clone(),
+                idempotency_key: "receipt-key".into(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        Some(first.queued_submission),
+        get.receipt.unwrap().queued_submission
+    );
+    let cancel: codex_app_server_protocol::ThreadQueueReceiptCancelResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueReceiptCancel {
+            request_id,
+            params: codex_app_server_protocol::ThreadQueueReceiptParams {
+                thread_id: thread_id.clone(),
+                idempotency_key: "receipt-key".into(),
+            },
+        })
+        .await?;
+    assert_eq!("cancelled", cancel.receipt.unwrap().receipt_state);
+    let tombstone: codex_app_server_protocol::ThreadQueueReceiptCancelResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueReceiptCancel {
+            request_id,
+            params: codex_app_server_protocol::ThreadQueueReceiptParams {
+                thread_id: thread_id.clone(),
+                idempotency_key: "late-key".into(),
+            },
+        })
+        .await?;
+    let tombstone = tombstone.receipt.unwrap();
+    assert_eq!(None, tombstone.queued_submission);
+    assert_eq!("cancelled", tombstone.receipt_state);
+    let id = app.send_raw_request("thread/queue/add", Some(json!({
+        "threadId": thread_id, "idempotencyKey": "late-key", "clientUserMessageId": "late-key",
+        "input": [{"type": "text", "text": "must not deliver"}],
+    }))).await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    assert!(error.error.message.contains("cancelled"));
+    assert!(list_queue(&mut app, &thread_id).await?.data.is_empty());
+    Ok(())
+}
