+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn keyed_queue_cancellation_wins_while_core_is_recording() -> anyhow::Result<()> {
+    let server = start_mock_server().await;
+    let responses =
+        responses::mount_sse_once(&server, responses::sse_completed("must-not-run")).await;
+    let test = test_codex()
+        .with_pre_build_hook(write_waiting_queue_hook)
+        .with_config(trust_discovered_hooks)
+        .with_config(|config| config.include_environment_context = false)
+        .build_with_auto_env(&server)
+        .await?;
+    let thread_id = test.session_configured.thread_id;
+    let queue = QueuedItemService::new(
+        loaded_thread_queue(&test)?,
+        Weak::new(),
+        Arc::new(NoopExtensionEventSink),
+    );
+    let input = keyed_input("cancel-inflight", "stop before sampling");
+    let item = queue
+        .enqueue_idempotent(thread_id, "cancel-inflight".into(), input.clone())
+        .await?
+        .0
+        .unwrap();
+    queue
+        .start(test.codex.as_ref(), Some(item.id), None)
+        .await?;
+    tokio::time::timeout(Duration::from_secs(10), async {
+        while !test.codex_home_path().join("hook_started").exists() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await?;
+    // Core accepted the task, but the queued input remains durable until canonical input is flushed.
+    assert_eq!(1, queue.list(thread_id).await?.len());
+    assert_eq!(
+        "cancelled",
+        queue
+            .cancel_receipt_by_key(thread_id, "cancel-inflight".into())
+            .await?
+            .1
+    );
+    std::fs::write(test.codex_home_path().join("hook_release"), "")?;
+    wait_for_event_match(test.codex.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+    assert!(queue.list(thread_id).await?.is_empty());
+    assert_eq!(
+        "cancelled",
+        queue
+            .enqueue_idempotent(thread_id, "cancel-inflight".into(), input)
+            .await?
+            .1
+    );
+    assert!(responses.requests().is_empty());
+    Ok(())
+}
