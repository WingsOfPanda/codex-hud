+             FROM queued_submission_receipts WHERE thread_id = ? AND item_id = ?",
+        )
+        .bind(thread_id.to_string())
+        .bind(item_id)
+        .fetch_optional(self.pool.as_ref())
+        .await?;
+        row.as_ref()
+            .map(|row| {
