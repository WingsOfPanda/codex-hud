+                    submission: row
+                        .try_get::<Option<String>, _>("id")?
+                        .map(|_| QueuedUserSubmissionRecord::try_from_row(row))
+                        .transpose()?,
+                    state: row.try_get("state")?,
+                })
+            })
+            .transpose()
