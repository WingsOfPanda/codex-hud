+fn completed(
+    mut item: AppServerThreadItem,
+    duration: Option<i64>,
+    exit: i32,
+    output: &str,
+) -> AppServerThreadItem {
+    if let AppServerThreadItem::CommandExecution {
+        status,
+        duration_ms,
+        exit_code,
+        aggregated_output,
+        ..
+    } = &mut item
+    {
+        *status = if exit == 0 {
+            AppServerCommandExecutionStatus::Completed
+        } else {
+            AppServerCommandExecutionStatus::Failed
+        };
+        *duration_ms = duration;
+        *exit_code = Some(exit);
+        *aggregated_output = Some(output.to_string());
+    }
+    item
+}
