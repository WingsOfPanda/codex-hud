+    /// A tombstone also cancels an enqueue whose request has not arrived yet.
+    pub async fn cancel_receipt_by_key(
+        &self,
+        thread_id: ThreadId,
+        key: &str,
+    ) -> anyhow::Result<QueuedSubmissionReceiptRecord> {
+        let mut tx = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        sqlx::query(
+            "INSERT INTO queued_submission_receipts (thread_id, idempotency_key, state)
+             VALUES (?, ?, 'cancelled') ON CONFLICT(thread_id, idempotency_key)
