+    #[tokio::test]
+    async fn worker_hud_reads_actual_local_tokens_without_writing_or_fork_attribution() {
+        let home = tempfile::tempdir().unwrap();
+        let sqlite = codex_state::SqliteConfig::new_for_testing(
+            codex_utils_absolute_path::AbsolutePathBuf::try_from(home.path()).unwrap(),
+        );
+        let pool = sqlite
+            .open_read_write_pool(&sqlite.state_db_path())
+            .await
+            .unwrap();
+        sqlx::query("CREATE TABLE threads (id TEXT PRIMARY KEY, tokens_used INTEGER NOT NULL)")
+            .execute(&pool)
+            .await
+            .unwrap();
+        sqlx::query("INSERT INTO threads VALUES ('zero', 0), ('positive', 12345), ('negative', -1), ('fork', 999)")
+            .execute(&pool)
+            .await
+            .unwrap();
+        pool.close().await;
+        let mut workers: Vec<_> = ["zero", "positive", "negative", "missing", "fork"]
+            .into_iter()
+            .map(|id| {
+                let mut worker = thread(id);
+                if id == "fork" {
+                    worker.forked_from_id = Some("parent".into());
+                }
+                let row = worker_row(&worker, None, 10);
+                (worker, row)
+            })
+            .collect();
+        // Remote backends never receive a local database configuration.
+        read_worker_tokens(None, &mut workers).await;
+        assert!(workers.iter().all(|(_, row)| row.total_tokens.is_none()));
+        read_worker_tokens(Some(&sqlite), &mut workers).await;
+        assert_eq!(
+            workers
+                .iter()
+                .map(|(_, row)| row.total_tokens)
+                .collect::<Vec<_>>(),
+            [Some(0), Some(12345), None, None, None]
+        );
+        let read_only = sqlite
+            .open_read_only_pool(&sqlite.state_db_path(), None)
+            .await
+            .unwrap();
+        assert!(
+            sqlx::query("UPDATE threads SET tokens_used = 9")
+                .execute(&read_only)
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            sqlx::query_scalar::<_, i64>("SELECT tokens_used FROM threads WHERE id = 'zero'")
+                .fetch_one(&read_only)
+                .await
+                .unwrap(),
+            0
+        );
+        read_only.close().await;
+    }
