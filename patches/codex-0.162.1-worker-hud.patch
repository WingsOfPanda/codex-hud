+    #[test]
+    fn worker_hud_isolates_clients_and_rejects_previous_primary_replies() {
+        let root_a = ThreadId::new();
+        let root_b = ThreadId::new();
+        let id = Uuid::new_v4();
+        let row = WorkerRow {
+            group: None,
+            dispatch_elapsed_secs: None,
+            task: "/root/build".to_string(),
+            state: WorkerState::Active,
+            elapsed_secs: Some(10),
+            model: None,
+            reasoning_effort: None,
+            total_tokens: None,
+        };
+        let mut a = WorkerHudState::default();
+        let mut b = WorkerHudState::default();
+        a.bind(Some(root_a));
+        b.bind(Some(root_b));
+        a.pending = Some(id);
+        b.pending = Some(id);
+        assert!(a.finish(root_a, id, Ok(vec![row])));
+        assert!(!b.finish(root_a, id, Ok(a.rows.clone())));
+        assert!(b.rows.is_empty());
+        a.pending = Some(id);
+        assert!(a.finish(root_a, id, Err("timeout".to_string())));
+        assert!(a.stale);
+        assert_eq!(a.rows.len(), 1);
+        let recovered_id = Uuid::new_v4();
+        a.pending = Some(recovered_id);
+        assert!(a.finish(root_a, recovered_id, Ok(a.rows.clone())));
+        assert!(!a.stale);
+        assert_eq!(a.rows.len(), 1);
+        a.pending = None;
+        assert!(!a.finish(root_a, id, Ok(vec![])));
+        assert_eq!(a.rows.len(), 1);
+        a.bind(Some(root_b));
+        a.pending = Some(Uuid::new_v4());
+        assert!(!a.finish(root_a, id, Ok(vec![])));
+        assert!(a.rows.is_empty());
+        a.bind(None);
+        assert!(a.pending.is_none());
+    }
