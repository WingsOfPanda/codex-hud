+            codex_utils_absolute_path::AbsolutePathBuf::try_from(home.path()).unwrap(),
+        );
+        let pool = sqlite
+            .open_read_write_pool(&sqlite.state_db_path())
+            .await
+            .unwrap();
+        sqlx::query("CREATE TABLE threads (id TEXT PRIMARY KEY, tokens_used INTEGER NOT NULL)")
+            .execute(&pool)
+            .await
+            .unwrap();
+        sqlx::query("INSERT INTO threads VALUES ('zero', 0), ('positive', 12345), ('negative', -1), ('fork', 999)")
+            .execute(&pool)
+            .await
+            .unwrap();
+        pool.close().await;
+        let mut workers: Vec<_> = ["zero", "positive", "negative", "missing", "fork"]
+            .into_iter()
+            .map(|id| {
+                let mut worker = thread(id);
+                if id == "fork" {
+                    worker.forked_from_id = Some("parent".into());
+                }
+                let row = worker_row(&worker, None, 10);
+                (worker, row)
+            })
+            .collect();
+        // Remote backends never receive a local database configuration.
+        read_worker_tokens(None, &mut workers).await;
+        assert!(workers.iter().all(|(_, row)| row.total_tokens.is_none()));
+        read_worker_tokens(Some(&sqlite), &mut workers).await;
+        assert_eq!(
+            workers
+                .iter()
+                .map(|(_, row)| row.total_tokens)
+                .collect::<Vec<_>>(),
+            [Some(0), Some(12345), None, None, None]
+        );
+        let read_only = sqlite
+            .open_read_only_pool(&sqlite.state_db_path(), None)
+            .await
+            .unwrap();
+        assert!(
+            sqlx::query("UPDATE threads SET tokens_used = 9")
+                .execute(&read_only)
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            sqlx::query_scalar::<_, i64>("SELECT tokens_used FROM threads WHERE id = 'zero'")
+                .fetch_one(&read_only)
+                .await
+                .unwrap(),
+            0
+        );
+        read_only.close().await;
+    }
+
+    #[tokio::test]
+    async fn worker_hud_missing_or_invalid_database_keeps_runtime_rows() {
+        let home = tempfile::tempdir().unwrap();
+        let sqlite = codex_state::SqliteConfig::new_for_testing(
+            codex_utils_absolute_path::AbsolutePathBuf::try_from(home.path()).unwrap(),
+        );
+        let worker = thread("worker-id");
+        let row = worker_row(&worker, None, 10);
+        let mut workers = vec![(worker, row.clone())];
+        tokio::time::timeout(
+            Duration::from_millis(250),
+            read_worker_tokens(Some(&sqlite), &mut workers),
+        )
+        .await
+        .ok();
+        assert!(!sqlite.state_db_path().exists());
+        assert_eq!(workers[0].1, row);
+        std::fs::write(sqlite.state_db_path(), b"invalid database").unwrap();
+        tokio::time::timeout(
+            Duration::from_millis(250),
+            read_worker_tokens(Some(&sqlite), &mut workers),
+        )
+        .await
+        .ok();
+        assert_eq!(workers[0].1, row);
+        assert_eq!(
+            std::fs::read(sqlite.state_db_path()).unwrap(),
+            b"invalid database"
+        );
+    }
+
+    fn turn(status: TurnStatus) -> Turn {
+        Turn {
+            id: "turn".to_string(),
+            root_turn_id: None,
+            items: vec![],
+            items_view: TurnItemsView::NotLoaded,
+            status,
+            error: None,
+            started_at: Some(100),
+            completed_at: Some(130),
+            duration_ms: Some(30_000),
+        }
+    }
+
+    #[test]
+    fn worker_hud_runtime_activity_overrides_old_completion_and_elapsed() {
+        let completed = turn(TurnStatus::Completed);
+        let active = ThreadStatus::Active {
+            active_flags: vec![],
+        };
+        assert_eq!(worker_state(&active, Some(&completed)), WorkerState::Active);
+        assert_eq!(
+            worker_elapsed(&WorkerState::Active, Some(&completed), 160),
+            None
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::Idle, Some(&completed)),
+            WorkerState::Done
+        );
+        assert_eq!(
+            worker_elapsed(&WorkerState::Done, Some(&completed), 160),
+            Some(30)
+        );
+        assert_eq!(
+            worker_elapsed(
+                &WorkerState::Active,
+                Some(&turn(TurnStatus::InProgress)),
+                160
+            ),
+            Some(60)
+        );
+        assert_eq!(
+            worker_elapsed(
+                &WorkerState::Active,
+                Some(&turn(TurnStatus::InProgress)),
+                99
+            ),
+            None
+        );
+    }
+
+    #[test]
+    fn worker_hud_waiting_requires_explicit_runtime_flag() {
+        assert_eq!(
+            worker_state(
+                &ThreadStatus::Active {
+                    active_flags: vec![ThreadActiveFlag::WaitingOnApproval]
+                },
+                None
+            ),
+            WorkerState::Approval
+        );
+        assert_eq!(
+            worker_state(
+                &ThreadStatus::Active {
+                    active_flags: vec![ThreadActiveFlag::WaitingOnUserInput]
+                },
+                None
+            ),
+            WorkerState::Input
+        );
+        assert_eq!(worker_state(&ThreadStatus::Idle, None), WorkerState::Idle);
+        assert_eq!(
+            worker_state(&ThreadStatus::NotLoaded, Some(&turn(TurnStatus::Completed))),
+            WorkerState::Unloaded
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::SystemError, None),
+            WorkerState::Error
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::Idle, Some(&turn(TurnStatus::Failed))),
+            WorkerState::Failed
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::Idle, Some(&turn(TurnStatus::Interrupted))),
+            WorkerState::Interrupted
+        );
+    }
+
+    #[test]
+    fn worker_hud_isolates_clients_and_rejects_previous_primary_replies() {
+        let root_a = ThreadId::new();
+        let root_b = ThreadId::new();
+        let id = Uuid::new_v4();
+        let row = WorkerRow {
+            group: None,
+            dispatch_elapsed_secs: None,
+            task: "/root/build".to_string(),
+            state: WorkerState::Active,
+            elapsed_secs: Some(10),
+            model: None,
+            reasoning_effort: None,
+            total_tokens: None,
+        };
+        let mut a = WorkerHudState::default();
+        let mut b = WorkerHudState::default();
+        a.bind(Some(root_a));
+        b.bind(Some(root_b));
+        a.pending = Some(id);
+        b.pending = Some(id);
+        assert!(a.finish(root_a, id, Ok(vec![row])));
+        assert!(!b.finish(root_a, id, Ok(a.rows.clone())));
+        assert!(b.rows.is_empty());
+        a.pending = Some(id);
+        assert!(a.finish(root_a, id, Err("timeout".to_string())));
+        assert!(a.stale);
+        assert_eq!(a.rows.len(), 1);
+        let recovered_id = Uuid::new_v4();
+        a.pending = Some(recovered_id);
+        assert!(a.finish(root_a, recovered_id, Ok(a.rows.clone())));
+        assert!(!a.stale);
+        assert_eq!(a.rows.len(), 1);
+        a.pending = None;
+        assert!(!a.finish(root_a, id, Ok(vec![])));
+        assert_eq!(a.rows.len(), 1);
+        a.bind(Some(root_b));
+        a.pending = Some(Uuid::new_v4());
+        assert!(!a.finish(root_a, id, Ok(vec![])));
+        assert!(a.rows.is_empty());
+        a.bind(None);
+        assert!(a.pending.is_none());
+    }
+}
diff --git a/codex-rs/tui/src/bottom_pane/worker_hud.rs b/codex-rs/tui/src/bottom_pane/worker_hud.rs
new file mode 100644
index 0000000..5cedcb4
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/worker_hud.rs
@@ -0,0 +1,972 @@
+//! Read-only worker summary; clipping never takes space from the composer.
+
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::render::renderable::Renderable;
+use crate::status::format_tokens_compact;
+use crate::width::display_width;
+use codex_protocol::openai_models::ReasoningEffort;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use std::collections::HashMap;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum WorkerState {
+    Active,
+    Approval,
+    Input,
+    Idle,
+    Done,
+    Failed,
+    Interrupted,
+    Unloaded,
+    Error,
+}
+
+impl WorkerState {
+    pub(crate) fn label(&self) -> &'static str {
+        match self {
+            Self::Active => "active",
+            Self::Approval => "wait approval",
+            Self::Input => "wait input",
+            Self::Idle => "idle",
+            Self::Done => "done",
+            Self::Failed => "failed",
+            Self::Interrupted => "interrupted",
+            Self::Unloaded => "unloaded",
+            Self::Error => "error",
+        }
+    }
+
+    pub(crate) fn is_active(&self) -> bool {
+        matches!(self, Self::Active | Self::Approval | Self::Input)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct WorkerGroup {
+    pub(crate) key: String,
+    pub(crate) topic: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct WorkerRow {
+    pub(crate) group: Option<WorkerGroup>,
+    pub(crate) dispatch_elapsed_secs: Option<u64>,
+    pub(crate) task: String,
+    pub(crate) state: WorkerState,
+    pub(crate) elapsed_secs: Option<u64>,
+    pub(crate) total_tokens: Option<i64>,
+    pub(crate) model: Option<String>,
+    pub(crate) reasoning_effort: Option<ReasoningEffort>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ShellRow {
+    pub(crate) command: String,
+    pub(crate) job_id: String,
+    // The stock API has no start time; this is time observed by this TUI only.
+    pub(crate) seen_secs: Option<u64>,
+}
+
+#[derive(Default)]
+pub(crate) struct WorkerHud {
+    rows: Vec<WorkerRow>,
+    stale: bool,
+    visible: bool,
+    shells: Vec<ShellRow>,
+    shells_stale: bool,
+    shells_visible: bool,
+    watcher: Option<WatcherHealth>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum WatcherHealth {
+    Waiting(u64),
+    Uncertain(u64),
+    Unavailable,
+    Report(u64),
+}
+
+impl WatcherHealth {
+    fn line(&self) -> Line<'static> {
+        let label = match self {
+            Self::Waiting(0) => "Wake pending".to_string(),
+            Self::Waiting(jobs) => format!("Watcher waiting · {jobs} jobs"),
+            Self::Uncertain(count) => format!("Wake delivery uncertain · {count}"),
+            Self::Unavailable => "Watcher unavailable".to_string(),
+            Self::Report(count) => format!("Restart report ready · {count}"),
+        };
+        let line = Line::from(format!("  {label}"));
+        if matches!(self, Self::Waiting(_)) {
+            line.dim()
+        } else {
+            line.not_dim()
+        }
+    }
+}
+
+impl WorkerHud {
+    pub(crate) fn set_watcher(&mut self, watcher: Option<WatcherHealth>) -> bool {
+        if self.watcher == watcher {
+            return false;
+        }
+        self.watcher = watcher;
+        true
+    }
+
+    pub(crate) fn set(&mut self, rows: Vec<WorkerRow>, stale: bool, visible: bool) -> bool {
+        if self.rows == rows && self.stale == stale && self.visible == visible {
+            return false;
+        }
+        self.rows = rows;
+        self.stale = stale;
+        self.visible = visible;
+        true
+    }
+
+    pub(crate) fn set_shells(&mut self, rows: Vec<ShellRow>, stale: bool, visible: bool) -> bool {
+        if self.shells == rows && self.shells_stale == stale && self.shells_visible == visible {
+            return false;
+        }
+        self.shells = rows;
+        self.shells_stale = stale;
+        self.shells_visible = visible;
+        true
+    }
+
+    fn display_rows(&self) -> Vec<Vec<&WorkerRow>> {
+        let mut rows: Vec<Vec<&WorkerRow>> = Vec::new();
+        let mut groups = HashMap::new();
+        for row in &self.rows {
+            if let Some(group) = &row.group {
+                let index = *groups.entry(&group.key).or_insert_with(|| {
+                    rows.push(Vec::new());
+                    rows.len() - 1
+                });
+                rows[index].push(row);
+            } else if row.state.is_active() {
+                rows.push(vec![row]);
+            }
+        }
+        rows.retain(|members| members.iter().any(|row| row.state.is_active()));
+        rows
+    }
+
+    fn lines(&self, width: u16) -> Vec<Line<'static>> {
+        let display_rows = if self.visible {
+            self.display_rows()
+        } else {
+            Vec::new()
+        };
+        let shells = if self.shells_visible {
+            self.shells.as_slice()
+        } else {
+            &[]
+        };
+        let workers_visible = self.visible && (!display_rows.is_empty() || self.stale);
+        let shells_visible = self.shells_visible && (!shells.is_empty() || self.shells_stale);
+        if !workers_visible && !shells_visible {
+            return self.watcher.iter().map(WatcherHealth::line).collect();
+        }
+        let rows: Vec<_> = self
+            .rows
+            .iter()
+            .filter(|row| row.state.is_active())
+            .collect();
+        let active = rows
+            .iter()
+            .filter(|r| r.state == WorkerState::Active)
+            .count();
+        let waiting = rows.len() - active;
+        let mut header = if workers_visible {
+            if self.stale {
+                "  Workers stale · counts unavailable".to_string()
+            } else {
+                format!(
+                    "  Workers {} · active {active} · waiting {waiting}",
+                    rows.len()
+                )
+            }
+        } else {
+            String::new()
+        };
+        if shells_visible {
+            let label = if self.shells_stale {
+                "stale · counts unavailable".to_string()
+            } else {
+                shells.len().to_string()
+            };
+            if workers_visible {
+                header.push_str(&format!(" · shells {label}"));
+            } else {
+                header = format!("  Shells {label}");
+            }
+        }
+        let mut lines = vec![Line::from(header).not_dim()];
+        let worker_limit = display_rows
+            .len()
+            .min(if shells.is_empty() { 3 } else { 2 });
+        let shell_limit = shells.len().min(3 - worker_limit);
+        for members in display_rows.iter().take(worker_limit) {
+            let row = members[0];
+            let current: Vec<_> = members.iter().filter(|row| row.state.is_active()).collect();
+            let grouped = row.group.is_some();
+            let elapsed = if self.stale {
+                None
+            } else if grouped {
+                members
+                    .iter()
+                    .try_fold(0, |age, row| Some(age.max(row.dispatch_elapsed_secs?)))
+            } else {
+                row.elapsed_secs
+            };
+            let time = elapsed
+                .map(|secs| format!("{}:{:02}", secs / 60, secs % 60))
+                .unwrap_or_else(|| "?".to_string());
+            let total_tokens = if self.stale {
+                None
+            } else {
+                members.iter().try_fold(0i64, |total, row| {
+                    total.checked_add(row.total_tokens.filter(|tokens| *tokens >= 0)?)
+                })
+            };
+            let tokens = total_tokens
+                .map(format_tokens_compact)
+                .unwrap_or_else(|| "?".to_string());
+            let state = if self.stale {
+                "stale"
+            } else if current.iter().any(|row| row.state == WorkerState::Active) {
+                WorkerState::Active.label()
+            } else if current.iter().any(|row| row.state == WorkerState::Approval) {
+                WorkerState::Approval.label()
+            } else {
+                WorkerState::Input.label()
+            };
+            let first = current[0];
+            let model = if current.iter().any(|row| row.model.is_none()) {
+                "?".to_string()
+            } else if current.iter().all(|row| row.model == first.model) {
+                model_label(first.model.as_deref())
+            } else {
+                "mixed".to_string()
+            };
+            let effort = if current.iter().any(|row| row.reasoning_effort.is_none()) {
+                "?".to_string()
+            } else if current
+                .iter()
+                .all(|row| row.reasoning_effort == first.reasoning_effort)
+            {
+                effort_label(first.reasoning_effort.as_ref())
+            } else {
+                "mixed".to_string()
+            };
+            let model_effort = if model == "mixed" && effort == "mixed" {
+                "mixed".to_string()
+            } else {
+                format!("{model} {effort}")
+            };
+            let metrics = format!(" · {state} · {time} · {tokens} tok · {model_effort}");
+            let count = if grouped {
+                if self.stale {
+                    " (? agents)".to_string()
+                } else {
+                    let suffix = if current.len() == 1 { "" } else { "s" };
+                    format!(" ({} agent{suffix})", current.len())
+                }
+            } else {
+                String::new()
+            };
+            let task_width = usize::from(width)
+                .saturating_sub(2 + display_width(&metrics))
+                .max(12.min(usize::from(width).saturating_sub(2)))
+                .saturating_sub(display_width(&count));
+            let label = row.group.as_ref().map_or(&row.task, |group| &group.topic);
+            let task =
+                truncate_line_with_ellipsis_if_overflow(Line::from(label.clone()), task_width);
+            lines.push(Line::from(format!("  {task}{count}{metrics}")).dim());
+        }
+        for shell in shells.iter().take(shell_limit) {
+            let state = if self.shells_stale {
+                "stale"
+            } else {
+                "running"
+            };
+            let seen = if self.shells_stale {
+                None
+            } else {
+                shell.seen_secs
+            };
+            let seen = seen
+                .map(|secs| format!("{}:{:02}", secs / 60, secs % 60))
+                .unwrap_or_else(|| "?".into());
+            let job = sanitize_label(&shell.job_id, 32);
+            let metrics = format!(" · {state} · seen {seen} · job {job}");
+            let command_width = usize::from(width)
+                .saturating_sub(2 + display_width(&metrics))
+                .max(12.min(usize::from(width).saturating_sub(2)));
+            let command = truncate_line_with_ellipsis_if_overflow(
+                Line::from(sanitize_label(&shell.command, 160)),
+                command_width,
+            );
+            lines.push(Line::from(format!("  {command}{metrics}")).dim());
+        }
+        let more = display_rows.len() + shells.len() - worker_limit - shell_limit;
+        if more > 0 {
+            lines.push(Line::from(format!("  +{more} more")).dim());
+        }
+        lines.extend(self.watcher.iter().map(WatcherHealth::line));
+        lines
+    }
+}
+
+fn sanitize_label(label: &str, limit: usize) -> String {
+    let label: String = label
+        .chars()
+        .take(limit)
+        .map(|ch| if ch.is_control() { ' ' } else { ch })
+        .collect();
+    let label = label.trim();
+    if label.is_empty() {
+        "shell".to_string()
+    } else {
+        label.to_string()
+    }
+}
+
+fn effort_label(effort: Option<&ReasoningEffort>) -> String {
+    effort
+        .map(ReasoningEffort::as_str)
+        .unwrap_or("?")
+        .chars()
+        .map(|ch| if ch.is_control() { ' ' } else { ch })
+        .collect::<String>()
+        .trim()
+        .to_string()
+}
+
+fn model_label(model: Option<&str>) -> String {
+    let model: String = model
+        .unwrap_or_default()
+        .chars()
+        .map(|ch| if ch.is_control() { ' ' } else { ch })
+        .collect();
+    let model = model.trim();
+    for segment in model.split(|ch: char| !ch.is_ascii_alphanumeric()) {
+        if segment.eq_ignore_ascii_case("sol") {
+            return "Sol".to_string();
+        }
+        if segment.eq_ignore_ascii_case("astra") {
+            return "Astra".to_string();
+        }
+    }
+    if model.is_empty() {
+        "?".to_string()
+    } else {
+        model.to_string()
+    }
+}
+
+impl Renderable for WorkerHud {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        if !area.is_empty() {
+            Renderable::render(&Paragraph::new(self.lines(area.width)), area, buf);
+        }
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        if width == 0 {
+            0
+        } else {
+            self.lines(width).len() as u16
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ratatui::style::Modifier;
+
+    fn shell_row(n: usize) -> ShellRow {
+        ShellRow {
+            command: format!("cargo test {n}"),
+            job_id: n.to_string(),
+            seen_secs: Some(62),
+        }
+    }
+
+    #[test]
+    fn worker_hud_shell_only_mixed_caps_and_independent_stale_counts() {
+        let mut hud = WorkerHud::default();
+        assert!(hud.set_shells((0..5).map(shell_row).collect(), false, true));
+        assert!(!hud.set_shells((0..5).map(shell_row).collect(), false, true));
+        let lines = hud.lines(100);
+        assert_eq!(lines[0].to_string(), "  Shells 5");
+        assert_eq!(
+            lines[1].to_string(),
+            "  cargo test 0 · running · seen 1:02 · job 0"
+        );
+        assert_eq!(lines[4].to_string(), "  +2 more");
+        assert_eq!(hud.desired_height(100), 5);
+        assert_eq!(hud.desired_height(0), 0);
+        assert!(!lines[0].style.add_modifier.contains(Modifier::DIM));
+        assert!(lines[1].style.add_modifier.contains(Modifier::DIM));
+        let worker = grouped_member("unused", WorkerState::Active, 62, 1000);
+        for workers in [1, 2, 4] {
+            let rows = (0..workers)
+                .map(|n| {
+                    let mut row = worker.clone();
+                    row.group = None;
+                    row.task = format!("worker {n}");
+                    row
+                })
+                .collect();
+            hud.set(rows, false, true);
+            let lines = hud.lines(120);
+            assert!(lines[0].to_string().ends_with(" · shells 5"));
+            let details = &lines[1..4];
+            assert_eq!(
+                details
+                    .iter()
+                    .filter(|line| line.to_string().contains("worker"))
+                    .count(),
+                workers.min(2)
+            );
+            assert_eq!(
+                details
+                    .iter()
+                    .filter(|line| line.to_string().contains("cargo test"))
+                    .count(),
+                3 - workers.min(2)
+            );
