+    fn worker_hud_waiting_requires_explicit_runtime_flag() {
+        assert_eq!(
+            worker_state(
+                &ThreadStatus::Active {
+                    active_flags: vec![ThreadActiveFlag::WaitingOnApproval]
+                },
+                None
+            ),
+            WorkerState::Approval
+        );
+        assert_eq!(
+            worker_state(
+                &ThreadStatus::Active {
+                    active_flags: vec![ThreadActiveFlag::WaitingOnUserInput]
+                },
+                None
+            ),
+            WorkerState::Input
+        );
+        assert_eq!(worker_state(&ThreadStatus::Idle, None), WorkerState::Idle);
+        assert_eq!(
+            worker_state(&ThreadStatus::NotLoaded, Some(&turn(TurnStatus::Completed))),
+            WorkerState::Unloaded
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::SystemError, None),
+            WorkerState::Error
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::Idle, Some(&turn(TurnStatus::Failed))),
+            WorkerState::Failed
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::Idle, Some(&turn(TurnStatus::Interrupted))),
+            WorkerState::Interrupted
