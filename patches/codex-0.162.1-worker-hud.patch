+
+    pub async fn receipt_by_key(
+        &self,
+        thread_id: ThreadId,
+        key: &str,
+    ) -> anyhow::Result<Option<QueuedSubmissionReceiptRecord>> {
+        let row = sqlx::query(
+            "SELECT item_id AS id, thread_id, payload_json, state
+             FROM queued_submission_receipts WHERE thread_id = ? AND idempotency_key = ?",
+        )
+        .bind(thread_id.to_string())
+        .bind(key)
+        .fetch_optional(self.pool.as_ref())
