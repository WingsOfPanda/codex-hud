+    /// Atomically persist the enqueue and its permanent receipt.
+    pub async fn enqueue_idempotent(
+        &self,
+        thread_id: ThreadId,
+        key: &str,
+        payload_json: &str,
+    ) -> anyhow::Result<QueuedSubmissionReceiptRecord> {
+        let mut tx = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        if let Some(row) = sqlx::query(
+            "SELECT item_id AS id, thread_id, payload_json, state
+             FROM queued_submission_receipts WHERE thread_id = ? AND idempotency_key = ?",
+        )
+        .bind(thread_id.to_string())
+        .bind(key)
+        .fetch_optional(tx.as_mut())
+        .await?
+        {
+            let submission = row
+                .try_get::<Option<String>, _>("id")?
+                .map(|_| QueuedUserSubmissionRecord::try_from_row(&row))
+                .transpose()?;
+            if submission
+                .as_ref()
+                .is_some_and(|submission| submission.payload != payload_json)
+            {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "idempotencyKey was already used with a different submission",
+                )
+                .into());
+            }
+            return Ok(QueuedSubmissionReceiptRecord {
+                submission,
+                state: row.try_get("state")?,
+            });
+        }
+        let now_ms = datetime_to_epoch_millis(Utc::now());
+        let row = sqlx::query(
+            "INSERT INTO queued_items (id, thread_id, payload_json, queue_order, created_at_ms, updated_at_ms)
+             SELECT ?, ?, ?, COALESCE((SELECT MAX(queue_order) FROM queued_items WHERE thread_id = ?), -1) + 1, ?, ?
+             WHERE (SELECT COUNT(*) FROM queued_items WHERE thread_id = ?) < ?
+             RETURNING id, thread_id, payload_json",
+        )
+        .bind(Uuid::now_v7().to_string()).bind(thread_id.to_string()).bind(payload_json)
+        .bind(thread_id.to_string()).bind(now_ms).bind(now_ms).bind(thread_id.to_string())
+        .bind(i64::try_from(MAX_QUEUE_ITEMS)?).fetch_one(tx.as_mut()).await?;
+        let submission = QueuedUserSubmissionRecord::try_from_row(&row)?;
+        sqlx::query(
+            "INSERT INTO queued_submission_receipts (thread_id, idempotency_key, item_id, payload_json, state)
+             VALUES (?, ?, ?, ?, 'pending')",
+        ).bind(thread_id.to_string()).bind(key).bind(&submission.id).bind(payload_json)
+            .execute(tx.as_mut()).await?;
+        tx.commit().await?;
+        Ok(QueuedSubmissionReceiptRecord {
+            submission: Some(submission),
+            state: "pending".to_owned(),
+        })
+    }
