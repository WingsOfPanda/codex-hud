+    #[test]
+    fn worker_hud_runtime_activity_overrides_old_completion_and_elapsed() {
+        let completed = turn(TurnStatus::Completed);
+        let active = ThreadStatus::Active {
+            active_flags: vec![],
+        };
+        assert_eq!(worker_state(&active, Some(&completed)), WorkerState::Active);
+        assert_eq!(
+            worker_elapsed(&WorkerState::Active, Some(&completed), 160),
+            None
+        );
+        assert_eq!(
+            worker_state(&ThreadStatus::Idle, Some(&completed)),
+            WorkerState::Done
+        );
+        assert_eq!(
+            worker_elapsed(&WorkerState::Done, Some(&completed), 160),
+            Some(30)
+        );
+        assert_eq!(
+            worker_elapsed(
+                &WorkerState::Active,
+                Some(&turn(TurnStatus::InProgress)),
+                160
+            ),
+            Some(60)
+        );
+        assert_eq!(
+            worker_elapsed(
+                &WorkerState::Active,
+                Some(&turn(TurnStatus::InProgress)),
+                99
+            ),
+            None
+        );
+    }
