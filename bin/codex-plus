#!/usr/bin/env bash
set -euo pipefail
launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
root=$(cd -- "$(dirname -- "$launcher")/.." && pwd)
case "${1:-}" in
    run|park|goal|advisor|observe|supervise|--version)
        if [[ "$1" != --version || ( "$#" == 1 && -f "$root/codex-plus.json" ) ]]; then
            runtime="$root/bin/codex-plus-runtime"
            if [[ ! -x "$runtime" ]]; then
                runtime="$root/.build/codex-plus-runtime"
            fi
            if [[ ! -x "$runtime" ]]; then
                echo "Build the native runtime first: $root/scripts/build-runtime.sh" >&2
                exit 1
            fi
            exec "$runtime" --package-root "$root" "$@"
        fi
        ;;
esac
native="$root/bin/codex"
if [[ ! -x "$native" ]]; then
    native="$root/.build/codex"
fi
if [[ ! -x "$native" ]]; then
    echo "Build the native client first: $root/scripts/build-native.sh" >&2
    exit 1
fi
exec "$native" "$@"
